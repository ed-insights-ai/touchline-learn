{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "touchline.fixtures/2 (teaching copy)",
  "description": "One season of one gender of one conference: every match a collected schedule page listed. Written for this guide from the sample; it is not the platform's own contract file.",
  "type": "object",
  "required": ["schema", "season", "gender", "conference", "collected_at", "programmes", "fixtures"],
  "properties": {
    "schema": { "const": "touchline.fixtures/2" },
    "season": { "type": "integer", "minimum": 2000 },
    "gender": { "enum": ["men", "women"] },
    "conference": { "type": "string", "minLength": 1 },
    "collected_at": { "type": "string", "format": "date-time" },
    "membership_extrapolated": { "type": "boolean" },
    "conference_game_source": { "type": "string" },
    "programmes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "name", "conference"],
        "properties": {
          "slug": { "$ref": "#/$defs/slug" },
          "name": { "type": "string", "minLength": 1 },
          "conference": { "type": "string" },
          "abbr": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "fixtures": { "type": "array", "items": { "$ref": "#/$defs/fixture" } }
  },
  "additionalProperties": false,
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "fixture": {
      "type": "object",
      "required": ["id", "date", "home", "away", "status", "source_url", "conference_game"],
      "properties": {
        "id": {
          "description": "platform:publishing-school:the site's own game number",
          "type": "string",
          "pattern": "^[a-z]+:[a-z0-9-]+:[0-9]+$"
        },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "time": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "home": { "$ref": "#/$defs/slug" },
        "away": { "$ref": "#/$defs/slug" },
        "status": { "enum": ["scheduled", "live", "final", "postponed", "canceled"] },
        "home_score": { "type": "integer", "minimum": 0 },
        "away_score": { "type": "integer", "minimum": 0 },
        "source_url": { "type": "string", "pattern": "^https://" },
        "conference_game": { "type": "boolean" },
        "match_type": { "enum": ["exhibition"] },
        "neutral": { "type": "boolean" },
        "venue": { "type": "string" },
        "stage": {
          "type": "object",
          "required": ["phase"],
          "properties": {
            "phase": { "enum": ["regular", "postseason"] },
            "competition": { "enum": ["conference", "ncaa"] },
            "source": { "type": "string" },
            "round_published": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "dependentRequired": { "home_score": ["away_score"], "away_score": ["home_score"] },
      "if": { "properties": { "status": { "const": "scheduled" } } },
      "then": { "not": { "anyOf": [{ "required": ["home_score"] }, { "required": ["away_score"] }] } }
    }
  }
}
