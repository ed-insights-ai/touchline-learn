---
import data from "../data/identity-pilot.json";

type Option = { label: string; why: string; correct?: boolean };

const eastbrook = (rows: typeof data.clean) => rows.find((r) => r.slug === "eastbrook-state")!;
const before = eastbrook(data.merged);
const after = eastbrook(data.clean);
const cedar = data.clean.find((r) => r.slug === "cedar-grove")!;
const gamesSeen = data.clean.map((r) => r.games);
const low = Math.min(...gamesSeen);
const high = Math.max(...gamesSeen);
const ordinal = (n: number) => `${n}${n === 1 ? "st" : n === 2 ? "nd" : n === 3 ? "rd" : "th"}`;
const rankOf = (rows: typeof data.clean, slug: string) => ordinal(rows.findIndex((r) => r.slug === slug) + 1);
const signed = (n: number) => (n > 0 ? `+${n.toFixed(2)}` : n.toFixed(2).replace("-", "−"));
const policy = (cutoff: number) => data.cutoffs.find((c) => c.cutoff === cutoff)!;
const at70 = policy(0.7);
const at90 = policy(0.9);
const total = at70.right + at70.wrong + at70.review;
const startIndex = data.cutoffs.findIndex((c) => c.cutoff === 0.7);
const share = (n: number) => `width:${(n / total) * 100}%`;
const eastCount = before.games - data.movedGames.length;

const PILL_W = 58;
const PILL_H = 26;
const pillX = (col: number) => 12 + col * (PILL_W + 6);
const westRowY = 240;
const selfIndex = data.movedGames.findIndex((g) => g.playsItself);
const westOrder = [
  data.movedGames[selfIndex],
  ...data.movedGames.filter((_, i) => i !== selfIndex),
];
const pills = Array.from({ length: before.games }, (_, i) => {
  const col = i % 5;
  const row = Math.floor(i / 5);
  const west = i >= eastCount;
  const westIndex = i - eastCount;
  const x = pillX(col);
  const y = 34 + row * 32;
  return {
    x,
    y,
    west,
    self: i === eastCount - 1 || i === eastCount,
    dx: west ? pillX(westIndex) - x : 0,
    dy: west ? westRowY - y : 0,
  };
});
const selfEast = pills[eastCount - 1];
const selfWest = pills[eastCount];

const hypotheses: Option[] = [
  { label: "The same games were loaded twice", why: "Your test: a double load repeats whole games under the same abbreviation.", correct: true },
  { label: "Eastbrook really played extra games", why: "Your test: extra games would be new matches, all published as EBSU.", correct: true },
  { label: "Two schools became one", why: "Your test: one record would carry two different abbreviations.", correct: true },
];
const explanation: Option[] = [
  { label: "A double load", why: "A double load would repeat EBSU rows. These four carry a different abbreviation." },
  { label: "Real extra games", why: "Extra Eastbrook games would still read EBSU, and a school cannot play itself." },
  { label: "Two schools became one", why: "Right. WBSU and EBSU are different schools sharing one row.", correct: true },
];
const repair: Option[] = [
  { label: "Leave them. The names are close enough", why: `Then one match stays Eastbrook against itself, and Eastbrook stays at ${before.perGame.toFixed(2)}.` },
  { label: "Delete the four appearances", why: "Those results are real, and one is the other side of an Eastbrook win. Deleting them trades one error for another." },
  { label: "Give them back to Westbrook", why: "Right. Every result stays, and each side returns to the school that played it.", correct: true },
];
const ship: Option[] = [
  { label: "Auto-merge at 0.70", why: `At 0.70, ${at70.wrong} spellings merge into the wrong school with no warning.` },
  { label: "Auto-merge at 0.90", why: `At 0.90 it accepts only the ${at90.exact} conference names spelled exactly, so it adds nothing to a lookup. Westbrook State scores ${data.similarity} against Eastbrook State, so one small cutoff change would merge them.` },
  { label: "AI suggests, a person approves each new name", why: "Right. Each new spelling costs one review, once, and every identity decision stays visible and reversible.", correct: true },
];
const firstRuling: Option[] = [
  { label: "St. Lambert", why: "The words overlap, but nothing yet connects this name to that school." },
  { label: "Lambert State", why: "It may be right, but so far that is a guess. Guesses are what caused the bad table." },
  { label: "Hold until there is evidence", why: "Right for now. A held name is visible, and nothing downstream is corrupted.", correct: true },
];
const secondRuling: Option[] = [
  { label: "Lambert State", why: "Right. The abbreviation and the ground agree. Both come from one box score, so record that source with your ruling.", correct: true },
  { label: "St. Lambert", why: `St. Lambert publishes as ${data.lambert.stLambertAbbr}. This page says ${data.lambert.abbr}.` },
  { label: "Keep holding", why: "Holding was right when evidence was thin. The evidence is here now, so make the call." },
];
const customers = [
  { name: "Priya Shah", orders: 63, first: "Jan 2021", opened: "Jan 2021", why: "Being the top customer is not evidence of a problem. These dates are consistent." },
  { name: "Tom Reed", orders: 41, first: "May 2022", opened: "Apr 2022", why: "The account opened a month before the first order. That is normal." },
  { name: "Jo Park", orders: 52, first: "Mar 2021", opened: "Jun 2024", why: "Right. Nobody can order three years before their account exists.", correct: true },
  { name: "Ana Ruiz", orders: 38, first: "Feb 2023", opened: "Feb 2023", why: "Same month for both dates is ordinary." },
];
const causes: Option[] = [
  { label: "Two customers were merged", why: "Your test: the record would contain two different customers' activity.", correct: true },
  { label: "A date was imported wrongly", why: "Your test: one source record would hold every order, with one bad date.", correct: true },
  { label: "An old account was reopened", why: "Your test: the orders would come from one customer, with a gap between them.", correct: true },
];
const settle: Option[] = [
  { label: "Confirm order totals still reconcile", why: "A false merge keeps every order, so the totals still match. This check passes either way." },
  { label: "Ask the assistant if it is confident", why: "Confidence is not evidence. The assistant already reported success." },
  { label: "Compare who placed the orders behind this record", why: "Right. Source ids, ship-to addresses and order dates can separate one customer from two.", correct: true },
];
const sourceRecords = [
  { id: "C-1184", name: "Jo Park", city: "Duluth, Minn.", opened: "Mar 2021", span: "Mar 2021 to Oct 2026", orders: 31 },
  { id: "C-3907", name: "Joanna Park", city: "Tucson, Ariz.", opened: "Jun 2024", span: "Jun 2024 to Oct 2026", orders: 21 },
];
const customerRuling: Option[] = [
  { label: "One customer who moved", why: "A move would end the Duluth orders. They continue for more than two years after Tucson begins." },
  { label: "Hold until there is more evidence", why: "Holding fits thin evidence. Here you have two accounts, two cities and nine same-day orders." },
  { label: "Two customers, falsely merged", why: "Right. The record kept Jo's first order and Joanna's opening date, which created the impossible dates. The orders still total 52, so nothing failed. Split them and record why.", correct: true },
];
const asks = [
  { label: "Entity counts before and after", correct: true },
  { label: "A confidence score for the run", miss: "A confidence score is the tool's opinion of itself." },
  { label: "Records that cannot be true", correct: true },
  { label: "Proof that totals still reconcile", miss: "A false merge keeps every row, so totals still match." },
  { label: "Every merge it made", correct: true },
  { label: "A log showing zero errors", miss: "This failure produced zero errors." },
];
const selfGame = data.movedGames[selfIndex];
const selfDate = new Date(`${selfGame.date}T00:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const outsideSchools = data.schools.clean - data.matcher.members;
---

<script is:inline>document.documentElement.classList.add("il-js");</script>

<div class="il not-content" data-lesson>
  <script is:inline type="application/json" id="il-data" set:html={JSON.stringify({ clean: data.clean, cutoffs: data.cutoffs, allCutoffs: data.allCutoffs, low, high, schools: data.schools })}></script>
  <noscript><p class="il-note">This lesson is interactive. Turn on JavaScript to make each decision and see its feedback.</p></noscript>

  <header class="il-hero">
    <h2>Your AI assistant finished the job. Would you publish this?</h2>
    <div class="il-ai">
      <p class="il-ai-who">AI assistant <span>scripted example</span></p>
      <p>I resolved all {data.spellings} team spellings in the 2025 and 2026 box scores. No errors. <strong>Cedar Grove is the best women's team of 2026</strong> on both conference points and goal difference.</p>
    </div>
  </header>

  <section class="il-step is-open" data-step="1" aria-label="Decide whether to publish">
    <div class="il-group" data-group>
      <button type="button" data-why="Published. Cedar Grove is now the headline, and nothing warned you. Take it back and check the table.">Publish it</button>
      <button type="button" data-correct data-why="Good. A clean run proves the code finished. It does not prove the answer is right.">Check it first</button>
      <p class="il-feedback" role="status"></p>
    </div>
    <div class="il-after"><button type="button" class="il-next" data-next="2">Inspect the table</button></div>
  </section>

  <figure class="il-board" data-board>
    <figcaption>
      <span>Women's standings, 2026</span>
      <span class="il-status" data-status role="status">Pipeline passed, 0 errors</span>
      <span class="il-board-prompt" data-board-prompt tabindex="-1">One row deserves a question. Tap the team you would question first.</span>
      <span class="il-feedback il-board-feedback" data-pick-feedback role="status"></span>
    </figcaption>
    <table>
      <thead>
        <tr><th scope="col">Rank</th><th scope="col">Team</th><th scope="col">Games</th><th scope="col">Goal diff. per game</th><th scope="col">Conf. points</th></tr>
      </thead>
      <tbody>
        {data.merged.map((row, i) => (
          <tr data-row={row.slug}>
            <td data-rank>{i + 1}</td>
            <th scope="row"><button type="button" data-pick={row.slug} disabled>{row.name}</button></th>
            <td data-games>{row.games}</td>
            <td data-gd>{signed(row.perGame)}</td>
            <td>{row.points}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="il-board-key">Games and goal difference count every result except exhibitions. Points count conference games.</p>
  </figure>

  <section class="il-step" data-step="2" aria-label="Find the row that cannot be right">
    <div class="il-after"><button type="button" class="il-next" data-next="3">Work out why</button></div>
  </section>

  <section class="il-step" data-step="3">
    <h3 tabindex="-1">What could produce {before.games} games?</h3>
    <p>Before you look at any evidence, pick your best explanation.</p>
    <div class="il-group" data-group data-action="predict" data-neutral>
      {hypotheses.map((o) => <button type="button" data-why={o.why} data-correct>{o.label}</button>)}
      <p class="il-feedback" role="status"></p>
    </div>
    <div class="il-after"><button type="button" class="il-next" data-next="4">Test it against the evidence</button></div>
  </section>

  <section class="il-step" data-step="4">
    <h3 tabindex="-1" data-ledger-heading>{before.games} appearances for one school</h3>
    <p class="il-prediction" data-prediction></p>
    <p data-ledger-intro>This is every appearance credited to Eastbrook. Read the abbreviation each page published.</p>
    <figure class="il-ledger" data-ledger>
      <svg viewBox="0 0 344 286" role="img" data-ledger-svg aria-label={`${before.games} appearances credited to Eastbrook State: ${eastCount} published as EBSU and ${data.movedGames.length} published as WBSU.`}>
        <rect class="il-bin" x="5" y="5" width="334" height="196" rx="4"></rect>
        <text class="il-bin-label" x="14" y="24">Eastbrook State</text>
        <g class="il-diag">
          <rect class="il-bin il-bin-west" x="5" y="210" width="334" height="70" rx="4"></rect>
          <text class="il-bin-label il-bin-west-label" x="14" y="229">Westbrook State</text>
          <line class="il-self-link" x1={selfEast.x + PILL_W} y1={selfEast.y + PILL_H / 2} x2={selfWest.x} y2={selfWest.y + PILL_H / 2}></line>
        </g>
        {pills.map((p) => (
          <g class:list={["il-pill", { west: p.west, self: p.self }]} style={`--dx:${p.dx}px;--dy:${p.dy}px`}>
            <rect x={p.x} y={p.y} width={PILL_W} height={PILL_H} rx="13"></rect>
            <text x={p.x + PILL_W / 2} y={p.y + 17.5} text-anchor="middle">{p.west ? "WBSU" : "EBSU"}</text>
          </g>
        ))}
      </svg>
      <p class="il-count" role="status">Schools in the data: <strong data-schools>{data.schools.merged}</strong> <span data-schools-note>of {data.schools.clean} real schools. The standings list {data.matcher.members} conference teams, and their schedules add {outsideSchools} outside opponents. Westbrook is one of those {outsideSchools}.</span></p>
    </figure>
    <div data-questions>
      <div class="il-clue">
        <p class="il-question">One match on this sheet, {selfDate}</p>
        <p class="il-score"><span>WBSU {selfGame.scored}</span><span>EBSU {selfGame.conceded}</span></p>
        <p>Both sides of this match are credited to Eastbrook.</p>
      </div>
      <div class="il-group" data-group data-action="diagnose" data-unlocks="repair">
        <p class="il-question">Which explanation does the sheet support?</p>
        {explanation.map((o) => <button type="button" data-why={o.why} data-correct={o.correct ? "" : undefined}>{o.label}</button>)}
        <p class="il-feedback" role="status"></p>
      </div>
      <div data-unlock="repair">
        <p class="il-matches">{data.distinctMatches} real matches produced these {before.games} appearances, because one match was credited to Eastbrook on both sides.</p>
        <ul class="il-moved">
          {westOrder.map((g) => (
            <li class:list={{ self: g.playsItself }}>
              <span>{g.published}</span>
              <span>{g.scored}-{g.conceded} vs {g.opponent}</span>
              {g.playsItself && <strong>Same match, both sides credited to Eastbrook</strong>}
            </li>
          ))}
        </ul>
        <div class="il-group" data-group data-action="split">
          <p class="il-question">What should happen to these {data.movedGames.length} appearances?</p>
          {repair.map((o) => <button type="button" data-why={o.why} data-correct={o.correct ? "" : undefined}>{o.label}</button>)}
          <p class="il-feedback" role="status"></p>
        </div>
      </div>
    </div>
    <div class="il-show" data-show-standings><button type="button" class="il-next">See the new standings</button></div>
    <div data-board-slot></div>
    <div class="il-after">
      <p class="il-turn">Eastbrook climbs from {rankOf(data.merged, "eastbrook-state")} at {before.perGame.toFixed(2)} to {rankOf(data.clean, "eastbrook-state")} at {after.perGame.toFixed(2)}. Cedar Grove still leads on points, {cedar.points} to {after.points}. <strong>This is a false merge: two real things became one record, and nothing failed.</strong> It did not just move a team. It removed the doubt that should have been there.</p>
      <button type="button" class="il-next" data-next="5">Stop this happening again</button>
    </div>
  </section>

  <section class="il-step" data-step="5">
    <h3 tabindex="-1">Make identity errors loud</h3>
    <p>Every name takes the same path. Rankings come off, then the name must match a reviewed spelling exactly.</p>
    <div class="il-reviewed">
      <p>Part of the reviewed list</p>
      <ul>
        {data.routes.reviewed.map((entry) => <li><span>{entry.spellings.join(", ")}</span><code>{entry.slug}</code></li>)}
      </ul>
    </div>
    <figure class="il-pipe">
      <svg viewBox="0 0 344 118" role="img" aria-label="A name passes through remove ranking, then exact lookup. It ends at a school id or in the review queue.">
        <path class="il-pipe-line" d="M8 59 H206 M206 59 C228 59 226 26 250 26 H262 M206 59 C228 59 226 92 250 92 H262"></path>
        <rect class="il-station" x="24" y="38" width="78" height="42" rx="3"></rect>
        <text x="63" y="56" text-anchor="middle">Remove</text><text x="63" y="71" text-anchor="middle">ranking</text>
        <rect class="il-station" x="122" y="38" width="78" height="42" rx="3"></rect>
        <text x="161" y="56" text-anchor="middle">Exact</text><text x="161" y="71" text-anchor="middle">lookup</text>
        <rect class="il-end" x="262" y="8" width="76" height="36" rx="3"></rect>
        <text x="300" y="31" text-anchor="middle">School id</text>
        <rect class="il-end il-end-review" x="262" y="74" width="76" height="36" rx="3"></rect>
        <text x="300" y="97" text-anchor="middle">Review</text>
        <circle class="il-token" data-token cx="0" cy="0" r="7" transform="translate(8 59)"></circle>
      </svg>
      {data.routes.names.map((route, i) => {
        const reaches = route.slug !== null;
        const last = i === data.routes.names.length - 1;
        const result = reaches
          ? `Right. The ranking comes off, and every later join uses the stable id ${route.slug}.`
          : route.cleaned === "Eastbrook St."
            ? "Right. Even the correct school waits until a person approves this spelling. That is the price of never guessing."
            : `Right. “${route.cleaned}” is not on the list. Looking close is not a match.`;
        const wrong = reaches
          ? `“${route.cleaned}” is on the list once the ranking comes off, so it does not need a person.`
          : `“${route.cleaned}” is not spelled exactly like anything on the list, so lookup cannot resolve it.`;
        return (
          <div class="il-route il-group" data-group data-route={reaches ? "school" : "review"} data-unlock={i > 0 ? `route-${i}` : undefined}>
            <p class="il-name">{route.published}</p>
            <div class="il-route-buttons">
              <button type="button" data-end="school" data-why={reaches ? result : wrong} data-correct={reaches ? "" : undefined}>Reaches a school</button>
              <button type="button" data-end="review" data-why={reaches ? wrong : result} data-correct={reaches ? undefined : ""}>Stops for review</button>
            </div>
            <ol class="il-trace" aria-label={`${route.published} becomes ${route.cleaned}, then ${reaches ? route.slug : "the review queue"}`}>
              <li style="--d:0ms">{route.published}</li>
              <li style="--d:300ms">{route.cleaned}</li>
              <li style="--d:700ms"><strong>{reaches ? route.slug : "review queue"}</strong></li>
            </ol>
            <p class="il-feedback" role="status"></p>
            {!last && <button type="button" class="il-next il-route-next" data-route-next={`route-${i + 1}`}>Next name</button>}
          </div>
        );
      })}
    </figure>
    <div class="il-after">
      <p>The whole design fits in four lines:</p>
      <pre><code>{`name = remove_ranking(published)
school = reviewed_names.get(name)
if school is missing:
    send_to_person(name)`}</code></pre>
      <p>A false merge hides. An unmatched name shows up in a queue.</p>
      <button type="button" class="il-next" data-next="6">Set the policy</button>
    </div>
  </section>

  <section class="il-step" data-step="6">
    <h3 tabindex="-1">How much should AI decide alone?</h3>
    <p>A similarity score can auto-merge names above a cutoff. Removing rankings turns the {data.spellings} published spellings into {total} distinct names. This matcher can only choose among the {data.matcher.members} conference members, and Westbrook is not one. Drag the cutoff to 0.90 and watch what each setting costs.</p>
    <div class="il-policy">
      <label for="il-cutoff">Cutoff <output data-cutoff>0.70</output></label>
      <input id="il-cutoff" type="range" min="0" max={data.cutoffs.length - 1} step="1" value={startIndex} data-slider />
      <div class="il-bar" aria-hidden="true"><i class="right" data-bar="right" style={share(at70.right)}></i><i class="wrong" data-bar="wrong" style={share(at70.wrong)}></i><i class="review" data-bar="review" style={share(at70.review)}></i></div>
      <dl aria-live="polite">
        <div><dt>Merged correctly</dt><dd data-count="right">{at70.right}</dd></div>
        <div class="wrong"><dt>Merged wrongly, silently</dt><dd data-count="wrong">{at70.wrong}</dd></div>
        <div><dt>No match, left for a person</dt><dd data-count="review">{at70.review}</dd></div>
      </dl>
      <p class="il-wrong-names"><span>Wrong merges at this cutoff:</span> <strong data-wrong-names></strong></p>
      <div data-unlock="every-school">
        <label class="il-toggle"><input type="checkbox" data-every-school /> Add all {data.schools.clean} schools to the candidate list</label>
        <p class="il-toggle-note" data-toggle-note></p>
      </div>
    </div>
    <div class="il-group" data-group data-unlock="policy-question">
      <p class="il-question">Which policy would you ship?</p>
      {ship.map((o) => <button type="button" data-why={o.why} data-correct={o.correct ? "" : undefined}>{o.label}</button>)}
      <p class="il-feedback" role="status"></p>
    </div>
    <div class="il-after"><button type="button" class="il-next" data-next="7">Make a real ruling</button></div>
  </section>

  <section class="il-step" data-step="7">
    <h3 tabindex="-1">Rule on “{data.lambert.published}”</h3>
    <p>A new box score uses this name. The conference has a St. Lambert, and there is also a Lambert State. This is all you know.</p>
    <div class="il-group" data-group data-unlocks="lambert-evidence">
      {firstRuling.map((o) => <button type="button" data-why={o.why} data-correct={o.correct ? "" : undefined}>{o.label}</button>)}
      <p class="il-feedback" role="status"></p>
    </div>
    <div data-unlock="lambert-evidence">
      <dl class="il-evidence">
        <div><dt>Abbreviation on the page</dt><dd>{data.lambert.abbr}</dd></div>
        <div><dt>Lambert State publishes as</dt><dd>{data.lambert.lambertStateAbbr}</dd></div>
        <div><dt>St. Lambert publishes as</dt><dd>{data.lambert.stLambertAbbr}</dd></div>
        <div><dt>Home ground</dt><dd>{data.lambert.stadium}</dd></div>
      </dl>
      <div class="il-group" data-group>
        <p class="il-question">New evidence arrived. Rule again.</p>
        {secondRuling.map((o) => <button type="button" data-why={o.why} data-correct={o.correct ? "" : undefined}>{o.label}</button>)}
        <p class="il-feedback" role="status"></p>
      </div>
    </div>
    <div class="il-after"><button type="button" class="il-next" data-next="8">Try it on different data</button></div>
  </section>

  <section class="il-step" data-step="8">
    <h3 tabindex="-1">Same job, different data</h3>
    <div class="il-ai">
      <p class="il-ai-who">AI assistant <span>scripted example</span></p>
      <p>I merged 4,812 customer records into 4,106. No errors. Priya Shah is our top customer.</p>
    </div>
    <div class="il-group il-customers" data-group data-unlocks="customer-cause">
      <p class="il-question">Every order here requires an account. Which record would you question first?</p>
      {customers.map((c) => (
        <button type="button" data-why={c.why} data-correct={c.correct ? "" : undefined}>
          <strong>{c.name}</strong><span>{c.orders} orders</span><span>First order {c.first}, account opened {c.opened}</span>
        </button>
      ))}
      <p class="il-feedback" role="status"></p>
    </div>
    <div class="il-group" data-group data-unlock="customer-cause" data-unlocks="customer-evidence" data-action="cause" data-neutral>
      <p class="il-question">What could produce this?</p>
      {causes.map((o) => <button type="button" data-why={o.why} data-correct>{o.label}</button>)}
      <p class="il-feedback" role="status"></p>
    </div>
    <div class="il-group" data-group data-unlock="customer-evidence" data-unlocks="customer-sources">
      <p class="il-question">Which check would settle it?</p>
      {settle.map((o) => <button type="button" data-why={o.why} data-correct={o.correct ? "" : undefined}>{o.label}</button>)}
      <p class="il-feedback" role="status"></p>
    </div>
    <div data-unlock="customer-sources">
      <p class="il-question">Source records behind Jo Park</p>
      <div class="il-sources">
        {sourceRecords.map((r) => (
          <dl>
            <div><dt>Source id</dt><dd>{r.id}</dd></div>
