<script>
  const root = document.querySelector<HTMLElement>("[data-lesson]");

  if (root) {
    type Row = { slug: string; games: number; perGame: number };
    type Cutoff = { cutoff: number; right: number; wrong: number; review: number; wrongNames: { name: string; into: string }[] };
    const data = JSON.parse(root.querySelector("#il-data")!.textContent!) as {
      clean: Row[]; cutoffs: Cutoff[]; allCutoffs: Cutoff[]; low: number; high: number; schools: { clean: number; merged: number };
    };
    const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const board = root.querySelector<HTMLElement>("[data-board]")!;
    const body = board.querySelector("tbody")!;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const ledger = root.querySelector<HTMLElement>("[data-ledger]")!;
    const token = root.querySelector<SVGCircleElement>("[data-token]")!;
    const behavior: ScrollBehavior = calm ? "auto" : "smooth";
    const wait = (ms: number) => new Promise((done) => setTimeout(done, calm ? 0 : ms));
    const signed = (n: number) => (n > 0 ? `+${n.toFixed(2)}` : n.toFixed(2).replace("-", "−"));
    const ledgerSvg = root.querySelector<SVGSVGElement>("[data-ledger-svg]")!;
    const fullLedger = ledgerSvg.getAttribute("viewBox")!;
    ledgerSvg.setAttribute("viewBox", "0 0 344 206");
    let predicted = "";
    const moveFocus = (target: HTMLElement | null | undefined, fromKeyboard: boolean) => {
      target?.focus({ preventScroll: !fromKeyboard });
    };

    const openStep = (n: string) => {
      const step = root.querySelector<HTMLElement>(`[data-step="${n}"]`)!;
      step.classList.add("is-open");
      if (n === "2") {
        root.querySelector('[data-step="1"]')!.classList.add("is-done");
        const prompt = root.querySelector<HTMLElement>("[data-board-prompt]")!;
        prompt.classList.add("is-open");
        board.classList.add("is-picking");
        board.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((b) => (b.disabled = false));
        prompt.focus({ preventScroll: true });
        board.scrollIntoView({ behavior, block: "start" });
        return;
      }
      if (n === "3") {
        root.querySelector("[data-board-prompt]")!.classList.remove("is-open");
        root.querySelector('[data-step="2"]')!.classList.add("is-done");
      }
      const heading = step.querySelector<HTMLElement>("h3");
      heading?.focus({ preventScroll: true });
      heading?.scrollIntoView({ behavior, block: "start" });
    };

    const renderBoard = (rows: Row[]) => {
      const nodes = new Map([...body.querySelectorAll<HTMLElement>("tr")].map((tr) => [tr.dataset.row!, tr]));
      const tops = new Map([...nodes].map(([slug, tr]) => [slug, tr.getBoundingClientRect().top]));
      rows.forEach((row, i) => {
        const tr = nodes.get(row.slug)!;
        tr.querySelector("[data-rank]")!.textContent = String(i + 1);
        tr.querySelector("[data-games]")!.textContent = String(row.games);
        tr.querySelector("[data-gd]")!.textContent = signed(row.perGame);
        body.append(tr);
      });
      if (calm) return;
      nodes.forEach((tr, slug) => {
        const shift = tops.get(slug)! - tr.getBoundingClientRect().top;
        if (shift) tr.animate([{ transform: `translateY(${shift}px)` }, { transform: "none" }], { duration: 750, easing: "cubic-bezier(0.2, 0.75, 0.2, 1)" });
      });
    };

    const stepDone = (step: HTMLElement) => {
      if ([...step.querySelectorAll<HTMLElement>("[data-group]")].every((g) => g.dataset.solved)) {
        const after = step.querySelector<HTMLElement>(":scope > .il-after");
        after?.classList.add("is-open");
        after?.scrollIntoView({ behavior, block: "nearest" });
      }
    };

    const nextTarget = (step: HTMLElement) => {
      const nextGroup = [...step.querySelectorAll<HTMLElement>("[data-group]")].find((g) => !g.dataset.solved);
      if (nextGroup) return nextGroup.querySelector<HTMLElement>("button:not(:disabled)");
      const after = step.querySelector<HTMLElement>(":scope > .il-after");
      return after?.querySelector<HTMLElement>(".il-next") ?? after?.querySelector<HTMLElement>("h3");
    };

    const repairLedger = async () => {
      root.querySelector("[data-questions]")!.classList.add("is-done");
      ledger.scrollIntoView({ behavior, block: "center" });
      await wait(550);
      ledger.classList.add("is-repaired");
      root.querySelector("[data-schools]")!.textContent = String(data.schools.clean);
      root.querySelector("[data-schools-note]")!.textContent = "real schools. Westbrook is back among the outside opponents, so the standings still list the same conference teams.";
      root.querySelector("[data-ledger-intro]")!.textContent = "Every result stays, and each side returns to the school that played it.";
      root.querySelector("[data-ledger-heading]")!.textContent = "Two schools, each with its own results";
      root.querySelector("[data-ledger-svg]")!.setAttribute("aria-label", "The WBSU appearances have moved out of Eastbrook State and into Westbrook State.");
      await wait(900);
      const show = root.querySelector<HTMLElement>("[data-show-standings]")!;
      show.classList.add("is-open");
      show.scrollIntoView({ behavior, block: "nearest" });
      show.querySelector("button")!.focus({ preventScroll: true });
    };

    root.querySelector("[data-show-standings] button")!.addEventListener("click", async (event) => {
      const step = root.querySelector<HTMLElement>('[data-step="4"]')!;
      const fromKeyboard = (event as MouseEvent).detail === 0;
      root.querySelector("[data-show-standings]")!.classList.remove("is-open");
      root.querySelector("[data-board-slot]")!.append(board);
      board.querySelector("[data-board-prompt]")!.classList.remove("is-open");
      board.querySelector<HTMLElement>("[data-pick-feedback]")!.hidden = true;
      board.scrollIntoView({ behavior, block: "start" });
      await wait(550);
      renderBoard(data.clean);
      const row = board.querySelector('[data-row="eastbrook-state"]')!;
      row.classList.remove("is-flagged");
      row.classList.add("is-fixed");
      board.querySelectorAll("tr.is-rejected").forEach((tr) => tr.classList.remove("is-rejected"));
      status.textContent = "Identity repaired, leaders disagree";
      status.classList.add("fixed");
      await wait(calm ? 0 : 950);
      stepDone(step);
      moveFocus(nextTarget(step), fromKeyboard);
    });

    const sendToken = (end: string) => {
      const stops = [[8, 59], [63, 59], [161, 59], [228, 59], end === "school" ? [262, 26] : [262, 92]];
      const last = stops[stops.length - 1];
      token.setAttribute("transform", `translate(${last[0]} ${last[1]})`);
      if (calm) return;
      token.animate(stops.map(([x, y]) => ({ transform: `translate(${x}px, ${y}px)` })), { duration: 850, easing: "ease-in-out" });
    };

    root.querySelectorAll<HTMLElement>("[data-group]").forEach((group) => {
      const feedback = group.querySelector<HTMLElement>(".il-feedback")!;
      const buttons = [...group.querySelectorAll<HTMLButtonElement>("button[data-why]")];
      buttons.forEach((button) => button.addEventListener("click", (event) => {
        feedback.textContent = button.dataset.why!;
        const right = "correct" in button.dataset;
        const neutral = "neutral" in group.dataset;
        feedback.classList.toggle("good", right && !neutral);
        feedback.classList.toggle("neutral", neutral);
        button.classList.add(neutral ? "is-chosen" : right ? "is-right" : "is-wrong");
        if (!right) {
          feedback.scrollIntoView({ behavior, block: "nearest" });
          return;
        }
        buttons.forEach((b) => (b.disabled = true));
        group.dataset.solved = "true";
        if (button.dataset.end) sendToken(button.dataset.end);
        if (group.dataset.unlocks) {
          root.querySelector(`[data-unlock="${group.dataset.unlocks}"]`)!.classList.add("is-open");
          feedback.scrollIntoView({ behavior, block: "start" });
        }
        const step = group.closest<HTMLElement>("[data-step]")!;
        const fromKeyboard = event.detail === 0;
        if (group.dataset.action === "predict") {
          predicted = button.textContent!.trim();
          root.querySelector("[data-prediction]")!.textContent = `Your prediction: ${predicted}.`;
        }
        if (group.dataset.action === "cause") {
          root.querySelector("[data-cause-note]")!.textContent = `You suspected: ${button.textContent!.trim()}. Does the evidence agree?`;
        }
        if (group.dataset.action === "diagnose") {
          ledger.classList.add("is-diagnosed");
          ledgerSvg.setAttribute("viewBox", fullLedger);
          root.querySelector("[data-prediction]")!.textContent = predicted === "Two schools became one"
            ? "Your prediction held: two schools became one."
            : `You predicted: ${predicted}. The evidence shows two schools became one.`;
        }
        if (group.dataset.action === "split") {
          void repairLedger();
          return;
        }
        const routeNext = group.querySelector<HTMLElement>("[data-route-next]");
        if (routeNext) {
          routeNext.scrollIntoView({ behavior, block: "nearest" });
          moveFocus(routeNext, fromKeyboard);
          return;
        }
        stepDone(step);
        moveFocus(nextTarget(step), fromKeyboard);
      }));
    });

    root.querySelectorAll<HTMLButtonElement>("[data-route-next]").forEach((button) => button.addEventListener("click", () => {
      button.closest("[data-group]")!.classList.add("is-past");
      const next = root.querySelector<HTMLElement>(`[data-unlock="${button.dataset.routeNext}"]`)!;
      next.classList.add("is-open");
      token.setAttribute("transform", "translate(8 59)");
      next.querySelector<HTMLElement>("button")!.focus({ preventScroll: true });
      next.closest("figure")!.scrollIntoView({ behavior, block: "nearest" });
    }));

    root.querySelectorAll<HTMLButtonElement>("[data-next]").forEach((b) => b.addEventListener("click", () => {
      openStep(b.dataset.next!);
      b.hidden = true;
    }));

    const retrieve = root.querySelector<HTMLElement>("[data-retrieve]")!;
    const askButtons = [...retrieve.querySelectorAll<HTMLButtonElement>("[data-ask]")];
    const askFeedback = retrieve.querySelector<HTMLElement>(".il-feedback")!;
    askButtons.forEach((b) => b.addEventListener("click", () => b.setAttribute("aria-pressed", String(b.getAttribute("aria-pressed") !== "true"))));
    retrieve.querySelector<HTMLButtonElement>("[data-check-asks]")!.addEventListener("click", (event) => {
      const chosen = askButtons.filter((b) => b.getAttribute("aria-pressed") === "true");
      const miss = chosen.find((b) => !("good" in b.dataset));
      askFeedback.classList.remove("good");
      if (chosen.length !== 3) askFeedback.textContent = `You chose ${chosen.length}. Choose exactly three.`;
      else if (miss) askFeedback.textContent = `“${miss.textContent}” would not catch this. ${miss.dataset.miss}`;
      else {
        askFeedback.textContent = "Right. Each of these can expose a merge that raised no error.";
        askFeedback.classList.add("good");
        askButtons.forEach((b) => (b.disabled = true));
        (event.currentTarget as HTMLButtonElement).hidden = true;
        retrieve.dataset.solved = "true";
        const step = retrieve.closest<HTMLElement>("[data-step]")!;
        stepDone(step);
        const close = step.querySelector<HTMLElement>(".il-close")!;
        close.scrollIntoView({ behavior, block: "start" });
        moveFocus(close.querySelector("h3"), (event as MouseEvent).detail === 0);
        return;
      }
      askFeedback.scrollIntoView({ behavior, block: "nearest" });
    });

    const pickFeedback = root.querySelector<HTMLElement>("[data-pick-feedback]")!;
    const pickStep = root.querySelector<HTMLElement>('[data-step="2"]')!;
    body.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (!board.classList.contains("is-picking") || target.closest("button")) return;
      target.closest("tr")?.querySelector<HTMLButtonElement>("[data-pick]")?.click();
    });
    board.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((button) => button.addEventListener("click", (event) => {
      const tr = button.closest("tr")!;
      const games = Number(tr.querySelector("[data-games]")!.textContent);
      if (games > data.high) {
        pickFeedback.textContent = `${games} games. Every other team played ${data.low} to ${data.high}. How did Eastbrook get extra games?`;
        pickFeedback.classList.add("good");
        tr.classList.add("is-flagged");
        board.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((b) => (b.disabled = true));
        board.classList.remove("is-picking");
        const after = pickStep.querySelector<HTMLElement>(".il-after")!;
        after.classList.add("is-open");
        after.scrollIntoView({ behavior, block: "nearest" });
        moveFocus(after.querySelector<HTMLElement>(".il-next"), event.detail === 0);
      } else {
        pickFeedback.textContent = `${button.textContent} played ${games} games, inside the normal range of ${data.low} to ${data.high}. Compare the Games column.`;
        pickFeedback.classList.remove("good");
        tr.classList.add("is-rejected");
        pickFeedback.scrollIntoView({ behavior, block: "nearest" });
      }
    }));

    const slider = root.querySelector<HTMLInputElement>("[data-slider]")!;
    const everySchool = root.querySelector<HTMLInputElement>("[data-every-school]")!;
    const showCutoff = () => {
      const c = (everySchool.checked ? data.allCutoffs : data.cutoffs)[Number(slider.value)];
      const total = c.right + c.wrong + c.review;
      root.querySelector("[data-cutoff]")!.textContent = c.cutoff.toFixed(2);
      (["right", "wrong", "review"] as const).forEach((key) => {
        root.querySelector(`[data-count="${key}"]`)!.textContent = String(c[key]);
        root.querySelector<HTMLElement>(`[data-bar="${key}"]`)!.style.width = `${(c[key] / total) * 100}%`;
      });
      root.querySelector("[data-wrong-names]")!.textContent = c.wrongNames.length ? c.wrongNames.map((w) => `${w.name} into ${w.into}`).join(", ") : "none";
      slider.setAttribute("aria-valuetext", `Cutoff ${c.cutoff.toFixed(2)}: ${c.right} correct, ${c.wrong} wrong, ${c.review} for a person`);
    };
    slider.addEventListener("input", () => {
      showCutoff();
      if (data.cutoffs[Number(slider.value)].cutoff >= 0.9) root.querySelector('[data-unlock="every-school"]')!.classList.add("is-open");
    });
    everySchool.addEventListener("change", () => {
      showCutoff();
      root.querySelector("[data-toggle-note]")!.textContent = "With the true school on the list, the wrong merges disappear at every cutoff. So the real risk is a school nobody listed: the matcher absorbs it into the closest name, with no error.";
      root.querySelector('[data-unlock="policy-question"]')!.classList.add("is-open");
    });
    showCutoff();

    root.querySelector("[data-restart]")!.addEventListener("click", () => {
      history.scrollRestoration = "manual";
      location.reload();
    });
  }
</script>
