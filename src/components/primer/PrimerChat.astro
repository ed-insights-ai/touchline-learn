---
import "./primer.css";

interface Props { prompt: string; back: string; about: string; turn: string; module?: string }
const { prompt, back, about, turn, module = "Module 1" } = Astro.props;
const sparkle = `<svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 2.5l1.9 5.6 5.6 1.9-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.9z" fill="currentColor"/><path d="M18.5 15l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z" fill="currentColor" opacity=".7"/></svg>`;
---

<div class="pr not-content" data-primer>
  <a class="pr-back" href={back}>← Back to {module}</a>
  <p class="pr-about">{about}</p>

  <div class="pr-thread">
    <div class="pr-you">
      <p class="pr-who">You</p>
      <p class="pr-bubble" data-copy-text>{prompt}</p>
    </div>

    <div class="pr-ai">
      <p class="pr-who"><span class="pr-avatar" aria-hidden="true" set:html={sparkle} />AI assistant</p>
      <p class="pr-typing" aria-hidden="true"><span></span><span></span><span></span> Thinking</p>
      <script is:inline>document.querySelector("[data-primer]").classList.add("is-sending");</script>
      <article class="pr-reply" aria-live="polite">
        <slot />
      </article>
    </div>
  </div>

  <aside class="pr-turn">
    <p class="pr-turn-head">Your turn</p>
    <p>{turn}</p>
    <div class="pr-turn-actions">
      <button type="button" data-primer-copy>Copy prompt</button>
      <a href={back}>Back to {module}</a>
    </div>
  </aside>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-primer]");
  if (root) {
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    setTimeout(() => { root.classList.remove("is-sending"); root.classList.add("is-sent"); }, calm ? 0 : 2600);
    const button = root.querySelector<HTMLButtonElement>("[data-primer-copy]");
    button?.addEventListener("click", async () => {
      const text = root.querySelector<HTMLElement>("[data-copy-text]")?.textContent ?? "";
      try { await navigator.clipboard.writeText(text); button.textContent = "Copied"; }
      catch { button.textContent = "Select the prompt and copy it"; }
      setTimeout(() => { button.textContent = "Copy prompt"; }, 2500);
    });
  }
</script>
