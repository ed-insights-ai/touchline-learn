---
import PrimerChat from "../PrimerChat.astro";
import { aiCardId, archiveAi } from "../../../lib/archive-ai";

const card = archiveAi.setup;
type Status = "approved" | "revoked";
type Rec = { page: string; status: Status };
const saved: Rec[] = ["A", "B", "B", "C", "D"].map((page) => ({ page, status: "approved" }));
const changes = [
  { key: "a", label: "Pages E and F were approved", apply: (rs: Rec[]): Rec[] => [...rs, { page: "E", status: "approved" }, { page: "F", status: "approved" }] },
  { key: "n", label: "Page C's approval was revoked", apply: (rs: Rec[]) => rs.map((r): Rec => (r.page === "C" ? { ...r, status: "revoked" } : r)) },
];
const approved = (rs: Rec[]) => rs.filter((r) => r.status === "approved");
const counts = { old: (rs: Rec[]) => approved(rs).length, fixed: (rs: Rec[]) => new Set(approved(rs).map((r) => r.page)).size };
const before = counts.old(saved);
const replay = counts.fixed(saved);
const fromCode = replay - before;
const signed = (n: number) => (n === 0 ? "±0" : `${n < 0 ? "−" : "+"}${Math.abs(n)}`);
const delta = (c: (typeof changes)[number]) => counts.fixed(c.apply(saved)) - replay;
const twice = saved.filter((r, i) => saved.findIndex((x) => x.page === r.page) !== i).map((r) => r.page);
const pages = (rs: Rec[]) => [...new Set(rs.map((r) => r.page))];
const countedTwice = (rs: Rec[], r: Rec, i: number) => rs.findIndex((x) => x.page === r.page) !== i;

const subsets = Array.from({ length: 1 << changes.length }, (_, m) => changes.filter((_, i) => m & (1 << i)));
const states = subsets.map((on) => {
  const rows = on.reduce((rs, c) => c.apply(rs), saved);
  const t = counts.fixed(rows);
  return {
    key: changes.map((c) => (on.includes(c) ? c.key : "")).join("") || "0",
    rows,
    total: t,
    diff: on.length === 0
      ? `${signed(t - before)} from yesterday, all of it from the fix`
      : `${signed(t - before)} from yesterday: ${signed(fromCode)} from the fix, ${on.map((c) => signed(delta(c))).join(" ")}${on.length > 1 ? ` = ${signed(t - replay)}` : ""} from the source`,
  };
});
const today = states[states.length - 1];
if (states.some((st) => st.total - replay !== changes.filter((c) => st.key.includes(c.key)).reduce((n, c) => n + delta(c), 0))) throw new Error("source changes are not additive");
if (states.map((st) => st.key).sort().join() !== "0,a,an,n") throw new Error("lane styles expect the change keys a and n");
if (today.total !== before || twice.join() !== "B") throw new Error("the reply's coincidence no longer holds");
const list = (xs: string[]) => `${xs.slice(0, -1).join(", ")}, and ${xs.at(-1)}`;

const checks = [
  ["Replay", "What totals do the old and fixed code produce when you replay yesterday's saved file?"],
  [`${today.total} again`, `Today's fresh fetch gives ${today.total} with the fixed code, the same number the website showed yesterday. Why does that match tell you so little?`],
  ["Yesterday and today", "If you need to correct yesterday's count and publish today's count, which operation would you use for each, and which source copies would you keep?"],
];
---

<PrimerChat
  prompt={card.prompt}
  module="Module 2"
  back={`../02-archive/#${aiCardId("setup")}`}
  about="This is a reply an AI assistant gave to Module 2's re-fetch study prompt, lightly edited. Send the same prompt yourself and you will get a different reply."
  turn={`In a live chat, you would answer those three questions and the assistant would review your reasoning. To try that, copy the prompt into your own AI assistant. Then go back to Part 1 and ${card.returnTask.replace("Then come back and ", "")}`}
>
  <h2 class="pr-title">One day of approved pages</h2>
  <p>Yesterday, a volunteer transcription project's website reported <strong>{before} approved pages</strong>. The source file listed {["no", "one", "two", "three", "four"][pages(saved).length]} approved pages, {pages(saved)[0]} through {pages(saved).at(-1)}, but page {twice[0]} appeared twice. The pipeline counted rows, so it counted {twice[0]} twice. The fix is to count distinct approved page IDs.</p>

  <h2>1. Replay and re-fetch</h2>
  <p>A <strong>replay</strong> runs your code over the source file you saved yesterday. The old code gives <strong>{before}</strong> again. The fixed code gives <strong>{replay}</strong>. Because both runs use the same input, the one-page difference comes from the code change.</p>
  <p>A <strong>re-fetch</strong> asks the live source for a fresh copy. Suppose that by today, volunteers have approved pages E and F and revoked C's approval. The fixed code now counts <strong>{today.total}</strong> approved pages: {list(pages(approved(today.rows)))}. That matches yesterday's published number by coincidence.</p>
  <p class="pr-pull">Comparing the two totals hides both the bug fix and the changes in approvals.</p>
  <p>Live sources can also change when someone corrects a record, deletes an entry, or backfills an approval.</p>
  <figure class="pr-card pa-rf">
    <fieldset class="pa-rf-controls">
      <legend>What changed at the source since yesterday</legend>
      {changes.map((c) => <label><input type="checkbox" value={c.key} checked /> <span>{c.label}</span></label>)}
    </fieldset>
    <div aria-live="polite">
    <div class="pa-lanes">
      <div class="pa-lane is-old">
        <p class="pa-lane-head"><b>Yesterday's report</b><span>saved copy, old code</span></p>
        <ul>{saved.map((r) => <li><span>Page {r.page} · {r.status}</span><b>1</b></li>)}</ul>
        <p class="pa-lane-total"><span>Pages counted</span><b>{before}</b></p>
      </div>
      <div class="pa-lane is-replay">
        <p class="pa-lane-head"><b>Replay</b><span>saved copy, fixed code</span></p>
        <ul>{saved.map((r, i) => <li class={countedTwice(saved, r, i) ? "is-moved" : ""}><span>Page {r.page} · {r.status}{countedTwice(saved, r, i) && " · repeat"}</span><b>{countedTwice(saved, r, i) ? 0 : 1}</b></li>)}</ul>
        <p class="pa-lane-total"><span>Pages counted</span><b>{replay}</b></p>
        <p class="pa-lane-diff">{signed(fromCode)} from yesterday, all of it from the fix</p>
      </div>
      {states.map((st) => (
        <div class="pa-lane is-refetch" data-s={st.key}>
          <p class="pa-lane-head"><b>Re-fetch</b><span>today's source, fixed code</span></p>
          <ul>{st.rows.map((r, i) => {
            const y = saved[i];
            const counts1 = r.status === "approved" && !countedTwice(st.rows, r, i);
            return <li class={!y || y.status !== r.status || !counts1 ? "is-moved" : ""}><span>Page {r.page} · {r.status}{countedTwice(st.rows, r, i) && " · repeat"}</span><b>{counts1 ? 1 : 0}</b></li>;
          })}</ul>
          <p class="pa-lane-total"><span>Pages counted</span><b>{st.total}</b></p>
          <p class="pa-lane-diff">{st.diff}</p>
        </div>
      ))}
    </div>
    </div>
    <figcaption>Shaded rows differ from yesterday's report, in status or in what they count. Switch the source's changes off and on. The replay never moves, because its input is the saved copy. The re-fetch moves with the source, and with both changes on, its total matches yesterday's while the pages behind it differ.</figcaption>
  </figure>

  <h2>2. What you can reproduce</h2>
  <p>The saved copy lets you reproduce yesterday's <strong>{before}</strong> with the old code and correct it to <strong>{replay}</strong> with the fixed code. Exact reproduction also depends on preserving any other inputs or settings that affected the run, such as the reporting cutoff and time zone.</p>
  <p>If you keep only the latest copy, a re-fetch replaces yesterday's source file with today's version. The published <strong>{before}</strong> might still be in your logs, but that number alone can't tell you which pages were approved yesterday or which row appeared twice.</p>

  <h2>3. When to re-fetch</h2>
  <p>Re-fetch when you want today's count, when your saved copy is missing or incomplete, or when the source team has published a correction you want to incorporate. If your goal is to repair yesterday's result, replay the fixed code on yesterday's copy first. Then record a re-fetch as its own step so you can tell which changes came from the code and which came from the source.</p>
  <aside class="pr-course" aria-label="Course note">
    <p class="pr-label">Course note</p>
    <p>The reply's saved source file plays the part of Friday's captures in Kick's archive. Kick's plan in Part 1 is the reply's re-fetch: fix the tidy rule, fetch every school's site again, rebuild. Riley's ask is the replay: the fixed rule over the pages saved on Friday, with no site asked again.</p>
    <p>Like the reply's {today.total} against {before}, a re-fetched table set beside Tuesday's would mix the tidy rule fix with whatever the sites published after Friday. Keep that in mind when you lock in your prediction in Part 1.</p>
  </aside>

  <h2>Check your understanding</h2>
  <ol class="pr-checks">{checks.map(([name, q]) => <li><b>{name}</b><span>{q}</span></li>)}</ol>
</PrimerChat>


<style>
  .pa-rf:not(:has([value="a"]:checked)):not(:has([value="n"]:checked)) [data-s="0"],
  .pa-rf:has([value="a"]:checked):not(:has([value="n"]:checked)) [data-s="a"],
  .pa-rf:not(:has([value="a"]:checked)):has([value="n"]:checked) [data-s="n"],
  .pa-rf:has([value="a"]:checked):has([value="n"]:checked) [data-s="an"] { display: grid; }
  .pa-rf-controls { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; margin: 0 0 0.7rem; padding: 0; border: 0; font-size: 0.9rem; }
  .pa-rf-controls legend { width: 100%; margin-bottom: 0.3rem; color: var(--tl-muted); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .pa-rf-controls label { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 40px; cursor: pointer; }
  .pa-rf-controls input { width: 1.1rem; height: 1.1rem; accent-color: var(--pr-ai); }
  .pa-lanes { display: grid; gap: 0.6rem; }
  @media (min-width: 46rem) { .pa-lanes { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .pa-lane { display: grid; align-content: start; padding: 0.65rem 0.8rem; border: 1px solid var(--tl-line); border-top-width: 4px; border-radius: 8px; background: var(--tl-bg); }
  .pa-lane.is-old { border-top-color: var(--tl-muted); }
  .pa-lane.is-replay { border-top-color: var(--pr-green); }
  .pa-lane.is-refetch { display: none; border-top-color: #d9822b; }
  :global(.pr) .pa-lane-head { display: grid; margin: 0 0 0.4rem; }
  .pa-lane-head b { color: var(--sl-color-white); }
  .pa-lane-head span { color: var(--tl-muted); font-size: 0.82rem; }
  .pa-lane ul { display: grid; gap: 0.2rem; margin: 0 0 0.4rem; padding: 0; list-style: none; font-size: 0.88rem; }
  .pa-lane li { display: flex; justify-content: space-between; gap: 0.5rem; }
  .pa-lane li.is-moved { margin: 0 -0.35rem; padding: 0 0.35rem; border-radius: 4px; background: color-mix(in srgb, #d9822b 18%, transparent); font-weight: 600; }
  .pa-lane li b { font-variant-numeric: tabular-nums; }
  :global(.pr) .pa-lane-total { display: flex; justify-content: space-between; margin: 0; padding-top: 0.35rem; border-top: 1px solid var(--tl-line); }
  .pa-lane-total b { color: var(--sl-color-white); font-size: 1.3rem; font-variant-numeric: tabular-nums; }
  :global(.pr) .pa-lane-diff { margin: 0.35rem 0 0; color: var(--tl-muted); font-size: 0.82rem; }
</style>
