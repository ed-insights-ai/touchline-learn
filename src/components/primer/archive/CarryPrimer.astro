---
import PrimerChat from "../PrimerChat.astro";
import { aiCardId, archiveAi } from "../../../lib/archive-ai";

const card = archiveAi["carry-it"];
const kg = { whole: 12, fraction: 12.8 };
const axis = { lo: kg.whole - 1, hi: kg.whole + 2 };
const at = (x: number) => `${((x - axis.lo) / (axis.hi - axis.lo)) * 100}%`;
const ticks = Array.from({ length: axis.hi - axis.lo + 1 }, (_, i) => axis.lo + i);
const shipments = [kg.whole, kg.fraction];

const worlds = [
  {
    id: "every",
    tab: "Every version",
    kept: "Every raw submission, including resubmissions",
    recover: "It can replay the original inputs and rebuild exact shipment weights and monthly totals, provided it knows which submissions counted in each month. It can identify exactly which rows changed.",
    needed: "The raw files plus enough history to tell when each version arrived and which version each report used.",
    claim: ["Exact, with a record of versions used", "is-ok"],
  },
  {
    id: "table",
    tab: "Processed table only",
    kept: "Only the processed table",
    recover: `It can flag rows that went through the faulty importer if it can identify them. Each stored ${kg.whole} kg came from a weight of at least ${kg.whole} kg and less than ${kg.whole + 1} kg, so it can calculate bounds for the totals. It cannot tell which rows actually lost weight or recover the discarded decimals. A point estimate would require assumptions about those missing decimals.`,
    needed: "The original decimal weight for each imported row, with enough version history to match it to the report. Keeping an unaltered copy of that field would have been enough for this bug.",
    claim: ["Bounded", "is-bad"],
  },
  {
    id: "over",
    tab: "Overwritten on resubmission",
    kept: "Raw files, but each resubmission overwrote the source’s previous file",
    recover: "It can recover exact weights for rows it can match to the surviving versions. It cannot assume the latest file contains the same weights as an earlier one. Where an earlier raw file is gone and only its processed rows survive, it can flag those rows and bound the missing amounts, but the original decimals are lost.",
    needed: "A separate copy of each submitted version, with a record of which version each report used.",
    claim: ["Partly exact", "is-warn"],
  },
];

const notes = [
  ["Every submission survived", "“We corrected the six months of shipment totals by reprocessing the original file versions used in each report.”"],
  ["Only the processed table survived", "“The importer discarded fractional kilograms. The retained table supports a range for each monthly total. The original fractional weights cannot be recovered from that table.”"],
  ["Some submissions were overwritten", "“We corrected weights where we could match a retained source file to the version used in the original report. Earlier versions were overwritten for some submissions, so the original fractional weights for those rows could not be verified.”"],
];

const checks = [
  ["Museum collections", "For months, an importer dropped the day from acquisition dates. The museum kept every original form, and a log identifies which form version fed each catalog entry. What can it restore exactly?"],
  ["Manufacturing", "A sensor importer dropped the decimal part of each temperature in degrees Celsius. Only the processed table survives. If a row says 80 °C, what can you say about the original reading, and what remains unknown?"],
  ["Publishing", "An importer dropped the cents from royalty amounts. A publisher kept only the latest raw file from each distributor, because resubmissions overwrote earlier files. How would you word a correction note for an old statement that used a version you can no longer find?"],
];
---

<PrimerChat
  prompt={card.prompt}
  module="Module 2"
  back={`../02-archive/#${aiCardId("carry-it")}`}
  about="This is a reply an AI assistant gave to Module 2's transfer study prompt, lightly edited. Send the same prompt yourself and you will get a different reply."
  turn="In a live chat, you would answer those three questions and the assistant would review your reasoning. To try that, copy the prompt into your own AI assistant. Then go back to Part 9 and ask each of Part 9's worlds one new question: can it show what a clinic's form said before the clinic resubmitted it?"
>
  <h2 class="pr-title">One bug, three archives</h2>
  <p class="pr-pull">A bug fix tells you how to process an input correctly. The archive tells you which past inputs you can still process.</p>

  <h2>1. One bug across three archives</h2>
  <p>Imagine a coffee roaster whose suppliers submit shipment weights in kilograms. For six months, the importer dropped the decimal part of every weight. It stored <code>{kg.fraction} kg</code> as <code>{kg.whole} kg</code>. A shipment of exactly <code>{kg.whole.toFixed(1)} kg</code> also appeared as <code>{kg.whole} kg</code>. The roaster fixes the importer and wants to correct its monthly totals.</p>
  <figure class="pr-card">
    <p class="pr-label">Two weights, one stored value</p>
    <div class="pa-merge">
      <div class="pa-merge-in"><p><code>{kg.whole.toFixed(1)} kg</code></p><p><code>{kg.fraction} kg</code></p></div>
      <p class="pr-arrow"><span>importer</span></p>
      <div class="pa-merge-out"><p><code>{kg.whole} kg</code><span>at least {kg.whole}, less than {kg.whole + 1}</span></p></div>
    </div>
    <div class="pa-line" role="img" aria-label={`Number line: a stored ${kg.whole} kg covers every weight from ${kg.whole} up to but not including ${kg.whole + 1} kg. Both shipments, ${kg.whole.toFixed(1)} and ${kg.fraction} kg, fall inside it.`}>
      <div class="pa-line-track">
        <span class="pa-line-band" style={`left:${at(kg.whole)};width:calc(${at(kg.whole + 1)} - ${at(kg.whole)})`}></span>
        {shipments.map((x) => <span class="pa-line-dot" style={`left:${at(x)}`}><small>{x.toFixed(1)}</small></span>)}
      </div>
      <div class="pa-line-ticks" aria-hidden="true">{ticks.map((t) => <span style={`left:${at(t)}`}>{t} kg</span>)}</div>
    </div>
    <figcaption>The stored value fixes a range, not a weight: the shaded kilogram. That range is all a processed table can offer.</figcaption>
  </figure>
  <figure class="pr-card pa-worlds" aria-live="polite">
    <p class="pr-label">The recovery claim each archive supports</p>
    <ul class="pa-glance">{worlds.map((w) => <li><span>{w.tab}</span><span class:list={["pr-chip", w.claim[1]]}>{w.claim[0]}</span></li>)}</ul>
    <fieldset class="pr-seg">
      <legend>What the roaster kept</legend>
      {worlds.map((w, i) => <label><input type="radio" name="pa-carry-world" value={w.id} checked={i === 0} /><span>{w.tab}</span></label>)}
    </fieldset>
    {worlds.map((w) => (
      <div class="pa-world" data-world={w.id}>
        <p class="pa-world-head"><span class="pa-world-kept">{w.kept}</span><span class:list={["pr-chip", w.claim[1]]}>{w.claim[0]}</span></p>
        <p class="pr-label">What it can honestly recover</p>
        <p>{w.recover}</p>
        <p class="pr-label">What it needed to keep for full recovery</p>
        <p>{w.needed}</p>
      </div>
    ))}
  </figure>

  <h2>2. What to put in a correction note</h2>
  <p>A correction note should describe what the archive let you verify. Here’s how the roaster could write one in each case.</p>
  <ul class="pa-notes">{notes.map(([k, v]) => <li><b>{k}</b><span>{v}</span></li>)}</ul>
  <aside class="pr-course" aria-label="Course note">
    <p class="pr-label">Course note</p>
    <p>The reply's three archives are Part 9's three worlds, moved from a clinic network to a coffee roaster. Every raw submission is World A, only the processed table is World B, and overwritten on resubmission is World C.</p>
    <p>The reply's third row draws the line World C's claims must respect: exact where a surviving file can be matched to the version a report used, flagged where it cannot. The latest file is not evidence of what an earlier one held. A bound depends on what survives, in the archive's own terms. Each stored weight gives the roaster a range one kilogram wide. A clinic table that filed follow-up visits as new patients gives a count instead: of its rows marked new patient, anywhere from none to all of them might have been follow-ups.</p>
  </aside>

  <h2>3. Check your understanding</h2>
  <ol class="pr-checks">{checks.map(([field, q]) => <li><b>{field}</b><span>{q}</span></li>)}</ol>
</PrimerChat>

<style>
  .pa-worlds .pr-seg { margin-bottom: 0.7rem; }
  .pa-glance { display: grid; gap: 0.35rem; margin: 0 0 0.9rem; padding: 0; list-style: none; font-size: 0.9rem; }
  .pa-glance li { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.3rem 0.6rem; padding: 0.35rem 0.6rem; border-radius: 6px; background: var(--tl-bg); }
  .pa-world { display: none; padding: 0.7rem 0.9rem; border: 1px solid var(--tl-line); border-radius: 10px; background: var(--tl-bg); }
  .pa-worlds:has([value="every"]:checked) [data-world="every"],
  .pa-worlds:has([value="table"]:checked) [data-world="table"],
  .pa-worlds:has([value="over"]:checked) [data-world="over"] { display: block; }
  :global(.pr) .pa-worlds p { margin: 0 0 0.5rem; font-size: 0.92rem; }
  :global(.pr) .pa-worlds p:last-child { margin: 0; }
  :global(.pr) .pa-worlds .pr-label { margin: 0 0 0.15rem; }
  :global(.pr) .pa-world-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem 0.6rem; margin: 0 0 0.6rem !important; }
  :global(.pr) .pa-world-kept { color: var(--sl-color-white); font-weight: 700; }
  .pa-merge { display: grid; gap: 0.4rem; align-items: center; }
  @media (min-width: 46rem) { .pa-merge { grid-template-columns: 1fr auto 1fr; } }
  .pa-merge-in, .pa-merge-out { display: grid; gap: 0.35rem; }
  :global(.pr) .pa-merge-in p, :global(.pr) .pa-merge-out p { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; margin: 0; padding: 0.4rem 0.7rem; border: 1px solid var(--tl-line); border-radius: 8px; background: var(--tl-bg); font-size: 0.88rem; }
  :global(.pr) .pa-merge-out p { border: 1.5px dashed var(--pr-red); }
  .pa-merge-out span { color: var(--tl-muted); }
  .pa-line { margin: 2.1rem 0.8rem 0.4rem; }
  .pa-line-track { position: relative; height: 0.5rem; border-radius: 999px; background: var(--tl-line); }
  .pa-line-band { position: absolute; top: -0.35rem; bottom: -0.35rem; border: 1.5px dashed var(--pr-red); border-right-style: none; border-radius: 4px 0 0 4px; background: color-mix(in srgb, var(--pr-red) 18%, transparent); }
  .pa-line-dot { position: absolute; top: 50%; width: 0.8rem; height: 0.8rem; margin: -0.4rem 0 0 -0.4rem; border-radius: 50%; background: var(--sl-color-white); box-shadow: 0 0 0 2px var(--tl-bg); }
  .pa-line-dot small { position: absolute; bottom: 0.95rem; left: 50%; transform: translateX(-50%); color: var(--sl-color-white); font-size: 0.78rem; font-weight: 600; white-space: nowrap; }
  .pa-line-ticks { position: relative; height: 1.4rem; margin-top: 0.5rem; }
  .pa-line-ticks span { position: absolute; transform: translateX(-50%); color: var(--tl-muted); font-size: 0.78rem; white-space: nowrap; }
  .pa-notes { display: grid; gap: 0.5rem; margin: 0 0 1rem; padding: 0; list-style: none; }
  .pa-notes li { display: grid; gap: 0.2rem; padding: 0.6rem 0.85rem; border-left: 3px solid var(--pr-yellow); border-radius: 6px; background: var(--tl-card); }
  .pa-notes b { color: var(--sl-color-white); }
</style>
