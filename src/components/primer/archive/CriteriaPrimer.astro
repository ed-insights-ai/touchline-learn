---
import PrimerChat from "../PrimerChat.astro";
import { aiCardId, archiveAi } from "../../../lib/archive-ai";

const card = archiveAi.rewind;

const criteria = [
  ["Account for every expected input.", "The report names the saved manifest that defines the expected files. For every file the rebuild reads, it records the relative path and the SHA-256 hash of the exact bytes read. It lists missing files separately and states the effect of each absence. For example, a missing required sensor export fails the run. A missing optional calibration file may allow the run to proceed under a documented rule."],
  ["Identify the code and effective configuration.", "Record the full Git commit and verify that the code used for the rebuild matches it. Record a SHA-256 fingerprint of the effective configuration after resolving defaults and overrides, and save that configuration in a stable format so you can recompute the fingerprint. For daily readings, the timezone, rounding rule, and missing-value policy can all affect the output. Record the runtime and dependency lockfile hash if they can affect the result."],
  ["Make “no network requests” observable.", "Run the rebuild and its child processes in an environment that blocks network access. Save evidence that the restriction was active and an audit log that records attempted network access, including attempts that were blocked. A passing report shows zero attempts and complete audit coverage for the run. A missing audit makes the claim unverified. A blocked attempt means the restriction worked, but the zero-attempt criterion failed."],
  ["Explain every output difference.", "Identify the saved baseline and rebuilt output by hash. Compare rows by a stable key such as (sensor_id, date_utc), reject duplicate keys, and report added rows, removed rows, and changed cells. For each changed cell, show the old and new values, cite the source records or rule change, and give enough detail to verify the calculation. An unexplained change means the rebuild failed acceptance. It does not establish the cause of the discrepancy."],
];

const audits = [
  ["coverage: full run · attempts: 0", "Pass", "is-ok", "Zero attempts, and the audit covers the whole run."],
  ["coverage: full run · attempts: 1 (blocked)", "Fail", "is-bad", "The restriction worked, but the zero-attempt criterion did not."],
  ["network-audit.json not saved", "Unverified", "is-warn", "Without an audit, the claim has no evidence."],
];

const baseline = [19.0, 21.0];
const rebuilt = [19.0, 23.0];
const mean = (xs: number[]) => (xs.reduce((a, b) => a + b, 0) / xs.length).toFixed(1);
const f1 = (n: number) => n.toFixed(1);

const report = `Run: daily-readings-042
Result: PASS

Saved inputs read (SHA-256 of file bytes)
  inputs/manifest.json
    12af45b812af45b812af45b812af45b812af45b812af45b812af45b812af45b8
  inputs/sensor-17/2026-11-20.csv
    9ce402ad9ce402ad9ce402ad9ce402ad9ce402ad9ce402ad9ce402ad9ce402ad

Expected input missing
  inputs/calibration/2026-11-20.csv
  Optional per manifest. Effective config applies a 0.0 °C offset.

Code and configuration
  Git commit: 8f24c6a571b02ce683bd993036e63dadd75c4537
  Source checkout verified clean.
  Saved effective config: evidence/effective-config.json
  Config SHA-256: 62d71a0b62d71a0b62d71a0b62d71a0b62d71a0b62d71a0b62d71a0b62d71a0b
  Effective settings: UTC days, arithmetic mean, round to one decimal.

Network
  evidence/sandbox.json confirms networking was blocked for the
  rebuild and its child processes.
  evidence/network-audit.json covers the full run: 0 attempts.

Comparison
  SHA-256 for baseline.csv and rebuilt.csv: evidence/output-hashes.txt
  Row key: (sensor_id, date_utc). Duplicate keys: 0.
  Added rows: 0. Removed rows: 0. Changed cells: 1.
  S17, 2026-11-20, mean_temp_c: ${mean(baseline)} → ${mean(rebuilt)}.
  The archived baseline input had readings of ${baseline.map(f1).join(" and ")}.
  The rebuild input, lines 2–3, has ${rebuilt.map(f1).join(" and ")}.
  The lab’s correction record confirms ${f1(baseline[1])} → ${f1(rebuilt[1])} for the
  second reading. Under the same averaging rule, the means are
  (${baseline.map(f1).join(" + ")}) / 2 = ${mean(baseline)} and (${rebuilt.map(f1).join(" + ")}) / 2 = ${mean(rebuilt)}.
  Evidence: archived baseline manifest and corrections/S17-2026-11-20.json.
  Unexplained changes: 0.`;

const short = ["Every expected input", "Code and configuration", "No network requests", "Every difference explained"];
const breaks = [
  { id: "none", label: "Change nothing", line: "Unexplained changes: 0.", fails: -1, why: "Every criterion has its evidence, so the run passes." },
  { id: "missing", label: "A required sensor export is missing", line: "Expected input missing: inputs/sensor-17/2026-11-20.csv (required)", fails: 0, why: "The manifest expects it, and a missing required export fails the run." },
  { id: "dirty", label: "The checkout has uncommitted edits", line: "Source checkout: 1 uncommitted change", fails: 1, why: "The code that ran no longer matches the recorded commit." },
  { id: "attempt", label: "The audit shows one blocked attempt", line: "evidence/network-audit.json covers the full run: 1 attempt, blocked.", fails: 2, why: "The restriction worked, but the zero-attempt criterion did not." },
  { id: "cell", label: "A second cell changed with no correction record", line: "Changed cells: 2. Unexplained changes: 1.", fails: 3, why: "An unexplained change means the rebuild failed acceptance." },
];

const checks = [
  ["Same path, new hash", "If two rebuilds read a file with the same path but different SHA-256 hashes, what can you conclude about their inputs, and what would you check next?"],
  ["One blocked attempt", "If the sandbox blocked one outbound connection attempt, did the run satisfy the zero-attempt criterion? Which evidence would you use to decide?"],
  ["“The input file was updated”", "If a daily average changes and the report says only “the input file was updated,” what evidence would you require before accepting the rebuild?"],
];
---

<PrimerChat
  prompt={card.prompt}
  module="Module 2"
  back={`../02-archive/#${aiCardId("rewind")}`}
  about="This is a reply an AI assistant gave to Module 2's rebuild-criteria study prompt, lightly edited. Send the same prompt yourself and you will get a different reply."
  turn="In a live chat, you would answer those three questions and the assistant would review your reasoning. To try that, copy the prompt into your own AI assistant. Then go back to Part 7 and write one acceptance criterion, as specific as Riley's, for a rebuild in your own work."
>
  <h2 class="pr-title">Acceptance criteria for a reproducible rebuild</h2>
  <p class="pr-pull">Write each acceptance criterion as a pass/fail check.</p>
  <p>Name what the rebuild report must show, what evidence you can inspect, and what would make the rebuild fail acceptance.</p>

  <h2>1. Acceptance criteria for daily sensor readings</h2>
  <ol class="pa-criteria">{criteria.map(([head, body]) => <li><b>{head}</b> {body}</li>)}</ol>
  <figure class="pr-card">
    <p class="pr-label">Criterion 3: three network audits, judged</p>
    <ul class="pa-audit">{audits.map(([what, v, tone, why]) => <li><code>{what}</code><span class:list={["pr-chip", tone]}>{v}</span><small>{why}</small></li>)}</ul>
  </figure>

  <h2>2. Example rebuild report</h2>
  <p>This example uses illustrative hashes and artifact names.</p>
  <div class="pr-code"><p class="pr-label">Rebuild report</p><pre>{report}</pre></div>
  <figure class="pr-card pa-break">
    <fieldset class="pr-seg">
      <legend>Break one line of the report</legend>
      {breaks.map((b, i) => <label><input type="radio" name="pa-crit-break" value={b.id} checked={i === 0} /><span>{b.label}</span></label>)}
    </fieldset>
    {breaks.map((b) => (
      <div class="pa-break-view" data-break={b.id}>
        <p class="pa-break-line"><span>Report line</span><code>{b.line}</code></p>
        <ul class="pa-audit">{short.map((c, i) => <li><span>{c}</span><span class:list={["pr-chip", i === b.fails ? "is-bad" : "is-ok"]}>{i === b.fails ? "Fail" : "Pass"}</span></li>)}</ul>
        <p class="pa-break-result"><b>Result: {b.fails < 0 ? "PASS" : "FAIL"}</b> {b.why}</p>
      </div>
    ))}
  </figure>
  <figure class="pr-card">
    <p class="pr-label">The one changed cell, checked</p>
    <div class="pa-cell">
      <div><p class="pa-cell-head">Baseline</p><p>{baseline.map(f1).join(" · ")}</p><p class="pa-cell-mean">mean {mean(baseline)}</p></div>
      <div class="is-new"><p class="pa-cell-head">Rebuild</p><p>{f1(rebuilt[0])} · <mark>{f1(rebuilt[1])}</mark></p><p class="pa-cell-mean">mean {mean(rebuilt)}</p></div>
    </div>
    <figcaption>One input value changed, and a correction record says why. The same averaging rule turns it into exactly the change the diff reports, so nothing is left unexplained.</figcaption>
  </figure>
  <figure class="pr-card">
    <p class="pr-label">The same four criteria on a code-only fix</p>
    <ul class="pa-audit">
      <li><span>Saved inputs: every content hash matches the archived manifest</span><span class="pr-chip is-ok">Pass</span></li>
      <li><span>Code: new commit, new parser fingerprint</span><span class="pr-chip is-ok">Pass</span></li>
      <li><span>Network: zero attempts, full coverage</span><span class="pr-chip is-ok">Pass</span></li>
      <li><span>Comparison: one changed cell, traced to the code change</span><span class="pr-chip is-ok">Pass</span></li>
    </ul>
    <figcaption>When the inputs are held fixed, the only line allowed to change is the code, so every changed cell must trace to it.</figcaption>
  </figure>
  <aside class="pr-course" aria-label="Course note">
    <p class="pr-label">Course note</p>
    <p>Riley's criteria in Part 7 are the reply's four: saved inputs by content hash with Dunmore listed as unavailable, the fixed parser's fingerprint, zero network requests, and a diff that explains every changed cell. Kick's report adds the build revision beside the fingerprint, the reply's Git commit. The reply's fingerprint covers config alone; Touchline's covers the parser code too.</p>
    <p>The reply's changed cell comes from a corrected input. Kick's replay holds Friday's pages fixed, so its one changed cell must trace to the code. And Kick's network counter hooks only Python's lookup and connect calls in its own process, after showing it catches a test request, so its zero says nothing about child processes or calls outside those hooks.</p>
  </aside>

  <h2>3. Check your understanding</h2>
  <ol class="pr-checks">{checks.map(([name, q]) => <li><b>{name}</b><span>{q}</span></li>)}</ol>
</PrimerChat>

<style>
  .pa-criteria { display: grid; gap: 0.5rem; margin: 0 0 1rem; padding-left: 1.4rem; }
  .pa-criteria li { padding-left: 0.2rem; }
  .pa-criteria b { color: var(--sl-color-white); }
  .pa-audit { display: grid; gap: 0.35rem; margin: 0; padding: 0; list-style: none; font-size: 0.9rem; }
  .pa-audit li { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.3rem 0.6rem; padding: 0.4rem 0.65rem; border-radius: 6px; background: var(--tl-bg); }
  .pa-audit small { flex-basis: 100%; color: var(--tl-muted); font-size: 0.82rem; }
  .pa-break .pr-seg { margin-bottom: 0.7rem; }
  .pa-break-view { display: none; }
  .pa-break:has([value="none"]:checked) [data-break="none"],
  .pa-break:has([value="missing"]:checked) [data-break="missing"],
  .pa-break:has([value="dirty"]:checked) [data-break="dirty"],
  .pa-break:has([value="attempt"]:checked) [data-break="attempt"],
  .pa-break:has([value="cell"]:checked) [data-break="cell"] { display: block; }
  :global(.pr) .pa-break-line { display: grid; gap: 0.2rem; margin: 0 0 0.6rem; font-size: 0.85rem; }
  .pa-break-line span { color: var(--tl-muted); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  :global(.pr) .pa-break-result { margin: 0.6rem 0 0; font-size: 0.9rem; }
  .pa-break-result b { color: var(--sl-color-white); }
  .pa-cell { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .pa-cell > div { padding: 0.55rem 0.75rem; border: 1px solid var(--tl-line); border-radius: 8px; background: var(--tl-bg); font-family: var(--sl-font-mono); font-size: 0.9rem; }
  .pa-cell > div.is-new { border-color: var(--pr-green); }
  :global(.pr) .pa-cell p { margin: 0 0 0.2rem; }
  :global(.pr) .pa-cell-head { color: var(--tl-muted); font-family: var(--sl-font); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  :global(.pr) .pa-cell-mean { margin: 0; color: var(--sl-color-white); font-size: 1.15rem; }
  .pa-cell mark { padding: 0 0.2rem; border-radius: 3px; background: color-mix(in srgb, #d9822b 30%, transparent); color: inherit; }
</style>
