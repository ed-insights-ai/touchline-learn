  const root = document.querySelector<HTMLElement>("[data-primer]");
  if (root) {
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    setTimeout(() => { root.classList.remove("is-sending"); root.classList.add("is-sent"); }, calm ? 0 : 1400);
    const button = root.querySelector<HTMLButtonElement>("[data-primer-copy]");
    button?.addEventListener("click", async () => {
      const text = root.querySelector<HTMLElement>("[data-copy-text]")?.textContent ?? "";
