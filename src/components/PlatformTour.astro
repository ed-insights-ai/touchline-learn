---
import { readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";

const FIXTURE = "tally:alder-ridge:8203";
const sample = (...parts: string[]) => join(process.cwd(), "sample", ...parts);
const json = (...parts: string[]) => JSON.parse(readFileSync(sample(...parts), "utf-8"));

const fixture = json("data", "fixtures", "2026-men-plc.json").fixtures.find((f: { id: string }) => f.id === FIXTURE);
const box = json("data", "matches", "2026-men-plc.json").matches[FIXTURE];
const rawName = "2026-men-box-tally-alder-ridge-8203.html";
const html = readFileSync(sample("raw_html", "alder-ridge", rawName), "utf-8");
const lines = html.split("\n");
const titleLine = lines.find((l) => l.includes("<title>"))!.trim().replaceAll("&#x27;", "'");
const tableStart = lines.findIndex((l) => l.includes("Score by Period"));
const tableEnd = lines.findIndex((l, i) => i > tableStart && l.includes("</table>"));
const scoreRows = lines.slice(tableStart + 1, tableEnd).map((l) => l.trim());
const rawSnippet = [titleLine, ...scoreRows].join("\n");
const teamRows = scoreRows.length - 1;
const scheduleLinks = readdirSync(sample("raw_html", "alder-ridge"))
  .filter((f) => f.startsWith("2026-men-") && f.endsWith(".html") && !f.includes("-box-"))
  .some((f) => readFileSync(sample("raw_html", "alder-ridge", f), "utf-8").includes("boxscore/8203"));
if (!scheduleLinks) throw new Error("the tour's schedule no longer links to this match");
const [home, away] = box.teams as { name: string; abbr: string; score: number; periods: number[] }[];
const total = (periods: number[]) => periods.reduce((a, b) => a + b, 0);
if (teamRows !== 2 || !titleLine.includes("9/8/2026")) throw new Error("the tour's proof example no longer holds");
if (total(home.periods) !== home.score || total(away.periods) !== away.score) throw new Error("the tour's period totals no longer add up");
if (home.score !== fixture.home_score || away.score !== fixture.away_score) throw new Error("the tour's fixture and box score disagree");

const parsed = `home: ${home.name}, ${home.score} (periods ${home.periods.join(", ")})
away: ${away.name}, ${away.score} (periods ${away.periods.join(", ")})
date: ${fixture.date}`;

const stops = [
  { name: "Fetch", zone: "raw", title: "Ask for the page", body: "The collector follows a link that the school's schedule page published. It never builds a URL by guessing.", artifact: box.source_url, risk: "Without it: guessed URLs quietly return the wrong page." },
  { name: "Archive", zone: "raw", title: "Save it untouched", body: "The page is stored byte for byte before any code reads it.", artifact: rawSnippet, risk: "Without it: a parser bug means collecting everything again, if the page still exists." },
  { name: "Prove", zone: "clean", title: "Make the page prove itself", body: "The school's own schedule must list this match and link to this page. Then the page itself must name the match date and show exactly two teams.", artifact: `schedule lists this match and links here: yes\ntitle names 9/8/2026: yes\nteams in the score table: ${teamRows}\nresult: accepted`, risk: "Without it: a page from the wrong season parses perfectly." },
  { name: "Parse", zone: "clean", title: "Turn the page into a record", body: "Code reads the tables into typed fields. Pages are written for fans, so the parser expects layouts to vary.", artifact: parsed, risk: "Without it: the numbers stay trapped in page layout." },
  { name: "Resolve", zone: "clean", title: "Give each team one identity", body: "Published names become stable ids, so every later join means the same school.", artifact: `${home.name} → ${fixture.home}\n${away.name} → ${fixture.away}`, risk: "Without it: one school splits into several, or two schools become one." },
  { name: "Check", zone: "clean", title: "Let a gate stop the line", body: "Automatic checks compare the record against its contract, the written rules for its shape, and against itself.", artifact: `${home.name}: ${home.periods.join(" + ")} = ${home.score}\n${away.name}: ${away.periods.join(" + ")} = ${away.score}\nschedule and match page agree: yes`, risk: "Without it: a bad record reaches everything built on it." },
  { name: "Build", zone: "derived", title: "Publish from the clean files", body: "The website, the analytical database and the written season summaries, called journals, all read the same record.", artifact: `${home.name} ${home.score}, ${away.name} ${away.score}\nwebsite · database · journal`, risk: "Without it: each product tells its own version of the result." },
];

const hook = [
  { label: "Whether it downloaded everything", why: "A fair worry, and it is where this course starts. “No errors” says nothing about pages that never arrived, and a page that did arrive can still be the wrong one." },
  { label: "Whether the numbers are right", why: "That is the hard part. Nothing in “no errors” tells you the scores belong to the right teams and seasons." },
  { label: "Whether it will run fast enough", why: "Speed is fixable later. A fast pipeline can publish wrong numbers just as confidently." },
];

const cases = [
  {
    failure: "The wrong season, delivered successfully",
    evidence: "asked for:  /sports/mens-soccer/schedule/2019\nstatus:     200 OK\npage title: 2026 Men's Soccer Schedule",
    ask: "Which is the earliest step that could notice?",
    options: [
      { label: "Fetch", sees: "The address and the status code", why: "Fetch sees 200 OK at the address it requested. Both look perfect, because the mismatch is inside the page." },
      { label: "Archive", sees: "Bytes to store, unread", why: "Archive should save this page exactly as it came. It does not read it, and that is deliberate." },
      { label: "Prove", sees: "The page's content against what you asked for", why: "Right. The title says 2026 and you asked for 2019. No proof, no data, and the gap gets recorded.", correct: true },
      { label: "Check", sees: "Finished records against written rules", why: "Too late to rely on. By now these are well-formed matches filed under 2019, and every rule about their shape passes." },
    ],
  },
  {
    failure: "Your own parser swapped a season of scores",
    evidence: "your record:  Alder Ridge 0, Hartwell Tech 1\nactual match: Alder Ridge 1, Hartwell Tech 0\nthe school's page has since been redesigned",
    ask: "You have fixed the parser. What lets you get the right scores back?",
    options: [
      { label: "Fetch again", sees: "Whatever the site serves today", why: "The site has changed. You might get a different layout, or no page at all for an old match." },
      { label: "Archive", sees: "The exact page from the day you collected it", why: "Right. The saved page still shows 1-0, so the fixed parser can replay it.", correct: true },
      { label: "Check", sees: "Finished records against written rules", why: "A check might tell you something is wrong. It has no original to restore from." },
      { label: "Build", sees: "Only the clean files", why: "Build would faithfully republish the swapped scores." },
    ],
  },
  {
    failure: "Two schools become one",
    evidence: "name on page:  Lambert St.  (Lambert State)\nname in list:  St. Lambert\nname matcher:  87% similar, merged",
    ask: "Which step made this mistake, and should have refused?",
    options: [
      { label: "Parse", sees: "The text on the page", why: "Parse read “Lambert St.” correctly. Deciding who that is comes later." },
      { label: "Resolve", sees: "Names and the list of known schools", why: "Right. This is where a name becomes an identity, and looking similar is not evidence. Module 5 is built around this failure.", correct: true },
      { label: "Check", sees: "Finished records against written rules", why: "A check may catch a symptom later, such as a team playing itself. The decision that caused it was made one step earlier." },
      { label: "Build", sees: "Only the clean files", why: "By Build the two schools are already one id, so the totals simply look like one busy team." },
    ],
  },
  {
    failure: "Two calculations disagree",
    evidence: "same match, two independent pipelines\npipeline A:  Harbor Point 2, Dunmore 1\npipeline B:  Harbor Point 2, Dunmore 2",
    ask: "Which step should stop this from reaching readers?",
    options: [
      { label: "Parse", sees: "One page at a time", why: "One of the parsers may be the cause, but neither can see the other's answer." },
      { label: "Resolve", sees: "Names and the list of known schools", why: "Both pipelines agree on who played. The disagreement is about the score." },
      { label: "Check", sees: "Finished records, including both answers", why: "Right. A parity gate compares the two results and holds the release until someone explains the difference.", correct: true },
      { label: "Build", sees: "Only the clean files", why: "If Build runs first, your readers find the disagreement before you do." },
    ],
  },
];

const zones = [
  { key: "raw", name: "Raw", holds: "Every page, byte for byte", also: "Also called bronze", lost: "Gone. Nothing can recreate these pages." },
  { key: "clean", name: "Clean", holds: "Season files in a fixed shape", also: "Also called silver", lost: "Rebuilt from raw." },
  { key: "derived", name: "Derived", holds: "Website, database, journals", also: "Also called gold", lost: "Rebuilt from clean." },
];

const ideas = [
  ["Archive first, parse later", "The saved pages are the evidence of what each site served. The clean files are a calculation from them."],
  ["Prove before you read", "A page has to show it is what was asked for. No proof means no data, and a named gap."],
  ["Absence is data", "The pipeline records what it did not find and why. Unknown never becomes zero."],
  ["Code computes, the model writes", "Code computes every number. AI may only repeat one that can be traced, and anything else is dropped."],
];
---

<script is:inline>document.documentElement.classList.add("pt-js");</script>

<div class="pt not-content" data-tour>
  <noscript><p class="pt-note">This tour is interactive. Turn on JavaScript to make each decision and see its feedback.</p></noscript>

  <header class="pt-hero">
    <h2>Before you publish, look inside</h2>
    <p>Go back to 4:52, before Riley's tap, and take the chair yourself. This is what Kick just sent you.</p>
    <div class="pt-ai">
      <p class="pt-who">Kick <span>scripted example</span></p>
      <p>Done. All eight school sites, 46 conference matches, no errors. Ready to publish.</p>
    </div>
    <p>You did not watch it work. Every number in that table began on a page a school wrote for fans rather than programs, and it had to get through seven steps to reach you.</p>
    <div class="pt-group" data-choice data-neutral data-unlocks="tour">
      <p class="pt-q">What worries you most?</p>
      {hook.map((o) => <button type="button" data-why={o.why} data-correct>{o.label}</button>)}
      <p class="pt-feedback" role="status"></p>
    </div>
  </header>

  <section class="pt-part" data-unlock="tour">
    <h2 tabindex="-1">Follow one match through the platform</h2>
    <p>{away.name} at {home.name}, September 8, is one of the results in your table. Like everything in this course's sample, the game is invented. Step through what has to happen to it.</p>
    <ol class="pt-rail" aria-label="Seven pipeline steps">
      {stops.map((s, i) => <li><button type="button" class={`pt-stop ${s.zone}`} data-stop={i} aria-current={i === 0 ? "step" : undefined}><b>{i + 1}</b>{s.name}</button></li>)}
    </ol>
    <div class="pt-panels" aria-live="polite">
      {stops.map((s, i) => (
        <article class={`pt-panel ${s.zone}`} data-panel={i} hidden={i !== 0}>
          <p class="pt-zone">{s.zone === "derived" ? "Derived zone" : s.zone === "raw" ? "Raw zone" : "Clean zone"}</p>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
          <pre><code>{s.artifact}</code></pre>
          <p class="pt-risk">{s.risk}</p>
        </article>
      ))}
    </div>
    <div class="pt-nav">
      <button type="button" class="pt-back" data-back disabled>Back</button>
      <button type="button" class="pt-next" data-forward>Next step</button>
    </div>
  </section>

  <section class="pt-part" data-unlock="cases">
    <h2 tabindex="-1">Where would you catch it?</h2>
    <p>Four things go wrong while building your table. Read the evidence, then ask of each step: <em>could it actually see this?</em></p>
    {cases.map((c, i) => (
      <div class="pt-case pt-group" role="group" aria-labelledby={`pt-case-${i}`} data-choice data-case={i} data-unlock={i > 0 ? `case-${i}` : undefined} data-unlocks={i < cases.length - 1 ? `case-${i + 1}` : "zones"}>
        <h3 id={`pt-case-${i}`}>{c.failure}</h3>
        <pre class="pt-evidence" tabindex="0"><code>{c.evidence}</code></pre>
        <p class="pt-q">{c.ask}</p>
        <div class="pt-options pt-sees">
          {c.options.map((o) => <button type="button" data-why={o.why} data-correct={o.correct ? "" : undefined}><strong>{o.label}</strong><span>Can see: {o.sees}</span></button>)}
        </div>
        <p class="pt-feedback" role="status"></p>
      </div>
    ))}
    <button type="button" class="pt-next" data-to-zones hidden>Continue</button>
  </section>

  <section class="pt-part" data-unlock="zones">
    <h2 tabindex="-1">What can you afford to lose?</h2>
    <p>Each zone is computed from the one before it, using versioned code and reference lists. Delete a zone and any rebuild happens right away. Try different orders.</p>
    <div class="pt-zones">
      {zones.map((z) => (
        <button type="button" class={`pt-zone-card ${z.key}`} data-zone={z.key} data-lost={z.lost}>
          <strong>{z.name}</strong>
          <span>{z.holds}</span>
          <small>{z.also}</small>
          <i class="pt-del">Delete</i>
          <em data-zone-result></em>
        </button>
      ))}
    </div>
    <p class="pt-feedback" role="status" data-zone-feedback></p>
    <p class="pt-summary" data-zone-summary hidden>As long as raw survives, everything after it can be rebuilt with versioned code and reference lists. That is what makes a bug recoverable.</p>
    <div class="pt-nav">
      <button type="button" class="pt-back" data-zone-reset hidden>Restore and try another order</button>
      <button type="button" class="pt-next" data-to-close hidden>See the four ideas</button>
    </div>
  </section>

  <a class="pt-skip" data-skip href="../../modules/01-collection/">Skip the tour and start Module 1</a>

  <section class="pt-part pt-close" data-unlock="close">
    <h2 tabindex="-1">Four ideas you will build across the course</h2>
    <dl>
      {ideas.map(([term, text]) => <div><dt>{term}</dt><dd>{text}</dd></div>)}
    </dl>
    <p>The real Touchline runs these steps across about a thousand school sites. Your eight-school table needs them just as much, and you do not yet know which ones the agent skipped.</p>
    <p><strong>Start at the source. Did the agent collect everything it said it did?</strong></p>
    <a class="pt-link" href="../../modules/01-collection/">Start Module 1</a>
  </section>
</div>

<style is:global>
  .pt { --pt-yellow: #f4c62f; --pt-red: #f06553; --pt-focus: #f4c62f; color: var(--tl-ink); font-size: 1rem; line-height: 1.55; }
  :root[data-theme="light"] .pt { --pt-red: #c5301c; --pt-focus: #0f4a33; }
  .pt p { margin: 0 0 0.75rem; max-width: 42rem; }
  .pt h2 { margin: 0 0 0.75rem; color: var(--sl-color-white); font-size: clamp(1.45rem, 4.5vw, 2rem); line-height: 1.15; font-weight: 750; letter-spacing: -0.015em; text-wrap: balance; scroll-margin-top: 5rem; outline: none; }
  .pt h3 { margin: 0 0 0.3rem; color: var(--sl-color-white); font-size: 1.2rem; line-height: 1.25; font-weight: 700; }
  .pt-note { padding: 0.75rem 1rem; border-left: 3px solid var(--pt-yellow); }
  .pt-ai { margin: 0 0 1rem; padding: 0.85rem 1rem; border-left: 3px solid var(--sl-color-accent); background: var(--tl-card); }
  .pt-ai p:last-child { margin-bottom: 0; }
  .pt-who { margin-bottom: 0.2rem !important; font-size: 0.85rem; font-weight: 700; }
  .pt-who span { margin-left: 0.4rem; color: var(--tl-muted); font-weight: 400; }
  .pt-part { margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--tl-line); }
  .pt-js .pt [data-unlock]:not(.is-open) { display: none; }
  .pt-group { display: grid; gap: 0.5rem; margin: 0.75rem 0; }
  .pt-q { margin: 0.25rem 0 0.1rem !important; font-weight: 700; }
  .pt button { font: inherit; }
  .pt-group button, .pt-zone-card { min-height: 44px; padding: 0.55rem 0.85rem; border: 1px solid var(--tl-muted); border-radius: 3px; background: var(--tl-card); color: var(--tl-ink); text-align: left; cursor: pointer; }
  .pt-group button:hover:not(:disabled):not(.is-wrong), .pt-zone-card:hover:not(:disabled) { border-color: var(--sl-color-accent); }
  .pt-group button.is-right { border-color: var(--sl-color-accent); box-shadow: inset 4px 0 0 var(--sl-color-accent); font-weight: 650; }
  .pt-group button.is-wrong { border-color: var(--pt-red); box-shadow: inset 4px 0 0 var(--pt-red); }
  .pt-group button.is-chosen { border-color: var(--pt-yellow); box-shadow: inset 4px 0 0 var(--pt-yellow); font-weight: 650; }
  .pt-group button:disabled:not(.is-right):not(.is-chosen) { opacity: 0.6; cursor: default; }
  .pt button:focus-visible, .pt a:focus-visible { outline: 3px solid var(--pt-focus); outline-offset: 2px; }
  .pt-feedback { margin: 0.2rem 0 0 !important; padding-left: 0.75rem; border-left: 3px solid var(--pt-red); scroll-margin-top: 5rem; }
  .pt-feedback:empty { margin: 0 !important; padding: 0; border: 0; }
  .pt-feedback.good { border-left-color: var(--sl-color-accent); }
  .pt-feedback.neutral { border-left-color: var(--pt-yellow); }

  .pt-rail { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 3px; margin: 0.75rem 0 0; padding: 0; list-style: none; }
  .pt-rail li { margin: 0; }
  .pt-stop { display: grid; justify-items: center; gap: 0.1rem; width: 100%; min-height: 58px; padding: 0.35rem 0.1rem; border: 1px solid var(--tl-line); border-bottom-width: 3px; background: var(--tl-card); color: var(--tl-muted); font-size: 0.78rem !important; line-height: 1.1; cursor: pointer; }
  .pt-stop b { font-size: 0.95rem; color: var(--tl-ink); }
  .pt-stop.raw { border-bottom-color: var(--tl-raw-edge); }
  .pt-stop.clean { border-bottom-color: var(--tl-clean-edge); }
  .pt-stop.derived { border-bottom-color: var(--tl-derived-edge); }
  .pt-stop.is-seen { color: var(--tl-ink); }
  .pt-stop[aria-current] { color: var(--tl-ink); font-weight: 700; background: var(--tl-bg); border-color: var(--sl-color-accent); border-bottom-color: var(--sl-color-accent); }
  .pt-panel { padding: 0.9rem 1rem; border: 1px solid var(--tl-line); border-top: 0; }
  .pt-panel[hidden] { display: none; }
  .pt-panel.raw { background: var(--tl-raw); }
  .pt-panel.clean { background: var(--tl-clean); }
  .pt-panel.derived { background: var(--tl-derived); }
  .pt-zone { margin-bottom: 0.15rem !important; color: var(--tl-muted); font-size: 0.85rem; font-weight: 600; }
  .pt pre { margin: 0.25rem 0 0.7rem; padding: 0.7rem 0.8rem; overflow-x: auto; background: var(--tl-bg); border: 1px solid var(--tl-line); font-size: 0.78rem; line-height: 1.55; }
  .pt pre code { padding: 0; background: none; font-size: inherit; overflow-wrap: anywhere; white-space: pre-wrap; }
  [data-zone-feedback] + .pt-next { margin-top: 0.75rem; }
  .pt-risk { margin-bottom: 0 !important; font-weight: 600; }
  .pt-nav { display: flex; justify-content: space-between; gap: 0.5rem; margin-top: 0.75rem; }
  .pt-next, .pt-back, .pt-link { display: inline-flex; align-items: center; min-height: 44px; padding: 0.55rem 1.05rem; border-radius: 3px; font-weight: 700; cursor: pointer; text-decoration: none; }
  .pt-next, .pt-link { border: 0; background: var(--sl-color-accent); color: var(--sl-color-black); }
  :root[data-theme="light"] .pt-next, :root[data-theme="light"] .pt-link { color: #fff; }
  .pt-next[hidden], .pt-summary[hidden] { display: none; }
  .pt-back[hidden] { display: none; }
  .pt-evidence { margin: 0 0 0.7rem; padding: 0.7rem 0.85rem; overflow-x: auto; border: 1px solid var(--tl-line); background: var(--tl-card); font-size: 0.82rem; }
  .pt-evidence code { padding: 0; background: none; }
  .pt .pt-sees { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0.4rem; }
  .pt .pt-sees button { display: grid; gap: 0.1rem; text-align: left; }
  .pt-sees strong { font-weight: 700; }
  .pt-sees span { color: var(--tl-muted); font-size: 0.85rem; font-weight: 400; line-height: 1.3; }
  .pt-skip { display: inline-flex; align-items: center; min-height: 44px; margin-top: 1.25rem; color: var(--tl-muted); font-size: 0.9rem; }
  .pt-skip[hidden] { display: none; }
  .pt-del { color: var(--tl-muted); font-size: 0.8rem; font-style: normal; text-decoration: underline; }
  .pt-zone-card:disabled .pt-del { display: none; }
  .pt-summary { margin-top: 0.75rem !important; font-weight: 650; }
  .pt-back { border: 1px solid var(--tl-muted); background: none; color: var(--tl-ink); }
  .pt-back:disabled { opacity: 0.45; cursor: default; }

  .pt-case { padding: 0.8rem; background: var(--tl-card); border: 1px solid var(--tl-line); }
  .pt-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.35rem; }
  .pt-options button { padding: 0.45rem 0.25rem; background: var(--tl-bg); text-align: center; }

  .pt-zones { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.4rem; margin: 0.75rem 0; }
  .pt-zone-card:disabled { cursor: default; color: var(--tl-ink); }
  .pt-zone-card { display: grid; align-content: start; gap: 0.2rem; }
  .pt-zone-card.raw { background: var(--tl-raw); }
  .pt-zone-card.clean { background: var(--tl-clean); }
  .pt-zone-card.derived { background: var(--tl-derived); }
  .pt-zone-card span { font-size: 0.88rem; line-height: 1.3; }
  .pt-zone-card small { color: var(--tl-muted); font-size: 0.78rem; }
  .pt-zone-card em { font-style: normal; font-weight: 700; font-size: 0.88rem; line-height: 1.3; }
  .pt-zone-card em:empty { display: none; }
  .pt-zone-card.is-lost { border-color: var(--pt-red); box-shadow: inset 0 3px 0 var(--pt-red); }
  .pt-zone-card.is-rebuilt { border-color: var(--sl-color-accent); box-shadow: inset 0 3px 0 var(--sl-color-accent); }

  .pt-close { padding: 1.1rem; border: 0; border-radius: 4px; color: #f4faf5; background: #0f4a33; }
  .pt-close h2 { color: #f4faf5; }
  .pt-close dl { display: grid; gap: 0.55rem; margin: 0 0 1rem; }
  .pt-close dt { font-weight: 700; }
  .pt-close dd { margin: 0; color: #d5e6db; }
  .pt-close .pt-link { background: #f4c62f; color: #1b1a0c !important; }
  .pt-close a:focus-visible { outline-color: #f4c62f; }

  @media (max-width: 30rem) {
    .pt-rail { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .pt-panel { margin-top: 3px; border-top: 1px solid var(--tl-line); }
    .pt-zones { grid-template-columns: 1fr; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-tour]");

  if (root) {
    const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const behavior: ScrollBehavior = calm ? "auto" : "smooth";
    const open = (key: string) => {
      const target = root.querySelector<HTMLElement>(`[data-unlock="${key}"]`)!;
      target.classList.add("is-open");
      return target;
    };
    const present = (section: HTMLElement, fromKeyboard: boolean) => {
      const heading = section.querySelector<HTMLElement>("h2");
      heading?.focus({ preventScroll: true });
      if (!fromKeyboard || heading) (heading ?? section).scrollIntoView({ behavior, block: "start" });
    };

    root.querySelectorAll<HTMLElement>("[data-choice]").forEach((group) => {
      const feedback = group.querySelector<HTMLElement>(".pt-feedback")!;
      const buttons = [...group.querySelectorAll<HTMLButtonElement>("button[data-why]")];
      const neutral = "neutral" in group.dataset;
      buttons.forEach((button) => button.addEventListener("click", (event) => {
        const right = "correct" in button.dataset;
        feedback.textContent = button.dataset.why!;
        feedback.classList.toggle("good", right && !neutral);
        feedback.classList.toggle("neutral", neutral);
        button.classList.add(neutral ? "is-chosen" : right ? "is-right" : "is-wrong");
        if (!right) {
          feedback.scrollIntoView({ behavior, block: "nearest" });
          return;
        }
        buttons.forEach((b) => (b.disabled = true));
        const fromKeyboard = event.detail === 0;
        const key = group.dataset.unlocks!;
        if (key === "zones") {
          const proceed = root.querySelector<HTMLButtonElement>("[data-to-zones]")!;
          proceed.hidden = false;
          proceed.scrollIntoView({ behavior, block: "nearest" });
          proceed.focus({ preventScroll: !fromKeyboard });
          return;
        }
        const target = open(key);
        if (key.startsWith("case-")) {
          target.querySelector("button")!.focus({ preventScroll: !fromKeyboard });
          target.scrollIntoView({ behavior, block: "nearest" });
        } else if (key === "tour") {
          feedback.scrollIntoView({ behavior, block: "start" });
          target.querySelector<HTMLElement>("h2")!.focus({ preventScroll: true });
        } else {
          present(target, fromKeyboard);
        }
      }));
    });

    const stops = [...root.querySelectorAll<HTMLButtonElement>("[data-stop]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    const back = root.querySelector<HTMLButtonElement>("[data-back]")!;
    const forward = root.querySelector<HTMLButtonElement>("[data-forward]")!;
    let current = 0;
    const show = (index: number) => {
      current = index;
      stops.forEach((stop, i) => {
        stop.toggleAttribute("aria-current", false);
        if (i === index) stop.setAttribute("aria-current", "step");
        if (i === index) stop.classList.add("is-seen");
      });
      panels.forEach((panel, i) => (panel.hidden = i !== index));
      back.disabled = index === 0;
      forward.textContent = index === stops.length - 1 ? "Now break it" : "Next step";
    };
    stops.forEach((stop, i) => stop.addEventListener("click", () => show(i)));
    back.addEventListener("click", () => show(current - 1));
    forward.addEventListener("click", (event) => {
      if (current < stops.length - 1) {
        show(current + 1);
        root.querySelector(".pt-rail")!.scrollIntoView({ behavior, block: "nearest" });
        return;
      }
      present(open("cases"), event.detail === 0);
    });
    show(0);

    root.querySelector<HTMLButtonElement>("[data-to-zones]")!.addEventListener("click", (event) => {
      (event.currentTarget as HTMLButtonElement).hidden = true;
      present(open("zones"), event.detail === 0);
    });

    const cards = [...root.querySelectorAll<HTMLButtonElement>("[data-zone]")];
    const zoneFeedback = root.querySelector<HTMLElement>("[data-zone-feedback]")!;
    const summary = root.querySelector<HTMLElement>("[data-zone-summary]")!;
    const toClose = root.querySelector<HTMLButtonElement>("[data-to-close]")!;
    const reset = root.querySelector<HTMLButtonElement>("[data-zone-reset]")!;
    const lost = new Set<string>();
    const tried = new Set<string>();
    const outcome = (zone: string) => {
      if (zone === "raw") return { gone: true, text: "Gone. Nothing can recreate these pages." };
      if (zone === "clean") return lost.has("raw")
        ? { gone: true, text: "Gone. Raw is gone, so there is nothing to rebuild from." }
        : { gone: false, text: "Rebuilt from raw." };
      return lost.has("clean")
        ? { gone: true, text: "Gone. Clean is gone, so there is nothing to rebuild from." }
        : { gone: false, text: "Rebuilt from clean." };
    };
    cards.forEach((card) => card.addEventListener("click", (event) => {
      const zone = card.dataset.zone!;
      const name = card.querySelector("strong")!.textContent;
      const result = outcome(zone);
      if (result.gone) lost.add(zone);
      tried.add(zone);
      if (result.gone) reset.hidden = false;
      card.disabled = true;
      card.querySelector("[data-zone-result]")!.textContent = result.text;
      card.classList.toggle("is-lost", result.gone);
      card.classList.toggle("is-rebuilt", !result.gone);
      const more = tried.size < cards.length ? " Now delete another." : "";
      zoneFeedback.classList.toggle("good", !result.gone);
      zoneFeedback.textContent = zone === "raw"
        ? `Raw is the one zone you cannot get back, which is why nothing is allowed to change it.${more}`
        : result.gone
          ? `${name} depended on a zone you already lost.${more}`
          : `${name} is safe to delete while the zone before it survives.${more}`;
      if (tried.size === cards.length) {
        summary.hidden = false;
        toClose.hidden = false;
        toClose.focus({ preventScroll: event.detail !== 0 });
      }
      (tried.size === cards.length ? toClose : zoneFeedback).scrollIntoView({ behavior, block: "nearest" });
    }));
    reset.addEventListener("click", () => {
      lost.clear();
      tried.clear();
      cards.forEach((card) => {
        card.disabled = false;
        card.classList.remove("is-lost", "is-rebuilt");
        card.querySelector("[data-zone-result]")!.textContent = "";
      });
      reset.hidden = true;
      zoneFeedback.textContent = "All three zones are back. Try deleting Derived or Clean first.";
      zoneFeedback.classList.remove("good");
      cards[cards.length - 1].focus({ preventScroll: true });
    });
    toClose.addEventListener("click", (event) => {
      toClose.hidden = true;
      reset.hidden = true;
      root.querySelector<HTMLElement>("[data-skip]")!.hidden = true;
      present(open("close"), event.detail === 0);
    });
  }
</script>
