        <div class="cv-row">
          <label>Host <select data-save="q-host"><option value="">Choose</option>{unseen.schools.map((s) => <option value={s.slug}>{s.name}</option>)}</select></label>
          <label>Visitor <select data-save="q-visitor"><option value="">Choose</option>{unseen.schools.map((s) => <option value={s.slug}>{s.name}</option>)}</select></label>
        </div>
        <p class="cv-fb" role="status"></p>
      </div>
