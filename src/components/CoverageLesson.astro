  .cv pre { margin: 0 0 1rem; padding: 0.8rem; overflow-x: auto; border: 1px solid var(--tl-line); background: var(--tl-card); font-size: 0.82rem; line-height: 1.5; }
  .cv pre code { padding: 0; background: none; }
  .cv-chat { display: grid; gap: 0.5rem; margin: 0 0 1rem; }
  .cv-chat p { margin: 0; padding: 0.7rem 0.9rem; background: var(--tl-card); }
  .cv-chat b { display: block; font-size: 0.85rem; }
  .cv-riley { margin-right: 2rem !important; border-left: 3px solid var(--cv-yellow); }
  .cv-kick { margin-left: 2rem !important; border-left: 3px solid var(--sl-color-accent); }
  .cv-mark { display: grid; gap: 0.6rem; margin: 0 0 1rem; }
  .cv-mark > div { padding: 0.75rem 0.9rem; background: var(--tl-card); }
  .cv-mark p:last-child { margin-bottom: 0; }
  .cv-yousaid { margin-bottom: 0.3rem !important; color: var(--tl-muted); }
  .cv-yousaid span { color: var(--cv-yellow); font-weight: 600; overflow-wrap: anywhere; }
  :root[data-theme="light"] .cv-yousaid span { color: #7a5c00; }
  .cv-plan { padding: 0.75rem 1rem 0.75rem 2.25rem !important; border: 1px dashed var(--tl-muted); background: var(--tl-card); }
  .cv-ticks { margin: 0 0 1rem; padding: 0; border: 0; }
  .cv-ticks legend { padding: 0; color: var(--sl-color-white); font-weight: 700; }
  .cv-ticks label { display: flex; align-items: flex-start; gap: 0.6rem; min-height: 44px; margin-top: 0.3rem; padding: 0.6rem 0.75rem; background: var(--tl-card); cursor: pointer; }
  .cv-ticks input { margin-top: 0.2rem !important; }
  .cv-quotes { display: grid; gap: 0.7rem; margin: 0 0 1rem; }
  .cv-quotes label { display: grid; gap: 0.25rem; }
  .cv-quotes input { width: 100%; }
  .cv-prompt { display: grid; margin: 0 0 1rem; padding: 0.85rem 1rem; border: 1px dashed var(--tl-muted); background: var(--tl-card); }
  .cv-prompt p { font-family: var(--sl-font-mono); font-size: 0.9rem; }
  .cv-pre { white-space: pre-wrap; }
  .cv-cases li { margin-bottom: 0.4rem; }
  .cv-more { margin: 0 0 0.75rem; border-top: 1px solid var(--tl-line); }
  .cv-more summary { display: list-item; min-height: 44px; padding-block: 0.6rem; color: var(--sl-color-white); font-weight: 700; cursor: pointer; }
  .cv-more details summary { color: var(--tl-ink); }
  .cv-twins { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0.6rem; margin: 0 0 1rem; }
  .cv-twins div { padding: 0.8rem 1rem; background: var(--tl-card); border-top: 4px solid var(--tl-muted); }
  .cv-twins h3 { margin: 0 0 0.4rem; font-size: 1rem; }
  .cv-twins p:last-child { margin-bottom: 0; }
  .cv-commit { display: grid; margin: 0 0 1rem; }
  .cv-commit .cv-reveal { margin-top: 0.75rem; }
  .cv-model { padding: 0.7rem 0.9rem; border-left: 3px solid var(--sl-color-accent); background: var(--tl-card); color: var(--sl-color-white); }
  .cv-saved { color: var(--tl-muted); font-size: 0.9rem; }
  .cv-dots .cv-key { margin-top: -0.4rem !important; }
  .cv-dots .cv-key i { width: 0.8rem; height: 0.8rem; }
  .cv-chain { display: grid; gap: 0.35rem; max-width: 30rem; margin: 0 0 1rem; }
  .cv-track { display: block; background: repeating-linear-gradient(45deg, color-mix(in srgb, var(--cv-red) 55%, transparent) 0 3px, transparent 3px 6px); }
  .cv-track span { display: block; height: 0.8rem; background: var(--cv-green); }
  .cv-chain p { margin: 0.1rem 0 0; font-size: 0.92rem; }
  .cv-flow { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 0 0 1rem; }
  .cv-flow > div { padding: 0.55rem 0.8rem; border: 1px solid var(--tl-muted); font-weight: 700; }
  .cv-flow > .is-record { border: 2px solid var(--sl-color-accent); color: var(--sl-color-white); }
  .cv-flow > i { color: var(--tl-muted); font-style: normal; }
  .cv-flow ul { flex: 1 1 14rem; margin: 0 !important; padding: 0 !important; list-style: none; }
  .cv-flow li { margin: 0.2rem 0; padding: 0.3rem 0.7rem; border-left: 3px solid var(--sl-color-accent); background: var(--tl-card); font-size: 0.94rem; }
  .cv-merge { display: grid; gap: 0.4rem; margin: 0 0 1rem; }
  .cv-merge > div { display: flex; flex-wrap: wrap; align-items: center; gap: 0.2rem 0.9rem; }
  .cv-merge p { flex: 0 0 9.5rem; margin: 0; font-size: 0.92rem; }
  .cv-merge > div > div { display: flex; gap: 3px; }
  .cv-merge i { width: 1.1rem; height: 1.1rem; }
  .cv-merge .is-kept p { color: var(--sl-color-white); font-weight: 700; }
  .cv-policies { margin: 0 0 1rem; }
  .cv-policies button[aria-pressed="false"], :root[data-theme="light"] .cv-policies button[aria-pressed="false"] { background: transparent; color: var(--tl-ink); border-color: var(--tl-muted); font-weight: 400; }
  .cv-policy { margin-top: 0.6rem; padding: 0.8rem 1rem; background: var(--tl-card); border-left: 3px solid var(--tl-muted); }
  .cv-policy[data-policy-panel="record"] { border-left-color: var(--sl-color-accent); }
  .cv-policy p:last-child { margin-bottom: 0; }
  .cv-mono { font-family: var(--sl-font-mono); font-size: 0.9rem; color: var(--sl-color-white); }
  .cv .cv-pack { max-height: 15rem; margin: 0 0 0.75rem; overflow: auto; white-space: pre-wrap; font-size: 0.8rem; }
  .cv-evidence { margin: 0 0 1rem; padding: 0.9rem 1rem; background: var(--tl-card); border-left: 3px solid var(--cv-yellow); }
  .cv-evidence .cv-fb:not(:empty) { background: var(--tl-bg); }
  .cv-found { display: grid; gap: 0.3rem; margin: 0 0 0.5rem !important; padding: 0 !important; list-style: none; }
  .cv-found li { margin: 0; padding: 0.4rem 0.7rem; border-left: 3px solid var(--cv-red); background: var(--tl-bg); }
  .cv-found li.is-found { border-left-color: var(--sl-color-accent); }
  .cv-found b { color: var(--sl-color-white); }
  .cv-drop { margin: 0 !important; color: var(--tl-muted); font-size: 0.82rem; }
  .cv-commit > .cv-once { margin-top: 0.4rem !important; }
  .cv-check > *, .cv-line > label { min-width: 0; max-width: 100%; }
  .cv-check > .cv-line[data-q] > label:first-child { display: flex; font-weight: 600; }
  .cv-line select, .cv-check [data-q] > select { min-width: 0; max-width: 100%; flex: 0 1 15rem; }
  .cv-rules { margin: 0 0 1rem; }
  .cv-rules button[aria-pressed="false"], :root[data-theme="light"] .cv-rules button[aria-pressed="false"] { background: transparent; color: var(--tl-ink); border-color: var(--tl-muted); font-weight: 400; }
  .cv-rules .cv-hostwrap { margin-top: 0.6rem; }
</style>

<script>
  const KEY = "touchline-m1-coverage";
  const PACK = JSON.parse(document.querySelector<HTMLElement>("[data-coverage]")!.dataset.pack!) as { members: string[]; played: number; points: number; host: number; scored: number; finals: number };
  document.querySelectorAll<HTMLElement>("[data-coverage]").forEach((root) => {
    let store: Record<string, string> = {};
    let canSave = true;
    try { store = JSON.parse(localStorage.getItem(KEY) ?? "{}"); } catch { canSave = false; }
    const put = (key: string, value: string) => {
      store[key] = value;
      try { localStorage.setItem(KEY, JSON.stringify(store)); } catch { canSave = false; }
    };
    type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    const fields = [...root.querySelectorAll<Field>("[data-save]")];
    const isBox = (f: Field): f is HTMLInputElement => f instanceof HTMLInputElement && (f.type === "checkbox" || f.type === "radio");
    const valueOf = (f: Field) => f instanceof HTMLInputElement && f.type === "checkbox" ? (f.checked ? "1" : "") : f.value;

    const showBack = () => root.querySelectorAll<HTMLElement>("[data-show]").forEach((el) => {
      el.textContent = store[el.dataset.show!]?.trim() || "nothing yet";
    });

    const commitState = (box: HTMLElement) => {
      const areas = [...box.querySelectorAll<HTMLTextAreaElement>("textarea")];
      const needs = box.dataset.needs?.split(",") ?? [];
      const short = areas.some((a) => a.value.trim().length < 25) || needs.some((k) => (k === "read-ask" ? (store[k] ?? "").trim().length < 25 : !store[k]));
      box.querySelector<HTMLButtonElement>(":scope > button")!.disabled = short;
      const note = box.querySelector<HTMLElement>("[data-needs-note]");
      if (note) note.hidden = !short || !!store[`open-${needs.join()}`];
    };
    const lockFor = (box: HTMLElement) => {
      if (box.dataset.locks) root.querySelectorAll<Field>(`#${box.dataset.locks} [data-save]`).forEach((f) => { f.disabled = true; });
    };
    const evidence = (box: HTMLElement) => {
      const text = box.querySelector<HTMLTextAreaElement>("textarea")!.value.replace(/[\u2018\u2019]/g, "'").replace(/[\u00a0\u2007\u202f]/g, " ").replace(/[\u2010-\u2015\u2212]/g, "-");
      const list = box.querySelector<HTMLElement>("[data-found]")!;
      const note = box.querySelector<HTMLElement>("[data-evidence-note]")!;
      list.replaceChildren();
      if (text.trim().length < 80) { note.textContent = text.trim() ? "Paste the whole answer, including its table." : ""; return; }
      const absent = box.dataset.absent!;
      const played = Number(box.dataset.played);
      const points = Number(box.dataset.points);
      const plain = (v: string) => v.replace(/\./g, "").toLowerCase();
      const lines = text.split("\n").map(plain);
      const cellsOf = (line: string) => line.split(/\||\t|\s{2,}/).map((c) => c.trim()).filter(Boolean);
      const isRow = (line: string, name: string) => line.replace(/^[|*\s\d.)]+/, "").startsWith(plain(name)) && (line.match(/\d+/g) ?? []).length >= 2;
      const rowFor = (name: string) => lines.find((line) => isRow(line, name));
      const teams = PACK.members.filter((name) => rowFor(name));
      const row = rowFor(absent);
      const firstRow = lines.findIndex((line) => PACK.members.some((name) => isRow(line, name)));
      const head = lines.slice(0, Math.max(firstRow, 0)).reverse().find((line) => /\b(pts|points)\b/.test(line));
      const cells = row ? cellsOf(row) : [];
      const nums = cells.slice(cells.findIndex((c) => c.includes(plain(absent))) + 1).map((c) => Number(c.replace(/[^\d-]/g, ""))).filter((n) => !Number.isNaN(n));
      const column = (re: RegExp) => { const at = head ? cellsOf(head).findIndex((c) => re.test(c)) : -1; return at >= 0 && cells.length === cellsOf(head!).length ? Number(cells[at].replace(/[^\d-]/g, "")) : null; };
      const gotPoints = column(/^(pts|points)$/) ?? nums.at(-1);
      const gotPlayed = column(/^(p|gp|mp|pld|played|games|matches)$/) ?? (nums[0] === played ? nums[0] : nums.length >= 3 ? nums[0] + nums[1] + nums[2] : nums[0]);
      const parts = text.split(/\n|(?<=(?<!\b(?:St|vs|v|Sep|Sept))[.!?])\s/);
      const gone = /missing|omitted|left out|not (included|provided|supplied|present|among|in the|given|in what)|absent|no (schedule|page)|was ?n[o']t (included|provided|supplied|given|in|among|part)|lack|reconstructed from|(taken|derived|inferred|come|came|comes) from (the )?(other|opponent|visitor)/i;
      const saysAbsent = parts.some((part) => part.toLowerCase().includes(absent.split(' ')[0].toLowerCase()) && /page|schedule|file|source|input|sent|provided|supplied/i.test(part) && gone.test(part) && !/not (yet )?played|upcoming|to be played|(not|n't|none|nothing) (\w+ )?missing|all eight (pages|schedules)/i.test(part));
      const saysFinal = parts.some((part) => /sep(t|tember)?\.? ?21|09-21|9\/21|21 sep/i.test(part) && /no score|without a score|no result|unscored|blank|score (is |was )?(missing|unknown|not)|exclud|omit|not (counted|included)|left out/i.test(part) && !/\b\d\s?-\s?\d\b/.test(part.replace(/\d{4}-\d{2}-\d{2}|09-21/g, "")));
      const checks: [boolean, string, string][] = [
        [teams.length === 8, "Eight teams in its table", teams.length ? `${teams.length} member rows found. A school with no page dropped out of the table.` : "No table rows found."],
        [gotPlayed === played && gotPoints === points, `${absent} on ${played} played and ${points} points`, row ? `Its ${absent} row reads ${nums.slice(0, 8).join(", ")}. ${gotPlayed === Number(box.dataset.host) ? "That is Kick's host-only count." : "That may be a counting slip, double counting, or non-conference rows."}` : `No ${absent} row found.`],
        [saysAbsent, `Says ${absent}'s own page is not there`, "Nothing found that says a page is missing."],
        [saysFinal, "Names September 21 as a final without a score", "Nothing found about September 21."],
        [/\b53\b[^\n]{0,40}\b54\b|\b54\b[^\n]{0,40}\b53\b/.test(text), `Gives ${PACK.scored} counted, out of ${PACK.finals} finished`, "The two numbers do not appear together."],
      ];
      checks.forEach(([ok, label, miss]) => {
        const li = document.createElement("li");
        li.className = ok ? "is-found" : "";
        const b = document.createElement("b");
        b.textContent = ok ? "Found. " : "Not found. ";
        li.append(b, ok ? label : `${label}. ${miss}`);
        list.append(li);
      });
      const found = checks.filter(([ok]) => ok).length;
      const told = checks.slice(2).filter(([ok]) => ok).length;
      put(`found-${box.dataset.evidence}`, String(found));
      if (box.dataset.evidence === "first") note.textContent = `${found} of 5 found. It volunteered ${told} of the 3 gaps.${store.predict ? ` You predicted ${store.predict}.` : ""}`;
      else note.textContent = `${found} of 5 found.${store["found-first"] ? ` The first answer had ${store["found-first"]}.` : ""}`;
      box.querySelector<HTMLElement>(".cv-reveal")?.classList.add("is-open");
    };

    fields.forEach((f) => {
      const key = f.dataset.save!;
      const saved = store[key];
      if (saved !== undefined) {
        if (f instanceof HTMLInputElement && f.type === "checkbox") f.checked = saved === "1";
        else if (f instanceof HTMLInputElement && f.type === "radio") f.checked = saved === f.value;
        else f.value = saved;
      }
      f.addEventListener(f instanceof HTMLTextAreaElement || (f instanceof HTMLInputElement && !isBox(f)) ? "input" : "change", () => {
        if (f instanceof HTMLInputElement && f.type === "radio" && !f.checked) return;
        put(key, valueOf(f));
        showBack();
        if (key === "rewrite") leak();
        if (key.startsWith("answer-") || key === "predict") root.querySelectorAll<HTMLElement>("[data-evidence]").forEach(evidence);
        root.querySelectorAll<HTMLElement>("[data-commit]").forEach(commitState);
        if (key === "brief") root.querySelector<HTMLElement>("[data-saved-note]")!.textContent = canSave ? "Saved in this browser." : "This browser could not save it, so copy it somewhere safe.";
      });
    });
    const leak = () => {
      const rewrite = store.rewrite ?? "";
      const named = /sep(t|tember)?\.? ?21|09-21|9\/21|\b5[346]\b/i.test(rewrite) || PACK.members.some((name) => rewrite.toLowerCase().includes(name.toLowerCase()));
      root.querySelector<HTMLElement>("[data-leak]")!.textContent = named ? "Your prompt names a school, a date or a count. That tells the assistant the answer for one set of pages and will not transfer to the next. Ask for the kind of thing instead." : "";
    };
    leak();
    showBack();
    root.querySelectorAll<HTMLElement>("[data-evidence]").forEach(evidence);
    root.querySelectorAll<HTMLElement>("[data-rules]").forEach((box) => {
      const buttons = [...box.querySelectorAll<HTMLButtonElement>("[data-rule]")];
      const lost = [...box.querySelectorAll<HTMLElement>('[data-cell="lost"]')];
      buttons.forEach((button) => button.addEventListener("click", () => {
        const both = button.dataset.rule === "both";
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
        lost.forEach((cell) => { cell.className = both ? "is-read" : "is-lost"; cell.firstElementChild!.textContent = both ? "●" : "✕"; });
        box.querySelector<HTMLElement>("[data-rules-note]")!.textContent = both
          ? `${PACK.scored} of ${PACK.finals} finished matches read. The seven come back from the visitors' pages. September 21 is still without a score.`
          : `${PACK.scored - lost.length} of ${PACK.finals} finished matches read. Seven are lost with one page.`;
      }));
    });
    root.querySelectorAll<HTMLElement>("[data-policies]").forEach((box) => {
      const buttons = [...box.querySelectorAll<HTMLButtonElement>("[data-policy]")];
      buttons.forEach((button) => button.addEventListener("click", () => {
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
        box.querySelectorAll<HTMLElement>("[data-policy-panel]").forEach((panel) => { panel.hidden = panel.dataset.policyPanel !== button.dataset.policy; });
      }));
    });
    root.querySelectorAll<HTMLElement>("[data-commit]").forEach((box) => {
      const openKey = `open-${box.dataset.needs ?? ""}`;
      const open = () => {
        box.querySelector<HTMLElement>(".cv-reveal")!.classList.add("is-open");
        box.querySelector<HTMLButtonElement>(":scope > button")!.hidden = true;
        lockFor(box);
      };
      if (box.dataset.needs && store[openKey]) open();
      commitState(box);
      box.querySelector<HTMLButtonElement>(":scope > button")!.addEventListener("click", (event) => {
        const reveal = box.querySelector<HTMLElement>(".cv-reveal")!;
        if (box.dataset.needs) put(openKey, "1");
        open();
        commitState(box);
        reveal.tabIndex = -1;
        (event.currentTarget as HTMLButtonElement).hidden = true;
        if (event.detail === 0) reveal.focus({ preventScroll: true });
      });
    });

    const grade = (q: HTMLElement): boolean | null => {
      const type = q.dataset.type!;
      const answer = q.dataset.answer!;
      const values = [...q.querySelectorAll<Field>("[data-save]")].filter((f) => !f.hasAttribute("data-required"));
      if (q.querySelector<HTMLInputElement>("[data-required]")?.value.trim() === "") return null;
      if (type === "radio") {
        const picked = values.find((f) => (f as HTMLInputElement).checked);
        return picked ? picked.value === answer : null;
      }
      if (values.some((f) => !f.value.trim())) return null;
      if (type === "number") return String(Number(values[0].value)) === answer;
      if (type === "range") return values.map((f) => Number(f.value)).join() === answer;
      if (type === "pair") return values.map((f) => f.value).sort().join() === answer;
      return values[0].value === answer;
    };

    root.querySelectorAll<HTMLElement>("[data-once]").forEach((box) => {
      const flag = `done-${box.dataset.once}`;
      const questions = [...box.querySelectorAll<HTMLElement>("[data-q]")];
      const button = box.querySelector<HTMLButtonElement>("[data-submit]")!;
      const need = box.querySelector<HTMLElement>("[data-need]")!;
      const settle = (focus: boolean) => {
        let right = 0;
        questions.forEach((q) => {
          const ok = grade(q) === true;
          right += Number(ok);
          const fb = q.querySelector<HTMLElement>(".cv-fb")!;
          fb.classList.add(ok ? "is-right" : "is-wrong");
          const picked = q.querySelector<HTMLSelectElement>("select")?.value ?? "";
          const hint = !ok && q.dataset.wrong ? (JSON.parse(q.dataset.wrong) as Record<string, string>)[picked] ?? "" : "";
          fb.textContent = `${ok ? "Right." : "Not right."} ${hint ? `${hint} The answer is ` : ""}${q.dataset.why}`;
        });
        box.querySelectorAll<Field>("input, select").forEach((f) => { f.disabled = true; });
        button.hidden = true;
        box.querySelector<HTMLElement>(".cv-once")!.hidden = true;
        need.classList.remove("is-wrong");
        need.textContent = `${right} of ${questions.length} right on your one attempt.`;
        const reveal = box.querySelector<HTMLElement>(".cv-reveal")!;
        reveal.classList.add("is-open");
        if (focus) { need.tabIndex = -1; need.focus({ preventScroll: true }); }
      };
      button.addEventListener("click", (event) => {
        if (questions.some((q) => grade(q) === null)) {
          need.classList.add("is-wrong");
          need.textContent = "Answer every part first.";
          return;
        }
        put(flag, "1");
        settle(event.detail === 0);
      });
      if (store[flag] && questions.every((q) => grade(q) !== null)) settle(false);
    });

    const copy = async (button: HTMLButtonElement, text: string, label: string) => {
      try { await navigator.clipboard.writeText(text); button.textContent = "Copied"; }
      catch { button.textContent = "Select the text and copy it"; }
      setTimeout(() => { button.textContent = label; }, 2500);
    };
    root.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", () => copy(button, button.parentElement!.querySelector<HTMLElement>("[data-copy-text]")!.textContent!, button.dataset.label ?? "Copy the prompt"));
    });
    const briefButton = root.querySelector<HTMLButtonElement>("[data-copy-brief]")!;
    briefButton.addEventListener("click", () => copy(briefButton, root.querySelector<HTMLTextAreaElement>("#cv-brief")!.value, "Copy my clause"));

    root.querySelector<HTMLButtonElement>("[data-reset]")!.addEventListener("click", () => {
      try { localStorage.removeItem(KEY); } catch {}
      history.scrollRestoration = "manual";
      scrollTo(0, 0);
      location.reload();
    });

    try {
      const first = localStorage.getItem("touchline-first-ask");
      if (first) {
        const card = root.querySelector<HTMLElement>("[data-first]")!;
        card.querySelector<HTMLElement>("[data-first-text]")!.textContent = first;
        card.hidden = false;
        root.querySelector<HTMLElement>("[data-no-first]")!.hidden = true;
        const back = root.querySelector<HTMLElement>("[data-close-first]")!;
        back.querySelector("q")!.textContent = first;
        back.hidden = false;
      }
    } catch {}
  });
</script>
