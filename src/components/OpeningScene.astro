---
import FirstRunTable from "./FirstRunTable.astro";
import { reported } from "../lib/first-run";

const prompt = "Collect this season's men's soccer results from all eight school websites and build a conference table I can publish.";
const work = ["Finding the eight school sites", "Writing a collector", "Fetching schedules and box scores", "Reading scores from each page", "Matching team names", "Building the standings"];
---

<script is:inline>document.documentElement.classList.add("os-js");</script>

<div class="os not-content" data-scene>
  <section class="os-beat">
    <h2>You have a table to publish by Friday</h2>
    <p>You help run the Prairie Lakes Conference, eight college soccer programs invented for this course. Coaches and fans keep asking for one set of standings. No official feed exists. Each school posts its results on its own website.</p>
    <p>So you do what most people would do now. You ask an AI agent.</p>
  </section>

  <section class="os-prompt" aria-label="Your prompt">
    <p class="os-label">Your prompt</p>
    <p class="os-text">{prompt}</p>
    <button type="button" class="os-go" data-send>Send to the agent</button>
  </section>

  <section class="os-work" data-work aria-label="The agent at work">
    <p class="os-label">AI agent <span>scripted example</span></p>
    <ol>{work.map((w) => <li>{w}</li>)}</ol>
    <p class="os-status" role="status" data-status></p>
  </section>

  <section class="os-result" data-result>
    <p class="os-label">AI agent <span>scripted example</span></p>
    <p class="os-claim" tabindex="-1">Done. I collected the season from all eight school sites with no errors. Your table is ready to publish.</p>
    <FirstRunTable rows={reported} caption="Prairie Lakes men, 2026" />
    <button type="button" class="os-go" data-publish>Publish</button>
  </section>

  <section class="os-turn" data-turn>
    <h2 tabindex="-1">Before that goes out</h2>
    <p>Coaches will quote this table, with your name on it. It looks right, and the agent says it worked. You did not watch it work, and you could not read everything it wrote.</p>
    <p><strong>If something in this table were wrong, how would you know?</strong></p>
    <p>That is the question this course answers. You will open up what the agent built, one step at a time, then come back and decide whether to publish.</p>
    <a href="./start/platform/">Look inside what the agent built</a>
  </section>
</div>

<style is:global>
  .os { max-width: 44rem; margin: 0 0 2.5rem; color: var(--tl-ink); line-height: 1.55; }
  .os h2 { margin: 0 0 0.6rem; color: var(--sl-color-white); font-size: clamp(1.5rem, 4.5vw, 2.05rem); line-height: 1.15; font-weight: 750; letter-spacing: -0.015em; text-wrap: balance; scroll-margin-top: 5rem; outline: none; }
  .os p { margin: 0 0 0.7rem; }
  .os-beat { margin-bottom: 1.1rem; }
  .os-prompt, .os-work, .os-result { margin: 0 0 1rem; padding: 0.9rem 1rem; background: var(--tl-card); scroll-margin-top: 5rem; }
  .os-prompt { border: 1px solid var(--tl-muted); border-radius: 3px; }
  .os-work, .os-result { border-left: 3px solid var(--sl-color-accent); }
  .os-label { margin-bottom: 0.25rem !important; font-size: 0.85rem; font-weight: 700; }
  .os-label span { margin-left: 0.4rem; color: var(--tl-muted); font-weight: 400; }
  .os-text { color: var(--sl-color-white); font-size: 1.08rem; }
  .os-claim { color: var(--sl-color-white); font-weight: 600; outline: none; }
  .os-work ol { margin: 0; padding: 0; list-style: none; }
  .os-work li { position: relative; margin: 0.15rem 0; padding-left: 1.5rem; }
  .os-work li::before { content: "✓"; position: absolute; left: 0; color: var(--sl-color-accent); font-weight: 700; }
  .os-js .os-work li:not(.is-done) { display: none; }
  .os-status { margin: 0 !important; }
  .os-go, .os-turn a { display: inline-flex; align-items: center; min-height: 44px; padding: 0.55rem 1.1rem; border: 0; border-radius: 3px; background: var(--sl-color-accent); color: var(--sl-color-black); font: inherit; font-weight: 700; text-decoration: none; cursor: pointer; }
  :root[data-theme="light"] .os-go, :root[data-theme="light"] .os-turn a { color: #fff; }
  .os-go[hidden] { display: none; }
  .os-go:focus-visible, .os-turn a:focus-visible { outline: 3px solid var(--sl-color-white); outline-offset: 2px; }
  .os-turn { padding: 1.1rem; border-left: 3px solid #f4c62f; background: var(--tl-card); scroll-margin-top: 5rem; }
  .os-js .os-work:not(.is-open), .os-js .os-result:not(.is-open), .os-js .os-turn:not(.is-open) { display: none; }
  html:not(.os-js) .os-go { display: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-scene]").forEach((root) => {
    const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const behavior: ScrollBehavior = calm ? "auto" : "smooth";
    const send = root.querySelector<HTMLButtonElement>("[data-send]")!;
    const work = root.querySelector<HTMLElement>("[data-work]")!;
    const result = root.querySelector<HTMLElement>("[data-result]")!;
    const turn = root.querySelector<HTMLElement>("[data-turn]")!;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const steps = [...work.querySelectorAll("li")];

    const finish = () => {
      steps.forEach((step) => step.classList.add("is-done"));
      status.textContent = "The agent has finished.";
      result.classList.add("is-open");
      result.querySelector<HTMLElement>(".os-claim")!.focus({ preventScroll: true });
      result.scrollIntoView({ behavior, block: "start" });
    };

    send.addEventListener("click", () => {
      send.hidden = true;
      work.classList.add("is-open");
      status.textContent = "The agent is working.";
      if (calm) return finish();
      work.scrollIntoView({ behavior, block: "nearest" });
      steps.forEach((step, i) => setTimeout(() => step.classList.add("is-done"), 380 * (i + 1)));
      setTimeout(finish, 380 * (steps.length + 1));
    });

    root.querySelector<HTMLButtonElement>("[data-publish]")!.addEventListener("click", (event) => {
      (event.currentTarget as HTMLButtonElement).hidden = true;
      turn.classList.add("is-open");
      turn.querySelector("h2")!.focus({ preventScroll: true });
      turn.scrollIntoView({ behavior, block: "start" });
    });
  });
</script>
