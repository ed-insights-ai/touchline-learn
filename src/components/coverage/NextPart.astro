---
import { findPart } from "../../lib/lesson";
import { lessonForRoute } from "../../lib/lessons";

interface Props { from: string }
const lesson = lessonForRoute(Astro.locals.starlightRoute.id);
if (!findPart(lesson, Astro.props.from).next) throw new Error(`${Astro.props.from} is the last part of Module ${lesson.n}`);
---

<p class="cv-next">
  <span class="cv-next-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
  <span class="cv-next-text"><slot /></span>
</p>
