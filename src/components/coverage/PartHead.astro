---
import { findPart } from "../../lib/lesson";
import { lessonForRoute } from "../../lib/lessons";

interface Props { id: string }
const part = findPart(lessonForRoute(Astro.locals.starlightRoute.id), Astro.props.id);
---

<header class="cv-head">
  <p class="cv-eyebrow"><b>{part.phaseName}</b><span>Part {part.n} of {part.of}</span></p>
  <h2><slot /></h2>
</header>
