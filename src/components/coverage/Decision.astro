---
import Bench from "./Bench.astro";
import { bounds, story } from "../../lib/coverage";
import { noScore } from "../../lib/cases";
import PartHead from "./PartHead.astro";
import NextPart from "./NextPart.astro";
import AiStudy from "./AiStudy.astro";
import { failPrompt } from "../../lib/primer";

const said: Record<string, string> = {
  stop: "Stop the run",
  skip: "Skip it and carry on",
  fill: "Fill in 0-0",
  record: "Record the gap",
};

const runs = [
  { key: "kick", who: "Kick, Friday", text: `Done. All eight school sites, ${story.counted} conference matches, no errors.`, ok: "no", publish: "no",
    why: "Failed, and hold back the table. Dunmore never answered and no coverage record names that gap, so the summary hides what is missing. “No errors” only describes the code." },
  { key: "record", who: "Collector with a record, Friday", text: `8 schedule pages expected, 7 saved. Dunmore: unavailable, no answer after three tries. ${story.counted} of ${story.finals} finished matches counted; ${bounds.unseen} Dunmore home matches not read; ${noScore.day} final, no score on either schedule.`, ok: "yes", publish: "no",
    why: `Succeeded, and hold back the table. The coverage record was written accurately, gaps and all. Looking at it, ${bounds.unseen} matches can be recovered from pages already saved, so a table missing them shouldn't be published yet.` },
  { key: "monday", who: "Collector with a record, Monday", text: `Both teams' saved schedules checked where available. ${story.afterRepair} of ${story.finals} finished matches counted, ${bounds.unseen} of them from the visitors' pages. Not counted: ${noScore.home} vs. ${noScore.away}, ${noScore.day}, final, score unknown.`, ok: "yes", publish: "yes",
    why: "Succeeded, and publish it with the gap noted under the table. A table doesn't need 100% coverage to be published; it just needs to be honest about what it includes." },
];
const options = [
  { name: said.skip, out: `A table on ${story.counted} matches, and “no errors”`, reader: "Nothing. The gap stays invisible until someone calls." },
  { name: said.fill, out: `A table on ${story.counted + bounds.unseen} matches, ${bounds.unseen} of them invented`, reader: `Nothing, and ${bounds.unseen} scores nobody saw now look real.` },
  { name: said.stop, out: "No table at all", reader: `That something failed. The ${story.counted} matches that were read go unused.` },
  { name: said.record, out: `A table on ${story.counted} of ${story.finals}, with each gap named`, reader: "What is missing, and why.", here: true },
];
const yesNo = (name: string) => [["yes", name === "ok" ? "Succeeded" : "Publish"], ["no", name === "ok" ? "Failed" : "Hold back"]];
---

<section id="decision">
  <PartHead id="decision">The decision: what to do when a site doesn't answer</PartHead>
  <blockquote class="cv-quote">
    <p>“Every check mark hid a decision Riley never knew was theirs to make.”</p>
    <footer>From <em>Publish Day</em></footer>
  </blockquote>
  <p>Here is the first design choice: what should Kick do when Dunmore's site doesn't answer? <span data-decision-said data-said={JSON.stringify(said)}>Test Friday under all four options below and compare what happens.</span></p>
  <Bench id="bench-decision" controls={["design"]} show={["says", "counts", "table"]} caption="Friday: Dunmore's site doesn't answer. Compare all four options." />
  <div class="cv-chose" data-gate data-chose>
    <p class="cv-once">Click each of the four options above to unlock the comparison. <span data-chose-tried></span></p>
    <button type="button" data-chose-open disabled>Show comparison</button>
    <div class="cv-reveal">
  <div class="cv-scroll">
    <table class="cv-stagemap cv-options">
      <caption>Friday under each option</caption>
      <thead><tr><th scope="col">When a page does not answer</th><th scope="col">What comes out</th><th scope="col">What a reader can tell</th></tr></thead>
      <tbody>
        {options.map((o) => <tr class:list={{ "is-here": o.here }}><th scope="row">{o.name}</th><td>{o.out}</td><td>{o.reader}</td></tr>)}
      </tbody>
    </table>
  </div>
  <p>Kick chose “Skip it and carry on,” a common default: the job finishes and produces a table, but every one of the eight rows is missing at least one result. Recording the gap lets the run finish <em>and</em> makes the gap visible. Touchline uses that fourth approach.</p>
  <div class="cv-flow" role="img" aria-label="The collector writes down every gap. The season view, the published figures and the next run work from what it wrote.">
    <div>Collector</div><i aria-hidden="true">→</i><div class="is-record">Coverage record + gap list in each season file</div><i aria-hidden="true">→</i>
    <ul><li>Season view: shows a notice for each gap</li><li>Stats: reports counted out of played</li><li>Next run: knows what to retry</li></ul>
  </div>
    </div>
  </div>

  <h4 class="cv-try">The rule</h4>
  <p>Touchline's rule for what counts as success:</p>
  <p class="cv-rule">A named gap does not fail the run. A run succeeds when the coverage record is written and accurately reflects reality, gaps and all.</p>
  <p>This is Touchline's rule for a standings table. A product with stricter needs might hold everything until coverage is full. The rule turns Friday into two separate decisions:</p>
  <div class="cv-twins cv-two">
    <div>
      <h4>1. Did the run succeed?</h4>
      <p>Was the coverage record written, and does it match what happened? A run that fails to write its record has failed, because nothing shows what it collected against what it expected.</p>
    </div>
    <div>
      <h4>2. Should we publish?</h4>
      <p>Does that record support what the table claims? Hold the table back while a gap can still be closed from pages you already have. Once you've recovered what you can from the pages already saved, publish with every remaining gap named.</p>
    </div>
  </div>
  <AiStudy
    id="decision-ai-study"
    title="When a source doesn't answer"
    note="Send this prompt to read the reply an AI assistant gave, or copy it into your own. Then come back and apply the rule to three runs."
    prompt={failPrompt}
    href="../01-collection-ai-failures/"
  />
  <h4 class="cv-try">Apply the rule</h4>
  <p>Three runs end with the summaries below. For each one, did the run succeed, and should you publish the table?</p>
  <div class="cv-check" data-once="succeed">
    <p class="cv-kind">Apply it</p>
    {runs.map((r) => (
      <div class="cv-run">
        <div class="cv-say"><p class="cv-who">{r.who}</p><p>{r.text}</p></div>
        <div class="cv-row">
          {(["ok", "publish"] as const).map((q) => (
            <div data-q data-type="select" data-answer={r[q]} data-why={q === "ok" ? r.why : (r.publish === "yes" ? "Publish it, with the gap noted underneath." : "Hold it back until the recoverable matches are included.")}>
              <label><span>{q === "ok" ? "The run" : "The table"}</span>
                <select data-save={`run-${r.key}-${q}`}><option value="">Choose</option>{yesNo(q).map(([v, t]) => <option value={v}>{t}</option>)}</select>
              </label>
              <p class="cv-fb" role="status"></p>
            </div>
          ))}
        </div>
      </div>
    ))}
    <p class="cv-once">Answer all six, then check.</p>
    <button type="button" data-submit>Check answers</button>
    <p class="cv-fb" role="status" data-need></p>
    <div class="cv-reveal"><p>Run success is about whether the record is complete and accurate. Publishing is a separate judgment call made after reading that record.</p></div>
  </div>
  <p class="cv-further">Optional deep dive: <a href="../01-collection-field-work/?from=decision#platform">How Touchline builds it</a> explains how the coverage record stays accurate across reruns and interrupted jobs.</p>
  <NextPart from="decision">What would Friday have looked like if Riley had required a coverage record from the start?</NextPart>
</section>

<script>
  const KEY = "touchline-m1-coverage";
  const bench = document.getElementById("bench-decision");
  const out = document.querySelector<HTMLElement>("[data-decision-said]");
  const said = JSON.parse(out?.dataset.said ?? "{}") as Record<string, string>;
  const stored = () => { try { return (JSON.parse(localStorage.getItem(KEY) ?? "{}") as Record<string, string>).decision ?? ""; } catch { return ""; } };
  const apply = (choice: string) => {
    if (out) {
      out.textContent = said[choice]
        ? `Earlier in the setup you chose “${said[choice]}”, so the simulator starts there. Click each of the four options to compare them.`
        : "You didn't pick an option in the setup, so the simulator starts on Kick's default. Click each of the four options below.";
    }
    if (bench && said[choice]) bench.dispatchEvent(new CustomEvent("bench:set", { detail: { design: choice, baseline: true } }));
  };
  let started = false;
  const start = () => { if (started) return; started = true; apply(stored()); };
  if (document.readyState === "complete") start();
  else { document.addEventListener("DOMContentLoaded", start); addEventListener("load", start); }
  document.querySelectorAll<HTMLInputElement>('input[data-save="decision"]').forEach((input) => input.addEventListener("change", () => { if (input.checked) apply(input.value); }));


  const gate = document.querySelector<HTMLElement>("[data-chose]");
  if (gate) {
    const read = (): Record<string, string> => { try { return JSON.parse(localStorage.getItem(KEY) ?? "{}"); } catch { return {}; } };
    const write = (k: string, v: string) => { try { localStorage.setItem(KEY, JSON.stringify({ ...read(), [k]: v })); } catch {} };
    const tried = new Set((read()["bench-clicked"] ?? "").split(",").filter(Boolean));
    const note = gate.querySelector<HTMLElement>("[data-chose-tried]")!;
    const button = gate.querySelector<HTMLButtonElement>("[data-chose-open]")!;
    const show = () => {
      note.textContent = `(${tried.size} of 4 tried)`;
      button.disabled = tried.size < 4;
    };
    const record = (d: string | undefined) => {
      if (!d || tried.has(d)) return;
      tried.add(d);
      write("bench-clicked", [...tried].join());
      show();
    };
    const open = (focus: boolean) => {
      gate.classList.add("is-open");
      gate.querySelector<HTMLElement>(".cv-reveal")!.classList.add("is-open");
      button.hidden = true;
      gate.querySelector<HTMLElement>(".cv-once")!.hidden = true;
      if (focus) { const r = gate.querySelector<HTMLElement>(".cv-reveal")!; r.tabIndex = -1; r.focus({ preventScroll: true }); }
      gate.dispatchEvent(new Event("rail:refresh", { bubbles: true }));
    };
    const first = () => (said[stored()] ? stored() : "skip");
    bench?.addEventListener("click", (event) => {
      const clicked = (event.target as HTMLElement).closest<HTMLElement>("[data-bn-design]")?.dataset.bnDesign;
      if (clicked) { record(first()); record(clicked); }
    });
    button.addEventListener("click", (event) => { write("open-chose", "1"); open(event.detail === 0); });
    if (read()["open-chose"]) open(false);
    show();
  }
</script>
