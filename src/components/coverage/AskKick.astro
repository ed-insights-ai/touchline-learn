---
import { story } from "../../lib/coverage";
import { pipeline, spell } from "../../lib/cases";
import KickThink from "./KickThink.astro";

const asks = [
  {
    q: "Did the whole run work?",
    trace: "Read completion summary only",
    a: `Yes. All eight school sites, ${story.counted} conference matches, no errors.`,
  },
  {
    q: "Can you double-check the table?",
    trace: "Re-ran script · read completion summary only",
    a: `I ran it again. ${story.counted} conference matches, no errors. The table is unchanged.`,
  },
  {
    q: "Is every number in the table right?",
    trace: "Checked table math against parsed rows only",
    a: "Yes. Every match was read from its host's page and added up correctly. No errors.",
  },
  {
    q: "What did you expect to collect, and what happened to each one?",
    trace: `Checked fetch log · ${pipeline.asked} expected, ${pipeline.saved} saved, ${pipeline.silent} timeout`,
    a: `I expected ${spell(pipeline.asked)} schedule pages, one per school. ${spell(pipeline.saved, true)} were saved. Dunmore's did not answer after three tries, so I logged a warning and carried on.`,
    evidence: true,
  },
];
---

<div class="cv-askkick" data-askkick>
  <p class="cv-label">Simulated follow-up. Click any question to see how Kick responds.</p>
  <div class="cv-say cv-yours" data-first hidden>
    <p class="cv-who">Your question from Publish Day, for comparison</p>
    <p data-first-text></p>
  </div>
  <div class="cv-askq" role="group" aria-label="Questions to send Kick" data-ask-buttons hidden>
    {asks.map((x, i) => <button type="button" aria-pressed="false" data-ask-q={i}>{x.q}</button>)}
  </div>
  <div class="cv-chat" data-ask-log aria-live="polite">
    {asks.map((x, i) => (
      <div class="cv-exchange" data-ask-reply={i} data-evidence-reply={x.evidence ? "" : undefined}>
        <div class="cv-riley">
          <b>You</b>
          <p>{x.q}</p>
        </div>
        <div class:list={["cv-kick", { "is-hit": x.evidence }]}>
          <b>Kick</b>
          <KickThink inline={x.trace} highlight={x.evidence} />
          <p>{x.a}</p>
        </div>
      </div>
    ))}
  </div>
  <div class="cv-reveal" data-ask-done>
    <p>All three of the first answers are technically true, yet they only describe how the code ran. Only asking what Kick <em>expected</em> to collect forces it past the summary and into the log.</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-askkick]").forEach((box) => {
    const log = box.querySelector<HTMLElement>("[data-ask-log]")!;
    const done = box.querySelector<HTMLElement>("[data-ask-done]")!;
    box.querySelector<HTMLElement>("[data-ask-buttons]")!.hidden = false;
    box.querySelectorAll<HTMLButtonElement>("[data-ask-q]").forEach((button) => button.addEventListener("click", () => {
      const reply = box.querySelector<HTMLElement>(`[data-ask-reply="${button.dataset.askQ}"]`)!;
      button.setAttribute("aria-pressed", "true");
      if (reply.classList.contains("is-open")) return;
      log.append(reply);
      reply.classList.add("is-open");
      if (reply.hasAttribute("data-evidence-reply")) done.classList.add("is-open");
    }));
  });
</script>
