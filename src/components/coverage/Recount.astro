---
import { story, kickGrid } from "../../lib/coverage";
import { pipeline } from "../../lib/cases";

interface Props { solved?: boolean }
const { solved = false } = Astro.props;
---

<div class:list={["cv-recount", { "is-solved": solved }]} role="region" aria-label="Kick's Friday summary, counted as coverage">
  <div class="cv-chat-bar">
    <span class="cv-agent-badge">Kick · Friday's summary</span>
    <span class="cv-recount-tag">{solved ? "Recounted, with the expected set" : "Recounted"}</span>
  </div>
  <p class="cv-recount-was">“<s>All eight school sites</s>, {story.counted} conference matches, <s>no errors</s>.”</p>
  <div class="cv-recount-row">
    <p class="cv-recount-unit">Schedule pages</p>
    <p class="cv-frac" aria-label={`${pipeline.saved} saved, over ${kickGrid.length} on the membership list`}><span aria-hidden="true">{pipeline.saved} saved</span><span aria-hidden="true">{kickGrid.length} on the membership list</span></p>
    <p class="cv-recount-val">{pipeline.saved} of {kickGrid.length}</p>
  </div>
  {solved ? (
    <div class="cv-recount-row is-found">
      <p class="cv-recount-unit">Finished matches</p>
      <p class="cv-frac" aria-label={`${story.counted} counted in the table, over ${story.finals} finished by Friday`}><span aria-hidden="true">{story.counted} counted in the table</span><span aria-hidden="true">{story.finals} finished by Friday</span></p>
      <p class="cv-recount-val">{story.counted} of {story.finals}</p>
    </div>
  ) : (
    <div class="cv-recount-row is-open">
      <p class="cv-recount-unit">Finished matches</p>
      <p class="cv-frac" aria-label={`${story.counted} counted in the table, over an unknown number finished by Friday`}><span aria-hidden="true">{story.counted} counted in the table</span><span aria-hidden="true">? finished by Friday</span></p>
      <p class="cv-recount-val">{story.counted} of ?</p>
    </div>
  )}
  {!solved && <p class="cv-recount-foot">A match counts on top only if its score was found on a saved page. A match whose score is still unknown belongs only on the bottom: it was played, but it cannot be counted in the table.</p>}
</div>
