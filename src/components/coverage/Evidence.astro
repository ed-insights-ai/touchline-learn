---
interface Props {
  id: "first" | "second";
  absent: string;
  played: number;
  points: number;
  host?: number;
  members: string[];
  scored: number;
  finals: number;
  heading: string;
  hideAbsent?: boolean;
}
const { id, absent, played, points, host, members, scored, finals, heading, hideAbsent = false } = Astro.props;
const key = (k: string) => `ev-${id}-${k}`;
---

<div class="cv-evidence" data-evidence={id} data-absent={absent} data-played={played} data-points={points} data-host={host} data-scored={scored} data-finals={finals} data-teams={members.length}>
  <p class="cv-kind">Read its answer <span>you grade the assistant</span></p>
  <p class="cv-qlabel">{heading}</p>
  <div class="cv-ev-qs">
    <div class="cv-line"><label><span>Which school's own page did it say was not among the pages?</span>
      <select data-save={key("absent")}><option value="">Choose</option>{members.map((m) => <option>{m}</option>)}<option value="none">It didn't say one was missing</option></select>
    </label></div>
    <div class="cv-line"><label><span>Did it say a finished match had no score?</span>
      <select data-save={key("blank")}><option value="">Choose</option><option value="sep21">Yes, September 21</option><option value="other">Yes, a different match</option><option value="none">No, or it gave that match a score</option></select>
    </label></div>
    <div class="cv-line"><label><span>Does its table have exactly one row for each of the {members.length} members?</span>
      <select data-save={key("rows")}><option value="">Choose</option><option value="yes">Yes</option><option value="short">No, a member is missing</option><option value="extra">No, a team is doubled or a non-member is in it</option></select>
    </label></div>
    <p class="cv-row cv-fillin">
      <span>{hideAbsent ? "The member with no page (each page starts with its school's name). Its row in the table:" : `${absent}'s row in its table:`}</span>
      <input inputmode="numeric" autocomplete="off" aria-label="Played" data-save={key("played")} /><span>played,</span>
      <input inputmode="numeric" autocomplete="off" aria-label="Points" data-save={key("points")} /><span>points</span>
      <label class="cv-ev-none"><input type="checkbox" data-save={key("norow")} /><span>Not in its table</span></label>
    </p>
    <p class="cv-row cv-fillin">
      <span>It said the table counts</span>
      <input inputmode="numeric" autocomplete="off" aria-label="Matches counted" data-save={key("counted")} /><span>matches out of</span>
      <input inputmode="numeric" autocomplete="off" aria-label="Matches finished" data-save={key("finished")} /><span>finished. Leave a box blank if it didn't give that number.</span>
    </p>
  </div>
  <button type="button" data-evidence-check>Compare with the pages</button>
  <p class="cv-fb" role="status" data-evidence-need></p>
  <ul class="cv-found" data-found></ul>
  <p class="cv-fb" role="status" data-evidence-note></p>
  <slot />
</div>
