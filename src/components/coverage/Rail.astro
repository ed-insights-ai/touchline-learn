---
import { lessonForRoute, modulePageExists } from "../../lib/lessons";

const { parts, phases, slug } = lessonForRoute(Astro.locals.starlightRoute.id);
const first = parts[0];
const fieldWork = `${slug}-field-work`;
---

<nav class="cv-rail" aria-label="This module" data-rail>
  <div class="cv-rail-bar">
    <button type="button" class="cv-rail-toggle" aria-expanded="false" aria-controls="cv-rail-list" data-rail-toggle>
      <span class="cv-rail-where"><i data-rail-phase></i><b data-rail-part>{first.name}</b><span data-rail-beat></span></span>
      <span class="cv-rail-segs" aria-hidden="true">{parts.map((p, i) => <i data-rail-seg={p.id} class:list={{ "is-gap": i > 0 && parts[i - 1].phase !== p.phase }}></i>)}</span>
      <span class="cv-rail-count" data-rail-count></span>
      <span class="cv-rail-chev" aria-hidden="true"></span>
      <span class="sr-only">Show all {parts.length} parts</span>
    </button>
    <a class="cv-rail-resume" href={`#${first.id}`} data-rail-resume hidden>Resume</a>
  </div>
  <div class="cv-rail-panel" id="cv-rail-list" data-rail-panel hidden>
    <p class="cv-rail-title">This module</p>
    <div class="cv-rail-progress">
      <p><b data-rail-parts-done>0 of {parts.length}</b> parts done<span data-rail-count-long></span></p>
      <span class="cv-rail-meter" aria-hidden="true"><i data-rail-meter></i></span>
    </div>
    <p class="cv-rail-next"><span data-rail-next></span> <a href={`#${first.id}`} data-rail-resume="name" hidden></a></p>
    <ol class="cv-rail-phases">
      {phases.map((phase) => (
        <li>
          <p class="cv-rail-phase"><b>{phase.name}</b> <span>{phase.what}</span></p>
          <ol>
            {parts.filter((p) => p.phase === phase.key).map((p) => (
              <li data-rail-item={p.id} data-short={p.short} data-phase={phase.name}>
                <a href={`#${p.id}`}><i aria-hidden="true"></i><b>{p.name}</b><span>{p.what}</span><em data-rail-tally></em><span class="sr-only" data-rail-status></span></a>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
    <div class="cv-rail-tools">
      {modulePageExists(fieldWork) && <a href={`../${fieldWork}/`}>Optional field work &amp; lab</a>}
      <label><input type="checkbox" data-rail-review /><span>Review mode: show every explanation without answering first</span></label>
      <div data-reset-box>
        <button type="button" class="cv-link-btn" data-reset-ask>Reset my answers</button>
        <p class="cv-rail-confirm" data-reset-confirm hidden>
          <span>This clears every answer saved for this module in this browser.</span>
          <button type="button" class="cv-retry" data-reset>Yes, clear them</button>
          <button type="button" class="cv-link-btn" data-reset-cancel>Keep them</button>
        </p>
      </div>
    </div>
  </div>
</nav>

<script>
  document.querySelectorAll<HTMLElement>("[data-rail]").forEach((rail) => {
    const root = rail.closest<HTMLElement>("[data-coverage]")!;
    const PROGRESS = root.dataset.progressKey ?? "touchline-m1-progress";
    const REVIEW = root.dataset.reviewKey ?? "touchline-m1-review";
    const bar = rail.querySelector<HTMLElement>(".cv-rail-bar")!;
    const toggle = rail.querySelector<HTMLButtonElement>("[data-rail-toggle]")!;
    const panel = rail.querySelector<HTMLElement>("[data-rail-panel]")!;
    const resumes = [...root.querySelectorAll<HTMLAnchorElement>("[data-rail-resume]")];
    const next = rail.querySelector<HTMLElement>("[data-rail-next]")!;
    const items = [...rail.querySelectorAll<HTMLElement>("[data-rail-item]")];
    const ids = items.map((li) => li.dataset.railItem!);
    const names = Object.fromEntries(items.map((li) => [li.dataset.railItem!, li.querySelector("b")!.textContent!]));
    const shorts = Object.fromEntries(items.map((li) => [li.dataset.railItem!, li.dataset.short!]));
    const phaseOf = Object.fromEntries(items.map((li) => [li.dataset.railItem!, li.dataset.phase!]));
    const narrow = matchMedia("(max-width: 30rem)");
    const wide = matchMedia("(min-width: 64rem)");
    const sections = ids.map((id) => document.getElementById(id)).filter((s): s is HTMLElement => !!s);

    let seen: Record<string, string> = {};
    try { seen = JSON.parse(localStorage.getItem(PROGRESS) ?? "{}"); } catch {}
    const markSeen = (id: string) => {
      if (seen[`seen-${id}`]) return;
      seen[`seen-${id}`] = "1";
      try { localStorage.setItem(PROGRESS, JSON.stringify({ ...JSON.parse(localStorage.getItem(PROGRESS) ?? "{}"), [`seen-${id}`]: "1" })); } catch {}
    };

    const gatesOf = (section: HTMLElement) => [...section.querySelectorAll<HTMLElement>("[data-once], [data-commit], [data-gate]")];
    const isDone = (gate: HTMLElement) => {
      if (gate.matches("[data-gate]")) return gate.classList.contains("is-open") || !!gate.querySelector("input:checked");
      const reveal = gate.matches("[data-commit]") ? gate.querySelector(":scope > .cv-reveal") : gate.querySelector(".cv-reveal");
      return !!reveal?.classList.contains("is-open");
    };
    const headingBefore = (el: HTMLElement, section: HTMLElement) => {
      const heads = [...section.querySelectorAll<HTMLElement>("h3")].filter((h) => h.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING);
      return heads.at(-1) ?? section.querySelector<HTMLElement>("h2")!;
    };
    const beatName = (h: HTMLElement) => {
      if (h.matches("h2")) return "";
      if (h.dataset.railName) return h.dataset.railName;
      const copy = h.cloneNode(true) as HTMLElement;
      copy.querySelectorAll(".sr-only").forEach((n) => n.remove());
      if (h.classList.contains("cv-step")) copy.querySelector("span")?.remove();
      return copy.textContent!.trim();
    };

    sections.forEach((section) => {
      const beats = [...section.querySelectorAll<HTMLElement>("h3[id]")];
      if (!beats.length) return;
      const list = document.createElement("ol");
      list.className = "cv-rail-beats";
      beats.forEach((h) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = `#${h.id}`;
        a.textContent = beatName(h);
        li.append(a);
        list.append(li);
      });
      items[ids.indexOf(section.id)].append(list);
    });

    const refresh = () => {
      let total = 0, done = 0, partsDone = 0;
      let target: { section: HTMLElement; gate: HTMLElement } | null = null;
      for (const section of sections) {
        const gates = gatesOf(section);
        const finished = gates.filter(isDone).length;
        total += gates.length; done += finished;
        if (!target) { const open = gates.find((g) => !isDone(g)); if (open) target = { section, gate: open }; }
        const complete = gates.length ? finished === gates.length : !!seen[`seen-${section.id}`];
        const started = !complete && finished > 0;
        partsDone += Number(complete);
        const li = items[ids.indexOf(section.id)];
        li.classList.toggle("is-done", complete);
        li.classList.toggle("is-started", started);
        const seg = rail.querySelector(`[data-rail-seg="${section.id}"]`)!;
        seg.classList.toggle("is-done", complete);
        seg.classList.toggle("is-started", started);
        li.querySelector("[data-rail-tally]")!.textContent = gates.length ? `${finished} of ${gates.length}` : "";
        li.querySelector("[data-rail-status]")!.textContent = complete ? ", done" : started ? ", in progress" : ", not started";
      }
      rail.querySelector("[data-rail-count]")!.textContent = `${done} of ${total}`;
      rail.querySelector("[data-rail-parts-done]")!.textContent = `${partsDone} of ${sections.length}`;
      rail.querySelector("[data-rail-count-long]")!.textContent = ` · ${done} of ${total} activities`;
      rail.querySelector<HTMLElement>("[data-rail-meter]")!.style.width = `${total ? (done / total) * 100 : 0}%`;
      root.querySelectorAll<HTMLElement>("[data-progress-text]").forEach((el) => {
        el.textContent = !target ? `All ${total} activities in this module are answered.` : `${done} of ${total} activities answered so far.${done > 0 ? " Next unanswered:" : ""}`;
      });
      if (target && done > 0) {
        const { section, gate } = target;
        const head = headingBefore(gate, section);
        const beat = beatName(head);
        const label = `${names[section.id]}${beat ? `, ${beat}` : ""}`;
        const go = (event: MouseEvent) => {
          event.preventDefault();
          close();
          history.pushState(null, "", `#${section.id}`);
          const focusable = gate.querySelector<HTMLElement>("input:not(:disabled), select:not(:disabled), textarea:not(:disabled), button:not(:disabled)");
          const visible = focusable && focusable.offsetParent !== null ? focusable : null;
          head.scrollIntoView({ block: "start" });
          if (visible && visible.getBoundingClientRect().bottom > innerHeight - 24) visible.scrollIntoView({ block: "center" });
          visible?.focus({ preventScroll: true });
        };
        resumes.forEach((resume) => {
          resume.hidden = false;
          resume.href = `#${section.id}`;
          if (resume.dataset.railResume === "name") resume.textContent = label;
          else { resume.title = `Resume at ${label}`; resume.setAttribute("aria-label", resume.title); }
          resume.onclick = go;
        });
        next.textContent = "Next unanswered:";
      } else {
        resumes.forEach((resume) => { resume.hidden = true; });
        next.textContent = target ? "Nothing answered yet. Start at the top." : "Every part of this module is done.";
      }
    };

    let ticking = false;
    const where = () => {
      ticking = false;
      const top = wide.matches ? document.querySelector("header.header")?.getBoundingClientRect().bottom ?? 64 : bar.getBoundingClientRect().bottom;
      const line = top + innerHeight * 0.2;
      let current = sections[0];
      for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s;
      let beat = "", beatId = "";
      for (const h of current.querySelectorAll<HTMLElement>("h3")) if (h.offsetParent !== null && h.getBoundingClientRect().top <= line) { beat = beatName(h); beatId = h.id; }
      rail.querySelector("[data-rail-phase]")!.textContent = phaseOf[current.id];
      rail.querySelector("[data-rail-part]")!.textContent = narrow.matches ? shorts[current.id] : names[current.id];
      rail.querySelector("[data-rail-beat]")!.textContent = beat ? ` · ${beat}` : "";
      items.forEach((li) => {
        const here = li.dataset.railItem === current.id;
        li.classList.toggle("is-here", here);
        const link = li.querySelector("a")!;
        if (here) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
        li.querySelectorAll<HTMLAnchorElement>(".cv-rail-beats a").forEach((a) => a.classList.toggle("is-here", here && !!beatId && a.hash === `#${beatId}`));
      });
      rail.querySelectorAll<HTMLElement>("[data-rail-seg]").forEach((seg) => seg.classList.toggle("is-here", seg.dataset.railSeg === current.id));
      if (current.getBoundingClientRect().bottom < innerHeight) markSeen(current.id);
    };
    addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(where); } }, { passive: true });
    addEventListener("resize", where);

    const close = () => { if (wide.matches) return; panel.hidden = true; toggle.setAttribute("aria-expanded", "false"); };
    const layout = () => { panel.hidden = !wide.matches; toggle.setAttribute("aria-expanded", "false"); refresh(); where(); };
    wide.addEventListener("change", layout);
    toggle.addEventListener("click", () => {
      const open = panel.hidden;
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      if (open) refresh();
    });
    panel.addEventListener("click", (event) => { if ((event.target as HTMLElement).closest("ol a")) close(); });
    document.addEventListener("keydown", (event) => { if (event.key === "Escape" && !panel.hidden && !wide.matches) { close(); toggle.focus(); } });
    document.addEventListener("click", (event) => { if (!panel.hidden && !rail.contains(event.target as Node)) close(); });

    const review = rail.querySelector<HTMLInputElement>("[data-rail-review]")!;
    const setReview = (on: boolean) => {
      root.classList.toggle("is-review", on);
      root.querySelectorAll<HTMLElement>("[data-q][data-why]").forEach((q) => {
        const fb = q.querySelector<HTMLElement>(".cv-fb");
        if (!fb) return;
        if (on && !fb.textContent?.trim()) { fb.textContent = q.dataset.why!; fb.dataset.reviewFb = "1"; }
        else if (!on && fb.dataset.reviewFb) { fb.textContent = ""; delete fb.dataset.reviewFb; }
      });
      review.checked = on;
      try { if (on) sessionStorage.setItem(REVIEW, "1"); else sessionStorage.removeItem(REVIEW); } catch {}
    };
    try { if (sessionStorage.getItem(REVIEW)) setReview(true); } catch {}
    review.addEventListener("change", () => setReview(review.checked));

    const ask = rail.querySelector<HTMLButtonElement>("[data-reset-ask]")!;
    const confirm = rail.querySelector<HTMLElement>("[data-reset-confirm]")!;
    ask.addEventListener("click", () => { ask.hidden = true; confirm.hidden = false; confirm.querySelector<HTMLButtonElement>("[data-reset-cancel]")!.focus(); });
    confirm.querySelector<HTMLButtonElement>("[data-reset-cancel]")!.addEventListener("click", () => { confirm.hidden = true; ask.hidden = false; ask.focus(); });

    root.addEventListener("toggle", (event) => {
      const details = event.target as HTMLElement;
      const hint = details.querySelector<HTMLElement>("[data-rail-hint]")?.dataset.railHint;
      if (!hint || !(details as HTMLDetailsElement).open) return;
      const marks = [rail.querySelector<HTMLElement>(`[data-rail-seg="${hint}"]`), rail.querySelector<HTMLElement>(`[data-rail-item="${hint}"]`)];
      marks.forEach((mark) => {
        mark?.classList.remove("is-hint");
        void mark?.offsetWidth;
        mark?.classList.add("is-hint");
      });
    }, true);

    const later = () => setTimeout(refresh, 0);
    root.addEventListener("click", later);
    root.addEventListener("change", later);
    root.addEventListener("rail:refresh", later);
    requestAnimationFrame(layout);
  });
</script>
