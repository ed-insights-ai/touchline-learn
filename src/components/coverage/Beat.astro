---
import { partAt } from "../../lib/parts";

interface Props { part: string; name: "Look" | "Name it" | "What Touchline does" | "Your claim"; title: string }
const { part, name, title } = Astro.props;
const slug = name.toLowerCase().replace(/[^a-z]+/g, "-");
---

<p class="cv-beat" aria-hidden="true">{name}</p>
<h3 class="cv-beat-title" id={`${part}-${slug}`} data-rail-name={name}><span class="sr-only">{partAt(part).short}, {name}: </span>{title}</h3>
