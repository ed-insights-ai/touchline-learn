---
interface Props { steps: { text: string; stage: string }[] }
const { steps } = Astro.props;
---

<div class="cv-kplan" role="region" aria-label="Kick's build plan">
  <div class="cv-kplan-bar">
    <span class="cv-kplan-who">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1"/><path d="M8.5 10.5l1.5 1.5 3-3"/><path d="M8.5 16l1.5 1.5 3-3"/></svg>
      Kick · Plan
    </span>
    <span class="cv-kplan-meta">{steps.length} of {steps.length} done</span>
  </div>
  <ol class="cv-kplan-list">
    {steps.map((s) => (
      <li>
        <span class="cv-kplan-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span class="cv-kplan-text">{s.text}</span>
        <span class="cv-kplan-stage"><span class="sr-only">Stage: </span>{s.stage}</span>
      </li>
    ))}
  </ol>
</div>
