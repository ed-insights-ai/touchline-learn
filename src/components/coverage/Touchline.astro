---
import Beat from "./Beat.astro";
import { journeyModules } from "../../data/journey";

interface Props { part: string; at: string[]; note: string }
const { part, at, note } = Astro.props;

const steps = [...new Set(journeyModules.map((m) => m.step))].filter((s) => s !== "All steps");
const unknown = at.filter((s) => !steps.includes(s));
if (unknown.length) throw new Error(`Touchline has no step called ${unknown.join(", ")}`);
---

<Beat part={part} name="What Touchline does" />
<div class="cv-touchline">
  <div class="cv-platform">
    <ol aria-label={`Touchline's pipeline. ${note}`}>
      {steps.map((s) => <li class:list={{ "is-lit": at.includes(s) }}>{s}</li>)}
    </ol>
    <p aria-hidden="true">{note}</p>
  </div>
  <slot />
</div>
