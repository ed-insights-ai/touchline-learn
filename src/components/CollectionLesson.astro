---
import FirstRunTable from "./FirstRunTable.astro";
import { dunmorePlayed, hartwellRows, noPublishedScore, recovered, repaired, reported, run, stillToPlay, unseen } from "../lib/first-run";

type Option = { label: string; why: string; correct?: boolean };

const settle: Option[] = [
  { label: "Run it again and see if the count changes", why: "A rerun can repeat the same gap, and a new count would not tell you why it moved." },
  { label: "Open Dunmore's website now and count its games", why: "That could show the table is wrong today. It cannot show which request failed or why." },
  { label: "Compare planned pages with what happened to each", why: "Yes. A table shows what it holds. Only that comparison can show what never arrived, or was never requested.", correct: true },
];
const ninth: Option[] = [
  { label: "Add one entry to the registry", why: "Yes. The registry is configuration, so a new school needs no new collector code.", correct: true },
  { label: "Write a collector for that school", why: "That is how a pipeline ends up with a thousand scripts. Schools on the same website platform share one reader." },
  { label: "Change the loop that runs the requests", why: "The loop never names a school. It works through whatever the registry lists." },
];
const whoIsHurt: Option[] = [
  { label: "Only Dunmore", why: "Dunmore lost matches, but every match has two teams. Check who was on the other side." },
  { label: "Dunmore and every team that played there", why: "Yes. A gap at one school moves teams whose own pages arrived perfectly.", correct: true },
  { label: "Nobody, the saved pages are fine", why: "The pages are fine. The table never read the part of them that mattered here." },
];
const whichRow: Option[] = [
  { label: "Hartwell hosted the draw, so Hartwell's page supplied it", why: "Yes. The 7-0 was played at Dunmore, so the table was waiting for Dunmore's page and never got it.", correct: true },
  { label: "The table keeps close games and drops big wins", why: "The table never looks at the margin. Check who hosted each match." },
  { label: "Dunmore's page arrived in time for the first match", why: "Dunmore's page never arrived at all. Check who hosted each match." },
];
const complete: Option[] = [
  { label: "Yes, all seven are back", why: "Seven conference results are back. You have no way to know what else that page listed." },
  { label: "You cannot know until Dunmore's page arrives", why: "Right. Other schools can vouch for matches they played. They cannot tell you what you have never seen.", correct: true },
];
const reports: (Option & { text: string })[] = [
  { label: "Report A", text: "status: partial\nsaved: 19 of 20\nskipped: 1 page\nretry: next run", why: "Accurate, but a reader cannot tell which school is affected or whether their team's place can be trusted." },
  { label: "Report B", text: "status: partial\nsaved: 19 of 20\nmissing: Dunmore schedule\nretry: next run", why: "Closer. It names the page, but not why it is missing or whose results depend on it." },
  { label: "Report C", text: "status: partial\nsaved: 19 of 20\nmissing: Dunmore schedule (no answer)\naffects: Dunmore's hosted matches, all opponents\nretry: next run", why: "Yes. It names the source, the reason, who is affected and what happens next, so you can hold the table until the gap closes.", correct: true },
];
const rerun: Option[] = [
  { label: "All 20 pages, to be safe", why: "That repeats work and puts needless load on every school's site. The saved tags already show which pages are current." },
  { label: "Only Dunmore's page", why: "St. Lambert's saved copy is now out of date. Its tag will no longer match." },
  { label: "Dunmore and St. Lambert", why: "Yes. Dunmore has no saved copy, and St. Lambert's tag no longer matches. The other 18 stay as they are.", correct: true },
];
const code = `for page in registry:
    answer = ask(page, last_seen.get(page))
    if answer.unchanged:
        record(page, "unchanged")
    elif answer.ok:
        archive(page, answer.body)
        last_seen[page] = answer.tag
        record(page, "saved")
    else:
        record(page, "missing", answer.reason)`;
const payload = { reported, recovered, down: run.downIndex, changed: run.changedIndex };
const bytes = (n: number) => n.toLocaleString("en-US");
---

<script is:inline>document.documentElement.classList.add("il-js");</script>

<div class="cl not-content" data-collection>
  <noscript><p class="cl-noscript">This lesson is interactive. Turn on JavaScript to make each decision and see its feedback.</p></noscript>
  <script is:inline type="application/json" data-payload set:html={JSON.stringify(payload)}></script>

  <section class="cl-step is-open" data-step="1">
    <h2 tabindex="-1">Start with the calls Riley got</h2>
    <p>You are back at 4:52, but you have heard what this table does at 5:41.</p>
    <div class="cl-agent cl-first" data-first hidden>
      <p class="cl-who">Your question from the film</p>
      <p data-first-text></p>
    </div>
    <div class="cl-agent">
      <p class="cl-who">Coach Dolan, Hartwell <span>voicemail, 5:41</span></p>
      <p>We went into Dunmore October fifteenth and put seven on 'em. Seven-nothing. You've got us fourth.</p>
    </div>
    <div class="cl-agent">
      <p class="cl-who">Dunmore athletics <span>voicemail, 5:44</span></p>
      <p>You've got our men at six conference games. We've played thirteen.</p>
    </div>
    <p>Kick said all eight sites, no errors. Two of the three calls point at the same school, so start there and keep Cedar Grove's for later. This was Kick's first run, so it began with an empty archive. Look at the Played column.</p>
    <div data-board><FirstRunTable rows={reported} caption="Your table, as Kick delivered it" /></div>
    <div class="cl-ask" data-choice data-then="2">
      <p class="cl-q">Your table says Dunmore has played {dunmorePlayed}. Dunmore says thirteen. What evidence would tell you whether Kick missed a source page?</p>
      {settle.map((o) => <button type="button" data-why={o.why} data-correct={o.correct ? "" : undefined}>{o.label}</button>)}
      <p class="cl-feedback" role="status"></p>
    </div>
  </section>

  <section class="cl-step" data-step="2">
    <h2 tabindex="-1">Ask for the collection plan and its log</h2>
    <dl class="cl-plan">
      <div><dt>Registry</dt><dd>The list of sources to ask. Here, eight school sites. The real platform lists about a thousand.</dd></div>
      <div><dt>Unit of work</dt><dd>One conference, one gender, one season: Prairie Lakes men, 2026. Units run separately, so one can fail while the others finish.</dd></div>
    </dl>
    <p>For this unit, the sample asks for {run.total} pages: {run.schedules} school schedules and the {run.boxes} box scores linked from Alder Ridge's schedule. The fetch log keeps one line per page.</p>
    <div class="cl-grid" data-grid role="img" aria-label={`${run.total - 1} pages saved. Dunmore's schedule did not answer.`}>
      {Array.from({ length: run.total }, (_, i) => <span class={i === run.downIndex ? "is-missing" : "is-saved"}>{i === run.downIndex ? "?" : "✓"}</span>)}
    </div>
    <ul class="cl-key">
      <li><i class="is-saved">✓</i> Saved: {run.total - 1}</li>
      <li><i class="is-missing">?</i> No answer: 1</li>
    </ul>
    <p>The red square is Dunmore's schedule. The collector handled the failure and moved on, so the run ended without an error. Kick's summary left that line out.</p>
    <div class="cl-ask" data-choice data-then="3">
      <p class="cl-q">Next season a ninth school joins. With a registry in place, what has to change?</p>
      {ninth.map((o) => <button type="button" data-why={o.why} data-correct={o.correct ? "" : undefined}>{o.label}</button>)}
      <p class="cl-feedback" role="status"></p>
    </div>
  </section>

  <section class="cl-step" data-step="3">
    <h2 tabindex="-1">Work out what one missing page did</h2>
    <p>The table reads each conference match from the host school's page. So Dunmore's seven home matches never reached it.</p>
    <div class="cl-ask" data-choice data-reveal="rows">
      <p class="cl-q">Whose place in the table could be wrong?</p>
      {whoIsHurt.map((o) => <button type="button" data-why={o.why} data-correct={o.correct ? "" : undefined}>{o.label}</button>)}
      <p class="cl-feedback" role="status"></p>
    </div>
    <div class="cl-after" data-after="rows" tabindex="-1">
      <p>The visiting schools' pages did arrive, and each one lists its trip to Dunmore. Those results were saved all along. The table just never read them.</p>
      <div class="cl-ask" data-choice data-reveal="repair">
        <p class="cl-q">Hartwell Tech's saved schedule lists both Dunmore matches: {hartwellRows.counted}, and {hartwellRows.missing}. Only the first reached your table. Why did it survive?</p>
        {whichRow.map((o) => <button type="button" data-why={o.why} data-correct={o.correct ? "" : undefined}>{o.label}</button>)}
        <p class="cl-feedback" role="status"></p>
      </div>
    </div>
    <div class="cl-after" data-after="repair" tabindex="-1">
      <div data-board-slot></div>
      <button type="button" class="cl-next" data-repair>Add all seven saved results</button>
      <p class="cl-live" role="status" data-board-note></p>
    </div>
    <div class="cl-after" data-after="repaired" tabindex="-1">
      <p><strong>Hartwell Tech moves from 4th to 2nd.</strong> Their own page arrived on time. Someone else's outage cost them two places, and the run still said it worked.</p>
      <p class="cl-aside">Played still varies because {stillToPlay} conference matches are yet to be played and {noPublishedScore} final has no published score: Cedar Grove against St. Lambert on September 21, the third call. Module 6 deals with what a blank means.</p>
      <div class="cl-ask" data-choice data-then="4">
        <p class="cl-q">All seven are back. Is Dunmore's season complete now?</p>
        {complete.map((o) => <button type="button" data-why={o.why} data-correct={o.correct ? "" : undefined}>{o.label}</button>)}
        <p class="cl-feedback" role="status"></p>
      </div>
    </div>
  </section>

  <section class="cl-step" data-step="4">
    <h2 tabindex="-1">Choose what the run should have told you</h2>
    <p>All three describe the same run, and none of them lies. Which one lets you decide whether to publish?</p>
    <div class="cl-ask cl-reports" data-choice data-then="5">
      {reports.map((o) => <button type="button" data-why={o.why} data-correct={o.correct ? "" : undefined}><b>{o.label}</b><code>{o.text}</code></button>)}
      <p class="cl-feedback" role="status"></p>
    </div>
  </section>

  <section class="cl-step" data-step="5">
    <h2 tabindex="-1">Run it again and do only the new work</h2>
    <p>The next morning Dunmore answers again, and St. Lambert has changed its schedule page. The collector saved a small tag with each page, so it can ask each site: <em>has this changed since I last saw it?</em></p>
    <div class="cl-ask" data-choice data-reveal="rerun">
      <p class="cl-q">Which pages should it download?</p>
      {rerun.map((o) => <button type="button" data-why={o.why} data-correct={o.correct ? "" : undefined}>{o.label}</button>)}
      <p class="cl-feedback" role="status"></p>
    </div>
    <div class="cl-after" data-after="rerun" tabindex="-1">
      <div class="cl-grid" role="img" aria-label={`2 pages downloaded. ${run.total - 2} pages unchanged. No pages missing.`}>
        {Array.from({ length: run.total }, (_, i) => {
          const fresh = i === run.downIndex || i === run.changedIndex;
          return <span class={fresh ? "is-saved" : "is-same"}>{fresh ? "↓" : "="}</span>;
        })}
      </div>
      <ul class="cl-key">
        <li><i class="is-saved">↓</i> Downloaded: 2</li>
        <li><i class="is-same">=</i> Unchanged: {run.total - 2}</li>
      </ul>
      <p class="cl-bytes"><b>{bytes(run.rerunBytes)}</b> bytes instead of {bytes(run.allBytes)}. Across a thousand sites every day, that difference is the job.</p>
      <pre tabindex="0"><code>{code}</code></pre>
      <p>Tags decide what to fetch. The record tells people what is missing. A tag is stored only after its page is safely saved, because otherwise a failed save would look "unchanged" forever.</p>
      <p>Dunmore's page also brought something new: {unseen.length} nonconference matches that no other saved page mentions.</p>
      <ul class="cl-unseen">
        {unseen.map((m) => <li>{m.date} against {m.opponent}</li>)}
      </ul>
      <p><strong>A record can prove a page is missing. It cannot tell you what was on it.</strong> Only the page can.</p>
      <button type="button" class="cl-next" data-go="close">See what to ask next time</button>
    </div>
  </section>

  <section class="cl-close il-close" data-step="close">
    <h2 tabindex="-1">Before you trust "no errors," ask for three things</h2>
    <ol>
      <li><strong>The registry.</strong> You cannot see a gap without a list of what should be there.</li>
      <li><strong>What happened to each request.</strong> Saved, unchanged or missing, with the reason.</li>
      <li><strong>Who each gap affects.</strong> One missing page moved a team that never had a problem.</li>
    </ol>
    <p>Want the full detail? <a href="../01-collection-lab/">Read the deep dive or run the optional lab</a></p>
    <button type="button" class="cl-restart" data-restart>Start over</button>
  </section>
</div>

<style is:global>
  .cl { --cl-pitch: #0f4a33; --cl-chalk: #f4faf5; --cl-yellow: #f4c62f; --cl-red: #c5301c; color: var(--tl-ink); line-height: 1.55; }
  .cl-step, .cl-close { scroll-margin-top: 5rem; margin: 0 0 2rem; }
  .il-js .cl-step:not(.is-open), .il-js .cl-close:not(.is-open), .il-js .cl-after:not(.is-open) { display: none; }
  .cl h2 { margin: 0 0 0.6rem; color: var(--sl-color-white); font-size: clamp(1.4rem, 4.5vw, 1.75rem); line-height: 1.2; font-weight: 750; text-wrap: balance; }
  .cl h2:focus, .cl-after:focus, .cl-bytes:focus { outline: none; }
  .cl p { margin: 0 0 0.75rem; }
  .cl-noscript { padding: 0.75rem 1rem; border-left: 3px solid var(--cl-yellow); }
  .cl-agent { margin: 0 0 1rem; padding: 0.85rem 1rem; border-left: 3px solid var(--sl-color-accent); background: var(--tl-card); }
  .cl-agent p:last-child { margin-bottom: 0; }
  .cl-first { border-left-color: #f4c62f; }
  .cl-who { margin-bottom: 0.2rem !important; font-size: 0.85rem; font-weight: 700; }
  .cl-who span { margin-left: 0.4rem; color: var(--tl-muted); font-weight: 400; }
  .cl-plan { display: grid; gap: 0.5rem; margin: 0 0 0.9rem; }
  .cl-plan div { padding: 0.65rem 0.85rem; border-left: 3px solid var(--tl-muted); background: var(--tl-card); }
  .cl-plan dt { color: var(--sl-color-white); font-weight: 700; }
  .cl-plan dd { margin: 0; }
  .cl-ask { display: grid; gap: 0.45rem; margin-top: 0.5rem; }
  .cl-q { margin-bottom: 0.2rem !important; color: var(--sl-color-white); font-weight: 700; }
  .cl button { min-height: 44px; padding: 0.55rem 0.85rem; border: 1px solid var(--tl-muted); border-radius: 3px; background: var(--tl-card); color: var(--tl-ink); font: inherit; text-align: left; cursor: pointer; }
  .cl button:hover:not(:disabled) { border-color: var(--sl-color-accent); }
  .cl button:focus-visible, .cl a:focus-visible, .cl pre:focus-visible { outline: 3px solid var(--sl-color-accent); outline-offset: 2px; }
  .cl-ask button.is-wrong { border-color: var(--cl-red); box-shadow: inset 4px 0 0 var(--cl-red); }
  .cl-ask button.is-right { border-color: var(--sl-color-accent); box-shadow: inset 4px 0 0 var(--sl-color-accent); }
  .cl button:disabled { cursor: default; color: var(--tl-ink); }
  .cl-ask.is-answered button:disabled:not(.is-right) { opacity: 0.6; }
  .cl-feedback { margin: 0 !important; }
  .cl-feedback:not(:empty) { margin-top: 0.25rem !important; padding: 0.5rem 0.75rem; border-left: 3px solid var(--tl-muted); background: var(--tl-card); }
  .cl-live { margin: 0 !important; }
  .cl-live:not(:empty) { margin-top: 0.5rem !important; }
  .cl-grid { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 4px; max-width: 26rem; margin: 0 0 0.6rem; }
  .cl-grid span, .cl-key i { display: grid; place-items: center; font-style: normal; font-weight: 700; line-height: 1; }
  .cl-grid span { aspect-ratio: 1; font-size: 0.85rem; }
  .cl .is-saved { background: #1f7a45; color: #fff; }
  .cl .is-missing { background: var(--cl-red); color: #fff; }
  .cl .is-same { background: transparent; box-shadow: inset 0 0 0 1px var(--tl-muted); color: var(--tl-muted); }
  .cl-key { display: flex; flex-wrap: wrap; gap: 0.3rem 1.1rem; margin: 0 0 0.9rem; padding: 0; list-style: none; font-size: 0.9rem; }
  .cl-key li { display: flex; align-items: center; gap: 0.35rem; margin: 0; }
  .cl-key i { width: 1.15rem; height: 1.15rem; font-size: 0.72rem; }
  .cl-after { margin-top: 1rem; scroll-margin-top: 5rem; }
  .cl-aside { color: var(--tl-muted); font-size: 0.92rem; }
  .cl-unseen { margin: 0 0 0.75rem; padding-left: 1.2rem; }
  .cl-unseen li { margin: 0.1rem 0; }
  .cl .cl-next { background: var(--sl-color-accent); border-color: var(--sl-color-accent); color: var(--sl-color-black); font-weight: 700; }
  :root[data-theme="light"] .cl .cl-next { color: #fff; }
  .cl .cl-next[hidden] { display: none; }
  .cl-reports button { display: grid; gap: 0.3rem; }
  .cl-reports code { display: block; padding: 0; background: none; font-size: 0.85rem; white-space: pre-wrap; overflow-wrap: anywhere; }
  .cl-bytes b { color: var(--sl-color-accent); font-size: 1.5rem; }
  .cl pre { margin: 0 0 0.85rem; padding: 0.8rem; overflow-x: auto; background: var(--tl-card); border: 1px solid var(--tl-line); font-size: 0.82rem; }
  .cl pre code { padding: 0; background: none; }
  .cl-close { padding: 1.1rem; color: var(--cl-chalk); background: var(--cl-pitch); }
  .cl-close h2 { color: var(--cl-chalk); font-size: 1.25rem; }
  .cl-close ol { margin: 0.5rem 0 0.8rem; padding-left: 1.25rem; }
  .cl-close li { margin-bottom: 0.45rem; }
  .cl-close a { display: inline-flex; align-items: center; min-height: 44px; color: var(--cl-yellow); }
  .cl-close a:focus-visible, .cl .cl-restart:focus-visible { outline-color: var(--cl-yellow); }
  .cl .cl-restart { border-color: var(--cl-chalk); background: transparent; color: var(--cl-chalk); }
  @media (max-width: 30rem) {
    .cl .fr-table th, .cl .fr-table td { padding: 0.4rem 0.3rem; font-size: 0.9rem; }
  }
</style>

<script>
  type Row = { slug: string; name: string; p: number; gf: number; ga: number; pts: number };
  type Result = { slug: string; gf: number; ga: number };

  document.querySelectorAll<HTMLElement>("[data-collection]").forEach((root) => {
    const data = JSON.parse(root.querySelector("[data-payload]")!.textContent!) as { reported: Row[]; recovered: Result[] };
    const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const behavior: ScrollBehavior = calm ? "auto" : "smooth";
    const board = root.querySelector<HTMLElement>("[data-board]")!;
    const state = new Map(data.reported.map((r) => [r.slug, { ...r }]));
    let rows: HTMLElement;

    const openStep = (key: string) => {
      const section = root.querySelector<HTMLElement>(`[data-step="${key}"]`)!;
      section.classList.add("is-open");
      section.querySelector("h2")!.focus({ preventScroll: true });
      section.scrollIntoView({ behavior, block: "start" });
    };

    const moveBoard = () => {
      const live = board.cloneNode(true) as HTMLElement;
      live.removeAttribute("data-board");
      live.querySelector("caption")!.textContent = "Your table, being repaired";
      root.querySelector("[data-board-slot]")!.append(live);
      rows = live.querySelector<HTMLElement>("[data-rows]")!;
      board.querySelector("[data-rows]")!.removeAttribute("data-rows");
      board.querySelectorAll("[data-team]").forEach((tr) => tr.removeAttribute("data-team"));
    };

    const reveal = (key: string, keyboard: boolean) => {
      const after = root.querySelector<HTMLElement>(`[data-after="${key}"]`)!;
      if (key === "repair") moveBoard();
      after.classList.add("is-open");
      if (keyboard) after.focus({ preventScroll: true });
      after.scrollIntoView({ behavior, block: "nearest" });
    };

    root.querySelectorAll<HTMLElement>("[data-choice]").forEach((group) => {
      const feedback = group.querySelector<HTMLElement>(".cl-feedback")!;
      const buttons = [...group.querySelectorAll<HTMLButtonElement>(":scope > button")];
      buttons.forEach((button) => button.addEventListener("click", (event) => {
        feedback.textContent = button.dataset.why!;
        const keyboard = event.detail === 0;
        if (button.dataset.correct === undefined) {
          button.classList.add("is-wrong");
          return;
        }
        button.classList.remove("is-wrong");
        button.classList.add("is-right");
        group.classList.add("is-answered");
        buttons.forEach((b) => { b.disabled = true; });
        if (group.dataset.reveal) {
          reveal(group.dataset.reveal, keyboard);
          return;
        }
        const proceed = document.createElement("button");
        proceed.type = "button";
        proceed.className = "cl-next";
        proceed.textContent = "Continue";
        proceed.addEventListener("click", () => { proceed.hidden = true; openStep(group.dataset.then!); });
        group.append(proceed);
        proceed.scrollIntoView({ behavior, block: "nearest" });
        if (keyboard) setTimeout(() => proceed.focus({ preventScroll: true }), 120);
      }));
    });

    const render = () => {
      const sorted = [...state.values()].sort((a, b) => b.pts - a.pts || (b.gf - b.ga) - (a.gf - a.ga) || a.slug.localeCompare(b.slug));
      const before = new Map([...rows.children].map((el) => [el as HTMLElement, el.getBoundingClientRect().top]));
      sorted.forEach((r, i) => {
        const tr = rows.querySelector<HTMLElement>(`[data-team="${r.slug}"]`)!;
        const gd = r.gf - r.ga;
        tr.querySelector("[data-rank]")!.textContent = String(i + 1);
        tr.querySelector("[data-p]")!.textContent = String(r.p);
        tr.querySelector("[data-gd]")!.textContent = gd > 0 ? `+${gd}` : String(gd);
        tr.querySelector("[data-pts]")!.textContent = String(r.pts);
        tr.classList.add("is-new");
        tr.classList.toggle("is-watch", r.slug === "hartwell-tech");
        rows.append(tr);
      });
      if (calm) return;
      before.forEach((top, el) => {
        const delta = top - el.getBoundingClientRect().top;
        if (delta) el.animate([{ transform: `translateY(${delta}px)` }, { transform: "none" }], { duration: 420, easing: "ease-out" });
      });
    };

    const apply = (slug: string, gf: number, ga: number) => {
      const r = state.get(slug)!;
      r.p += 1; r.gf += gf; r.ga += ga; r.pts += gf > ga ? 3 : gf === ga ? 1 : 0;
    };

    root.querySelector<HTMLButtonElement>("[data-repair]")!.addEventListener("click", (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const keyboard = event.detail === 0;
      data.recovered.forEach((m) => { apply("dunmore", m.gf, m.ga); apply(m.slug, m.ga, m.gf); });
      render();
      button.hidden = true;
      root.querySelector("[data-board-note]")!.textContent = "Seven results added. Hartwell Tech is now 2nd.";
      setTimeout(() => reveal("repaired", keyboard), calm ? 0 : 480);
    });

    root.querySelectorAll<HTMLButtonElement>("[data-go]").forEach((button) => {
      button.addEventListener("click", () => { button.hidden = true; openStep(button.dataset.go!); });
    });

    root.querySelector<HTMLButtonElement>("[data-restart]")!.addEventListener("click", () => {
      history.scrollRestoration = "manual";
      scrollTo(0, 0);
      location.reload();
    });
  });
</script>

<script>
  try {
    const first = localStorage.getItem("touchline-first-ask");
    const card = document.querySelector<HTMLElement>("[data-collection] [data-first]");
    if (first && card) {
      card.querySelector<HTMLElement>("[data-first-text]")!.textContent = first;
      card.hidden = false;
    }
  } catch {}
</script>
