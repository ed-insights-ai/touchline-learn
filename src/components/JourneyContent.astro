---
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
import { journeyModules } from "../data/journey";

const id = Astro.locals.starlightRoute.id.replace(/\.mdx?$/, "");
const index = journeyModules.findIndex((m) => `modules/${m.slug}` === id);
const current = index >= 0 ? journeyModules[index] : undefined;
const next = index >= 0 ? journeyModules[index + 1] : undefined;
const hasOwnFlow = current?.slug === "01-collection";
---

{current && (
  <div class="jc-top not-content">
    <ul class="jc-meta" aria-label="Course position">
      <li class="jc-badge">Module {current.n} of {journeyModules.length}</li>
      <li>Part {current.partNumber} · {current.part.title}</li>
      <li>{current.step === "All steps" ? "All pipeline steps" : `Step: ${current.step}`}</li>
    </ul>
    <p class="jc-question">{current.question}</p>
    {!hasOwnFlow && (
      <div class="jc-progress" role="img" aria-label={`Module ${current.n} of ${journeyModules.length}`}>
        {journeyModules.map((m) => <span class:list={{ now: m.n === current.n, gap: m.n > 1 && m.partNumber !== journeyModules[m.n - 2].partNumber }}></span>)}
      </div>
    )}
  </div>
)}

<Default><slot /></Default>

{current && !hasOwnFlow && (
  <aside class="jc-next not-content" aria-label="Where this leads">
    <p class="jc-gained">{current.gained}</p>
    <p class="jc-agent"><span>Now you can ask the agent:</span> “{current.ask}”</p>
    <p>{current.bridge}</p>
    {next ? (
      <>
        <p class="jc-ask">Next question: {next.question}</p>
        <a href={`../${next.slug}/`}>Continue to Module {next.n}: {next.name}</a>
      </>
    ) : (
      <a href="../../finish/back-to-the-agent/">Answer the agent</a>
    )}
  </aside>
)}

{next && !hasOwnFlow && <a class="jc-skip not-content" href={`../${next.slug}/`}>Skip to Module {next.n}</a>}

<style is:global>
  .jc-top { margin: 0.5rem 0 1.25rem; }
  .jc-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.65rem; margin: 0 0 1rem; padding: 0; list-style: none; color: var(--tl-muted); font-size: 0.84rem; font-weight: 500; }
  .jc-meta li { margin: 0; display: inline-flex; align-items: center; }
  .jc-meta li:not(:first-child):not(:nth-child(2))::before { content: "·"; margin-right: 0.65rem; color: var(--tl-line); font-weight: 700; }
  .jc-badge { padding: 0.14rem 0.55rem; border: 1px solid var(--tl-line); border-radius: 999px; background: var(--tl-card); color: var(--sl-color-accent-high); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.01em; }
  .jc-question { margin: 0 0 0.9rem; color: var(--sl-color-white); font-size: 1.18rem; font-weight: 700; line-height: 1.3; }
  .jc-progress { display: flex; gap: 3px; }
  .jc-progress span { flex: 1; height: 5px; background: var(--tl-line); }
  .jc-progress span.now { background: var(--sl-color-accent); }
  .jc-progress span.gap { margin-left: 6px; }
  .il-js .sl-markdown-content:has(.il-close:not(.is-open)) ~ .jc-next { display: none; }
  .jc-skip { display: none; }
  .il-js .sl-markdown-content:has(.il-close:not(.is-open)) ~ .jc-skip { display: inline-flex; align-items: center; min-height: 44px; margin-top: 1rem; color: var(--tl-muted); font-size: 0.9rem; }
  .jc-agent { padding: 0.45rem 0.65rem; background: var(--tl-bg); font-weight: 600; }
  .jc-agent span { display: block; color: var(--tl-muted); font-size: 0.82rem; font-weight: 500; }
  body:has(.jc-next) .pagination-links a[rel="next"],
  body:has(.cv-core) .pagination-links a[rel="next"] { display: none; }
  .jc-next { margin-top: 2.5rem; padding: 1rem 1.1rem; border-left: 3px solid var(--sl-color-accent); background: var(--tl-card); }
  .jc-next p { margin: 0 0 0.45rem; }
  .jc-gained { color: var(--tl-ink); }
  .jc-ask { color: var(--sl-color-white); font-weight: 700; }
  .jc-next a { display: inline-flex; align-items: center; min-height: 44px; margin-top: 0.25rem; padding: 0.5rem 1rem; border-radius: 3px; background: var(--sl-color-accent); color: var(--sl-color-black); font-weight: 700; text-decoration: none; }
  :root[data-theme="light"] .jc-next a { color: #fff; }
  .jc-next a:focus-visible { outline: 3px solid var(--sl-color-white); outline-offset: 2px; }
</style>
