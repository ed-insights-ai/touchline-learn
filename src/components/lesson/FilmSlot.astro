---
import { filmExists } from "../../lib/lessons";

interface Props { name: string; label: string; caption: string }
const { name, label, caption } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const src = (file: string) => `${base}film/${file}`;
const has = (suffix: string) => filmExists(`${name}${suffix}`);
---

{has(".mp4") && (
  <figure class="cv-film">
    <video controls playsinline preload="metadata" poster={has(".jpg") ? src(`${name}.jpg`) : undefined} aria-label={label}>
      <source src={src(`${name}.mp4`)} type="video/mp4" />
      {has(".vtt") && <track kind="captions" src={src(`${name}.vtt`)} srclang="en" label="English" default />}
      {has("-chapters.vtt") && <track kind="chapters" src={src(`${name}-chapters.vtt`)} srclang="en" label="Chapters" />}
    </video>
    <figcaption>{caption}</figcaption>
  </figure>
)}
