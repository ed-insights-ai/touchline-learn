---
import PartHead from "../coverage/PartHead.astro";
import NextPart from "../coverage/NextPart.astro";
import Check from "../lesson/Check.astro";
import Choice from "../lesson/Choice.astro";
import AiCard from "./AiCard.astro";
import { labelsOf, refetchPredict } from "../../lib/archive-state";
import { fridayPages, rewind, tuesdayManifest, tuesdayPages, policies, prediction, rowChanges, saturday, tableA, tableC, type Column } from "../../lib/archive";
import { spell } from "../../lib/cases";
import { monthDay } from "../../lib/us-dates";

const resolved = ({ "name-only": "name", "name-and-numbers": "numbers" } as Record<string, string>)[prediction.answer];
if (resolved !== "numbers" || !refetchPredict.options.some(([v]) => v === resolved)) throw new Error(`The decision's copy says the re-fetch changed the name and the numbers; it now gives ${prediction.answer}`);
const others = refetchPredict.options.map(([v]) => v).filter((v) => v !== resolved && v !== "unknown").join("|");

const lambert = rowChanges.C.find((r) => r.slug === "st-lambert")!;
const rowOf = (rows: typeof tableA.rows) => rows.find((r) => r.slug === "st-lambert")!;
const before = rowOf(tableA.rows);
const after = rowOf(tableC.rows);
const cols: [Column, string][] = [["name", "Team"], ["p", "P"], ["w", "W"], ["d", "D"], ["l", "L"], ["gf", "GF"], ["ga", "GA"], ["gd", "GD"], ["pts", "Pts"]];
const head = Object.fromEntries(cols);
const change = (c: Column) => `${head[c]} ${before[c]} → ${after[c]}`;
const byPages = lambert.columns.filter((c) => c !== "name").map(change);
const sites = spell(tuesdayManifest.pages.filter((p) => p.kind === "schedule").length);
const lambertWin = saturday.find((s) => s.home === "st-lambert" || s.away === "st-lambert")!;
const saturdayShort = monthDay(lambertWin.date).replace(/^(\w{3})\w*/, "$1");
const seven = spell(fridayPages.length);
if (rewind.unavailable.map((u) => u.slug).join() !== tuesdayManifest.unavailable.join()) throw new Error("Tuesday's unavailable sites are not Friday's");
const down = rewind.unavailable.map((u) => u.name).join(" and ");
if (tuesdayPages.map((p) => p.slug).sort().join() !== fridayPages.map((p) => p.slug).sort().join()) throw new Error("Tuesday's capture no longer reads the same pages as Friday's");

const day = (iso: string) => new Date(iso).toLocaleString("en-US", { weekday: "short", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "UTC" });
const harbor = { friday: fridayPages.find((p) => p.slug === "harbor-point")!, tuesday: tuesdayPages.find((p) => p.slug === "harbor-point")! };
const cell = (text: string) => (text === "" ? "blank" : text);
const changed = policies.changedSinceFriday;
const same = policies.unchangedSinceFriday;
const names = (list: { name: string }[]) => list.map((x) => x.name).join(" and ");
if (harbor.friday.sha256 === harbor.tuesday.sha256) throw new Error("Harbor Point's page no longer changed between Friday and Tuesday");

const cedar = { friday: fridayPages.find((p) => p.slug === "cedar-grove")!, tuesday: tuesdayPages.find((p) => p.slug === "cedar-grove")! };
const cedarSame = same.some((x) => x.slug === "cedar-grove") && cedar.friday.sha256 === cedar.tuesday.sha256;
const verdict = (q: "today" | "monday" | "cedar") => {
  const l = q === "cedar" ? cedarSame : policies.latest[q];
  const e = q === "cedar" ? true : policies.every[q];
  return l && e ? "both" : e ? "every" : l ? "latest" : "neither";
};
const who: [string, string][] = [["both", "Both policies"], ["latest", "Latest only"], ["every", "Every capture only"], ["neither", "Neither policy"]];
const cedarHash = cedar.friday.sha256.slice(0, 12);
const questions = [
  { key: "today", label: "Tell a reader what the table says today.",
    why: "Both policies. Today's table needs only the newest captures, and both archives hold Tuesday's.",
    wrong: { latest: "Every capture holds Tuesday's captures too, beside Friday's.", every: "Latest only keeps one capture per page: the newest. That is the one today's table needs.", neither: "Both archives hold Tuesday's pages. That is what a re-fetch saves." } },
  { key: "monday", label: "Rebuild Monday's table exactly, from its pages.",
    why: `Every capture only. Monday's table read Friday's ${seven} captures. Latest only replaced them on Tuesday, and ${spell(changed.length)} had changed, so their Friday bytes are gone.`,
    wrong: { latest: `Latest only replaced Friday's captures on Tuesday. Every capture still holds them.`, both: `Latest only now holds Tuesday's pages. ${spell(changed.length, true)} of them differ from Friday's, so it no longer has the full set Monday's table read.`, neither: `Every capture still holds Friday's ${seven} captures, each beside Tuesday's.` } },
  { key: "cedar", label: "Show a coach the exact Cedar Grove page Monday's table read.",
    why: `Both policies. Cedar Grove's page hadn't changed, so Tuesday's capture has the hash Friday's manifest recorded, ${cedarHash}. Even latest only holds the exact bytes, and the hash verifies them.`,
    wrong: { latest: "Every capture holds Friday's capture of Cedar Grove too.", every: `Latest only holds Tuesday's capture, and its hash is the one Friday's manifest recorded, ${cedarHash}: the same bytes.`, neither: "Both archives hold a capture whose hash matches Friday's manifest." } },
] as const;
const grid = questions.map((q) => ({ ...q, answer: verdict(q.key) }));
if (grid.map((q) => q.answer).join() !== "both,every,both") throw new Error("The policy answers changed; rewrite The decision's explanations");

const calls = [
  { key: "hashes", text: "Latest only, with each capture's content hash recorded in the run's manifest" },
  { key: "season", text: "Every capture until the season closes, then only the captures the final table's manifest names" },
  { key: "recent", text: "Every capture from the last month, then only the latest of each page" },
];
---

<section id="decision" class="ar-part">
  <PartHead id="decision">The decision: what a re-fetch would have cost</PartHead>
  <p>In Setup you predicted what Kick's re-fetch would do to St. Lambert's row.</p>
  <div class="cv-say cv-yours">
    <p class="cv-who">Your prediction from Setup</p>
    <p data-when={refetchPredict.key} hidden><span data-show={refetchPredict.key} data-show-labels={labelsOf(refetchPredict)}></span></p>
    <p data-when={refetchPredict.key} data-is="" hidden>You skipped it. It is still there in Setup.</p>
  </div>
  <p><strong>“Can't tell” was the justified answer on Tuesday.</strong> A re-fetch reads each site as it is now. Only the name would change if it read the same set of pages with the same evidence for this row: no result posted or changed since Friday, and {down} still silent, since its page would be new evidence too. Nothing on screen said whether that held. A replay's pages are Friday's, byte for byte.</p>
  <p class="ar-yours" data-when={refetchPredict.key} data-is={resolved} hidden>You picked what the re-fetch does. On Tuesday that was a guess about the live sites.</p>
  <p class="ar-yours" data-when={refetchPredict.key} data-is="unknown" hidden>You picked the only answer Tuesday's evidence supported.</p>
  <p class="ar-yours" data-when={refetchPredict.key} data-is={others} hidden>That holds only if the re-fetch reads the same pages with the same evidence. {spell(changed.length, true)} pages had changed, and one of them posted a result this row counts.</p>

  <p>In the sample, Tuesday's capture (Case 1) read the same {seven} pages, with {down} still unavailable. But on Saturday {lambertWin.homeName} beat {lambertWin.awayName} {lambertWin.home_score}–{lambertWin.away_score}, a conference match, and St. Lambert's site had posted it. So the re-fetch changes {spell(lambert.columns.length)} cells of one row, for two reasons: the replay changed only the name, so the rest are the pages'.</p>
  <div class="cv-scroll">
    <table class="cv-log ar-row">
      <caption>St. Lambert's row, Tuesday's table and the re-fetch</caption>
      <thead><tr><th scope="col"></th>{cols.map(([, h]) => <th scope="col">{h}</th>)}</tr></thead>
      <tbody>
        <tr><th scope="row">Tuesday's table</th>{cols.map(([c]) => <td>{before[c]}</td>)}</tr>
        <tr><th scope="row">Re-fetch</th>{cols.map(([c]) => <td class:list={{ "is-code": lambert.columns.includes(c) && c === "name", "is-pages": lambert.columns.includes(c) && c !== "name" }}>{after[c]}</td>)}</tr>
      </tbody>
    </table>
  </div>
  <table class="cv-log ar-changes">
    <caption>St. Lambert's changed cells</caption>
    <thead><tr><th scope="col">Cell</th><th scope="col">Tuesday</th><th scope="col">Re-fetch</th><th scope="col">Changed by</th></tr></thead>
    <tbody>{lambert.columns.map((c) => <tr><th scope="row">{head[c]}</th><td>{before[c]}</td><td class:list={{ "is-code": c === "name", "is-pages": c !== "name" }}>{after[c]}</td><td>{c === "name" ? "the code" : "the pages"}</td></tr>)}</tbody>
  </table>
  <p class="ar-key"><span><span class="ar-swatch is-code"></span><span><b>Changed by the code:</b> the name</span></span><span><span class="ar-swatch is-pages"></span><span><b>Changed by the pages:</b> {spell(byPages.length)} numbers</span></span></p>

  <h3 id="decision-policies">Two archive policies</h3>
  <p>Every table here is <code>table = build(parse(saved pages, parser code, config))</code>. A run's <strong>capture manifest</strong> lists every page it asked for, each saved one by its content hash, each missing one named. Suppose every run has one, and its parser, build code and config are in version control. One question is left: how long are the pages kept?</p>
  <div class="cv-twins cv-two">
    <div>
      <h4>Latest only</h4>
      <p>One capture per page, with its fetch time. A new fetch of the page overwrites it.</p>
      <p><b>Can rebuild:</b> a table from the pages as they were last fetched.</p>
      <p><b>Cannot rebuild:</b> a table that read a capture since replaced by a changed one.</p>
    </div>
    <div>
      <h4>Every capture</h4>
      <p>Each fetch is stored beside the last, with its fetch time. Nothing is overwritten.</p>
      <p><b>Can rebuild:</b> every past table, from the captures its manifest names.</p>
      <p><b>Costs:</b> storage that grows with every run, much of it unchanged pages.</p>
    </div>
  </div>
  <p>Either way, a manifest's hash can verify a capture still held, but can't bring back one that is gone. A policy can also change with time: every capture while a table can still be questioned, less once it can't.</p>

  <p>Suppose Riley hadn't stopped Kick, and Tuesday's re-fetch had gone into the archive: all {sites} sites asked again, {seven} pages saved, {down} still unavailable. {spell(changed.length, true)} of the {seven} pages had changed since Friday, Harbor Point's among them; {names(same)} had not. Which archive can still do each task?</p>
  <Check once="decide-policies" kind="Prediction" note={`Answer all ${spell(grid.length)}, then check.`}>
    {grid.map((q) => <Choice save={`decide-${q.key}`} label={q.label} options={who} answer={q.answer} why={q.why} wrong={q.wrong} />)}
    <Fragment slot="reveal">
      <figure class="ar-shelf" aria-label={`Harbor Point's schedule page in each archive after a Tuesday re-fetch. Latest only holds Tuesday's capture, ${saturdayShort} ${cell(policies.harborCell.tuesday)}; Friday's was overwritten. Every capture holds Friday's, ${saturdayShort} ${cell(policies.harborCell.friday)}, and Tuesday's.`}>
        <figcaption>Harbor Point's schedule page in each archive, after a re-fetch on Tuesday</figcaption>
        <div class="ar-lane">
          <p class="ar-lane-name">Latest only</p>
          <div class="ar-caps">
            <div class="ar-cap is-gone" aria-hidden="true"><b>{day(harbor.friday.fetchedAt)}</b><span class="cv-mono">{harbor.friday.sha256.slice(0, 12)}</span><span>overwritten</span></div>
            <div class="ar-cap"><b>{day(harbor.tuesday.fetchedAt)}</b><span class="cv-mono">{harbor.tuesday.sha256.slice(0, 12)}</span><span>{saturdayShort}: {cell(policies.harborCell.tuesday)}</span></div>
          </div>
        </div>
        <div class="ar-lane">
          <p class="ar-lane-name">Every capture</p>
          <div class="ar-caps">
            <div class="ar-cap"><b>{day(harbor.friday.fetchedAt)}</b><span class="cv-mono">{harbor.friday.sha256.slice(0, 12)}</span><span>{saturdayShort}: {cell(policies.harborCell.friday)}</span></div>
            <div class="ar-cap"><b>{day(harbor.tuesday.fetchedAt)}</b><span class="cv-mono">{harbor.tuesday.sha256.slice(0, 12)}</span><span>{saturdayShort}: {cell(policies.harborCell.tuesday)}</span></div>
          </div>
        </div>
      </figure>
      <p class="cv-label">Fetch times and hashes are the sample's; the overwrite is simulated.</p>
      <p>Harbor Point's page had changed: latest only holds {harbor.tuesday.sha256.slice(0, 12)}, with “{policies.harborCell.tuesday}” in the {saturdayShort} cell, and the manifest's {harbor.friday.sha256.slice(0, 12)} can only show that Friday's page is gone.</p>
      <p class="cv-rule">A recorded hash can verify that an unchanged page is identical. It can never recover a page that changed.</p>
    </Fragment>
  </Check>

  <h3 id="decision-touchline">What Touchline keeps</h3>
  <div class="cv-touchline">
    <p>Touchline keeps latest only, with each capture's fetch time. Monday's table could be rebuilt on Tuesday only because nothing had fetched those {seven} pages since Friday; Kick's “Re-fetching!” would have replaced all {seven}. So a parser change re-reads the archive and never fetches, and a re-fetch is a separate, deliberate act.</p>
    <p>That is latest only's real cost: a published table stays rebuildable only until the next routine run captures a changed page. A table that may be disputed needs every capture its manifest names kept for as long as it can be questioned. <a href="../02-archive-field-work/?from=decision#retention">The field work</a> measures what that costs.</p>
  </div>

  <AiCard part="decision" />

  <h3 id="decision-your-call">Your call: the conference office</h3>
  <p>The conference office publishes the standings every week of a season that runs for months. Until the season closes, a coach can dispute any week's table, and the office must then show the pages that table was built from. After that, only the final table is ever questioned. The office's storage holds one season of every capture; older seasons must fit in far less.</p>
  <Check once="decide-call" kind="Your call" note="Pick one policy, then check." button="Check answer">
    <Choice radio save="decide-call" label="Which archive policy should the office run?" options={calls.map((c) => [c.key, c.text])} answer="season"
      why="Every capture until the season closes, then the final table's. A dispute about an early week needs the pages that week's table read, which later fetches will have replaced. Once disputes close, only the final table is questioned, and its manifest names its captures."
      wrong={{ hashes: "A hash verifies that a page is unchanged. For a page that has changed since, it shows only that the old page was different, not what it said.", recent: "A coach can dispute any week until the season closes, the first week included. A month's window has already lost the pages the early weeks' tables read." }} />
    <p slot="reveal">The policy follows from the questions the archive must answer, and for how long.</p>
  </Check>

  <NextPart from="decision">Riley's question asks for the right thing. What would Riley need to see?</NextPart>
</section>

<style>
  .ar-part :global(.cv-line select) { width: 100%; max-width: 30rem; }
  .ar-part :global(.cv-line > label.cv-stack) { grid-template-columns: minmax(0, 1fr); }
  .ar-part :global(fieldset.cv-line > label) { display: flex; flex-wrap: nowrap; align-items: flex-start; margin-right: 0; }
  .ar-part :global(fieldset.cv-line > label > span) { flex: 1 1 0; min-width: 0; }
  .ar-part :global(fieldset.cv-line > label > input) { flex: none; margin-top: 0.3rem; }
  .ar-yours { margin-top: -0.25rem; padding-left: 1rem; border-left: 3px solid var(--cv-yellow); }
  .ar-row { max-width: 40rem; }
  .ar-changes { display: none; }
  .ar-row td, .ar-row th { white-space: nowrap; }
  .ar-row td.is-code, .ar-swatch.is-code { background: color-mix(in srgb, var(--sl-color-accent) 28%, transparent); }
  .ar-row td.is-pages, .ar-swatch.is-pages { background: color-mix(in srgb, var(--cv-yellow) 30%, transparent); }
  .ar-key { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin-top: -0.5rem; color: var(--tl-muted); font-size: 0.85rem; }
  .ar-key > span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .ar-swatch { display: inline-block; width: 0.9rem; height: 0.9rem; border-radius: 2px; }
  .ar-shelf { display: grid; gap: 0.6rem; margin: 0 0 0.5rem; padding: 0.9rem 1rem; border: 1px solid var(--tl-line); border-radius: 8px; background: var(--tl-card); }
  .ar-shelf figcaption { color: var(--sl-color-white); font-weight: 700; }
  .ar-lane { display: grid; grid-template-columns: 8.5rem 1fr; align-items: center; gap: 0.5rem 0.75rem; }
  .ar-lane-name { margin: 0; font-weight: 700; }
  .ar-caps { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ar-cap { display: grid; gap: 0.1rem; min-width: 11rem; padding: 0.45rem 0.7rem; border: 2px solid var(--sl-color-accent); border-radius: 6px; background: var(--tl-bg); font-size: 0.88rem; line-height: 1.35; }
  .ar-cap b { color: var(--sl-color-white); }
  .ar-cap.is-gone { border: 2px dashed var(--cv-red); opacity: 0.75; }
  .ar-cap.is-gone b, .ar-cap.is-gone .cv-mono { text-decoration: line-through; }
  .ar-cap.is-gone span:last-child { color: var(--cv-red); font-weight: 700; }
  @media (max-width: 32rem) { .ar-lane { grid-template-columns: 1fr; } .ar-cap { min-width: 0; flex: 1 1 9rem; } }
  @media (max-width: 32rem) { .cv-scroll:has(.ar-row), .ar-key { display: none; } .ar-changes { display: table; } .ar-changes td.is-code { background: color-mix(in srgb, var(--sl-color-accent) 28%, transparent); } .ar-changes td.is-pages { background: color-mix(in srgb, var(--cv-yellow) 30%, transparent); } }
</style>
