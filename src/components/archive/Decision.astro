---
import PartHead from "../coverage/PartHead.astro";
import NextPart from "../coverage/NextPart.astro";
import Check from "../lesson/Check.astro";
import Choice from "../lesson/Choice.astro";
import AiCard from "./AiCard.astro";
import { labelsOf, refetchPredict } from "../../lib/archive-state";
import { fridayPages, rewind, tuesdayManifest, tuesdayPages, policies, prediction, rowChanges, saturday, tableA, tableC, type Column } from "../../lib/archive";
import { spell } from "../../lib/cases";

const resolved = ({ "name-only": "name", "name-and-numbers": "numbers" } as Record<string, string>)[prediction.answer];
if (resolved !== "numbers" || !refetchPredict.options.some(([v]) => v === resolved)) throw new Error(`The decision's copy says the re-fetch changed the name and the numbers; it now gives ${prediction.answer}`);
const others = refetchPredict.options.map(([v]) => v).filter((v) => v !== resolved && v !== "unknown").join("|");

const lambert = rowChanges.C.find((r) => r.slug === "st-lambert")!;
const rowOf = (rows: typeof tableA.rows) => rows.find((r) => r.slug === "st-lambert")!;
const before = rowOf(tableA.rows);
const after = rowOf(tableC.rows);
const cols: [Column, string][] = [["name", "Team"], ["p", "P"], ["w", "W"], ["d", "D"], ["l", "L"], ["gf", "GF"], ["ga", "GA"], ["gd", "GD"], ["pts", "Pts"]];
const head = Object.fromEntries(cols);
const change = (c: Column) => `${head[c]} ${before[c]} → ${after[c]}`;
const byCode = lambert.columns.filter((c) => c === "name").map(change);
const byPages = lambert.columns.filter((c) => c !== "name").map(change);
const sites = spell(tuesdayManifest.pages.filter((p) => p.kind === "schedule").length);
const lambertWin = saturday.find((s) => s.home === "st-lambert" || s.away === "st-lambert")!;
const saturdayDate = new Date(`${lambertWin.date}T12:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", timeZone: "UTC" });
const saturdayShort = saturdayDate.replace(/(\d+ \w{3})\w*/, "$1");
const seven = spell(fridayPages.length);
if (rewind.unavailable.map((u) => u.slug).join() !== tuesdayManifest.unavailable.join()) throw new Error("Tuesday's unavailable sites are not Friday's");
const down = rewind.unavailable.map((u) => u.name).join(" and ");

const day = (iso: string) => new Date(iso).toLocaleString("en-GB", { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "UTC" }).replace(",", "");
const harbor = { friday: fridayPages.find((p) => p.slug === "harbor-point")!, tuesday: tuesdayPages.find((p) => p.slug === "harbor-point")! };
const cell = (text: string) => (text === "" ? "blank" : text);
const changed = policies.changedSinceFriday;
const same = policies.unchangedSinceFriday;
const names = (list: { name: string }[]) => list.map((x) => x.name).join(" and ");
if (harbor.friday.sha256 === harbor.tuesday.sha256) throw new Error("Harbor Point's page no longer changed between Friday and Tuesday");

const verdict = (q: "today" | "monday" | "harborFriday") => {
  const l = policies.latest[q];
  const e = policies.every[q];
  return l && e ? "both" : e ? "every" : l ? "latest" : "neither";
};
const who: [string, string][] = [["both", "Both policies"], ["every", "Every capture only"], ["neither", "Neither policy"]];
const questions = [
  { key: "today", label: "Build today's table from Tuesday's saved pages.",
    why: "Both policies. Each archive holds Tuesday's captures after the re-fetch, and today's table is built from those.",
    wrong: { every: "Latest only keeps one capture per page: the newest. That is the one today's table needs.", neither: "Both archives hold Tuesday's pages. That is what a re-fetch saves." } },
  { key: "monday", label: "Rebuild Monday's table exactly, from the pages it was built from.",
    why: `Every capture only. Monday's table read Friday's ${seven} captures, and Friday's manifest names them. Latest only replaced all ${seven} on Tuesday, and ${spell(changed.length)} of them had changed, so their Friday bytes are gone.`,
    wrong: { both: `Latest only now holds Tuesday's pages. ${spell(changed.length, true)} of them differ from Friday's, so it no longer has the full set Monday's table read.`, neither: `Every capture still holds Friday's ${seven} captures, each beside Tuesday's.` } },
  { key: "harborFriday", label: `What did Harbor Point's result cell for ${saturdayDate} say on Friday: blank, or a result Kick missed?`,
    why: `Every capture only. Friday's capture of Harbor Point is still there. Latest only holds Tuesday's capture, which says ${policies.harborCell.tuesday} and nothing about Friday.`,
    wrong: { both: `Latest only holds Tuesday's capture of Harbor Point, which says ${policies.harborCell.tuesday}. Nothing in it says what the cell held on Friday.`, neither: "Every capture keeps Friday's capture of Harbor Point beside Tuesday's." } },
] as const;
const grid = questions.map((q) => ({ ...q, answer: verdict(q.key) }));
if (grid.map((q) => q.answer).join() !== "both,every,every") throw new Error("The policy answers changed; rewrite The decision's explanations");

const calls = [
  { key: "hashes", text: "Latest only, with each capture's content hash recorded in the run's manifest" },
  { key: "season", text: "Every capture until the season closes, then only the captures the final table's manifest names" },
  { key: "forever", text: "Every capture, kept for every season" },
  { key: "tables", text: "Latest only, plus a saved copy of every week's published table" },
];
---

<section id="decision" class="ar-part">
  <PartHead id="decision">The decision: what a re-fetch would have cost</PartHead>
  <p>In Setup, before you knew what the sites had posted since Friday, you predicted what Kick's re-fetch would do to Saint Lambert's row.</p>
  <div class="cv-say cv-yours">
    <p class="cv-who">Your prediction from Setup</p>
    <p data-when={refetchPredict.key} hidden><span data-show={refetchPredict.key} data-show-labels={labelsOf(refetchPredict)}></span></p>
    <p data-when={refetchPredict.key} data-is="" hidden>You skipped it. It is still there in Setup.</p>
  </div>
  <p><strong>“Can't tell” was the justified answer on Tuesday.</strong> A re-fetch reads each site as it is now, and nothing on screen said what the sites had posted since Friday. If no site had posted or changed a result since Friday, only the name would change. If one had, the numbers would move too. A replay has no such unknown: its pages are Friday's, byte for byte.</p>
  <p class="ar-yours" data-when={refetchPredict.key} data-is={resolved} hidden>You picked what the re-fetch does. On Tuesday that was a guess about the live sites.</p>
  <p class="ar-yours" data-when={refetchPredict.key} data-is={others} hidden>That is what a re-fetch gives when no site has posted or changed a result since Friday. One had posted a counted result.</p>

  <p>Case 1 captured Tuesday's pages apart from the archive to see what the re-fetch would have read. On Saturday {lambertWin.homeName} beat {lambertWin.awayName} {lambertWin.home_score}–{lambertWin.away_score}, a conference match, and St. Lambert's site had posted it. So the re-fetch changes the name and the numbers: {spell(lambert.columns.length)} cells of one row, for two different reasons.</p>
  <div class="cv-scroll">
    <table class="cv-log ar-row">
      <caption>St. Lambert's row, Tuesday's table and the re-fetch</caption>
      <thead><tr><th scope="col"></th>{cols.map(([, h]) => <th scope="col">{h}</th>)}</tr></thead>
      <tbody>
        <tr><th scope="row">Tuesday's table</th>{cols.map(([c]) => <td>{before[c]}</td>)}</tr>
        <tr><th scope="row">Re-fetch</th>{cols.map(([c]) => <td class:list={{ "is-code": lambert.columns.includes(c) && c === "name", "is-pages": lambert.columns.includes(c) && c !== "name" }}>{after[c]}</td>)}</tr>
      </tbody>
    </table>
  </div>
  <table class="cv-log ar-changes">
    <caption>St. Lambert's changed cells</caption>
    <thead><tr><th scope="col">Cell</th><th scope="col">Tuesday</th><th scope="col">Re-fetch</th><th scope="col">Changed by</th></tr></thead>
    <tbody>{lambert.columns.map((c) => <tr><th scope="row">{head[c]}</th><td>{before[c]}</td><td class:list={{ "is-code": c === "name", "is-pages": c !== "name" }}>{after[c]}</td><td>{c === "name" ? "the code" : "the pages"}</td></tr>)}</tbody>
  </table>
  <p class="ar-key"><span><span class="ar-swatch is-code"></span><span><b>Changed by the code:</b> {byCode.join("; ")}</span></span><span><span class="ar-swatch is-pages"></span><span><b>Changed by the pages:</b> {byPages.join("; ")}</span></span></p>
  <p class="cv-label">“St. Lambert” is the school as its own pages write it. “State Lambert” is the bug's display name and “Saint Lambert” the fix's.</p>
  <p>That is the visible cost: a diff with two causes. The larger cost is the one the table doesn't show.</p>

  <h3 id="decision-policies">Two archive policies</h3>
  <p>A table is a build over saved pages, code and config. Suppose every run's parser, build code and config are kept in version control, and every run's manifest records which captures it read. Then only one question is left: how long are the pages kept? There are two common answers.</p>
  <div class="cv-twins cv-two">
    <div>
      <h4>Latest only</h4>
      <p>One capture per page, with its fetch time. A new fetch of the page overwrites it.</p>
      <p><b>Can rebuild:</b> a table from the pages as they were last fetched.</p>
      <p><b>Cannot rebuild:</b> a table that read an older capture of a page that has since been fetched again and changed.</p>
    </div>
    <div>
      <h4>Every capture</h4>
      <p>Each fetch is stored beside the last, with its fetch time. Nothing is overwritten.</p>
      <p><b>Can rebuild:</b> every past table, from the captures its manifest names.</p>
      <p><b>Costs:</b> storage that grows with every run, much of it pages that never changed.</p>
    </div>
  </div>

  <p>Suppose Riley hadn't stopped Kick, and Tuesday's re-fetch had gone into the archive: all {sites} sites asked again, {seven} pages saved, {down} still unavailable. By then {spell(changed.length)} of the {seven} pages had changed since Friday, Harbor Point's among them, and {names(same)} had not. For each question, which archive can still answer it?</p>
  <Check once="decide-policies" kind="Prediction" note="Answer all three, then check.">
    {grid.map((q) => <Choice save={`decide-${q.key}`} label={q.label} options={who} answer={q.answer} why={q.why} wrong={q.wrong} />)}
    <Fragment slot="reveal">
      <figure class="ar-shelf" aria-label={`Harbor Point's schedule page in each archive after a Tuesday re-fetch. Latest only holds Tuesday's capture, ${saturdayShort} ${cell(policies.harborCell.tuesday)}; Friday's was overwritten. Every capture holds Friday's, ${saturdayShort} ${cell(policies.harborCell.friday)}, and Tuesday's.`}>
        <figcaption>Harbor Point's schedule page in each archive, after a re-fetch on Tuesday</figcaption>
        <div class="ar-lane">
          <p class="ar-lane-name">Latest only</p>
          <div class="ar-caps">
            <div class="ar-cap is-gone" aria-hidden="true"><b>{day(harbor.friday.fetchedAt)}</b><span class="cv-mono">{harbor.friday.sha256.slice(0, 12)}</span><span>overwritten</span></div>
            <div class="ar-cap"><b>{day(harbor.tuesday.fetchedAt)}</b><span class="cv-mono">{harbor.tuesday.sha256.slice(0, 12)}</span><span>{saturdayShort}: {cell(policies.harborCell.tuesday)}</span></div>
          </div>
        </div>
        <div class="ar-lane">
          <p class="ar-lane-name">Every capture</p>
          <div class="ar-caps">
            <div class="ar-cap"><b>{day(harbor.friday.fetchedAt)}</b><span class="cv-mono">{harbor.friday.sha256.slice(0, 12)}</span><span>{saturdayShort}: {cell(policies.harborCell.friday)}</span></div>
            <div class="ar-cap"><b>{day(harbor.tuesday.fetchedAt)}</b><span class="cv-mono">{harbor.tuesday.sha256.slice(0, 12)}</span><span>{saturdayShort}: {cell(policies.harborCell.tuesday)}</span></div>
          </div>
        </div>
      </figure>
      <p class="cv-label">Fetch times and content hashes are the sample's. The Tuesday capture is kept apart from the archive, so the overwrite is simulated.</p>
      <p>The third question has teeth. Harbor Point's cell went from {cell(policies.harborCell.friday)} to “{policies.harborCell.tuesday}”, so from Tuesday's capture alone nobody can say whether Friday's page already showed a result that Kick failed to read. Friday's capture settles it: {cell(policies.every.harborFridayCell ?? "")}, so Kick missed nothing in that cell.</p>
      <p class="cv-rule">A recorded hash can verify that an unchanged page is identical. It can never recover a page that changed.</p>
      <p>Friday's manifest records every page's hash, so even latest only can verify that its {names(same)} captures are still Friday's bytes. For the other {spell(changed.length)}, the hash shows only that the bytes differ. It cannot say what they were.</p>
    </Fragment>
  </Check>

  <h3 id="decision-touchline">What Touchline keeps</h3>
  <div class="cv-touchline">
    <p>Touchline keeps latest only: the newest capture of each page, with its fetch time. So Friday's table could be rebuilt on Tuesday because Friday's bytes were still there: nothing had fetched those {seven} pages since Friday. Kick's “Re-fetching!” would have replaced all {seven}, and {spell(changed.length)} had changed ({changed.map((c) => c.name).join(", ")}). After that, Monday's table, the one readers have, could not be rebuilt: {spell(changed.length)} of the pages it read would be gone, and their hashes could say only that they differed.</p>
    <p>That is why a parser change re-reads the archive and never fetches, and why a re-fetch is a separate, deliberate act.</p>
  </div>

  <AiCard part="decision" />

  <h3 id="decision-your-call">Your call: the league office</h3>
  <p>The conference office publishes the standings every week. Until the season closes, a coach can dispute any week's table, and the office must then show the pages that table was built from. After that, only the final table is ever questioned. The office's storage can hold every capture of one season, plus the pages each past season's final table read, but not every capture of every season.</p>
  <Check once="decide-call" kind="Your call" note="Pick one policy, then check." button="Check answer">
    <Choice radio save="decide-call" label="Which archive policy should the office run?" options={calls.map((c) => [c.key, c.text])} answer="season"
      why="Every capture until the season closes, then the final table's. A dispute about an early week needs the pages that week's table read, and later fetches will have replaced some of them. Once disputes close, only the final table is questioned, and its manifest names the captures it read."
      wrong={{ hashes: "A hash verifies that a page is unchanged. For a page that has changed since, it shows only that the old page was different, not what it said.", tables: "A saved table shows what was published, not what it was built from. That is Case 2's lesson: an output can't stand in for its inputs.", forever: "It answers every dispute, but storage holds one season of captures, not every season's. After the season closes, only the captures the final table read answer a question anyone asks." }} />
    <p slot="reveal">The policy follows from the questions the archive must answer, and for how long. A table needs its pages for as long as somebody may ask what it was built from.</p>
  </Check>

  <NextPart from="decision">Riley's question asks for the right thing. What would Riley need to see to check it?</NextPart>
</section>

<style>
  .ar-part :global(fieldset.cv-line > label) { display: flex; flex-wrap: nowrap; align-items: flex-start; margin-right: 0; }
  .ar-part :global(fieldset.cv-line > label > span) { flex: 1 1 0; min-width: 0; }
  .ar-part :global(fieldset.cv-line > label > input) { flex: none; margin-top: 0.3rem; }
  .ar-yours { margin-top: -0.25rem; padding-left: 1rem; border-left: 3px solid var(--cv-yellow); }
  .ar-row { max-width: 40rem; }
  .ar-changes { display: none; }
  .ar-row td, .ar-row th { white-space: nowrap; }
  .ar-row td.is-code, .ar-swatch.is-code { background: color-mix(in srgb, var(--sl-color-accent) 28%, transparent); }
  .ar-row td.is-pages, .ar-swatch.is-pages { background: color-mix(in srgb, var(--cv-yellow) 30%, transparent); }
  .ar-key { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin-top: -0.5rem; color: var(--tl-muted); font-size: 0.85rem; }
  .ar-key > span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .ar-swatch { display: inline-block; width: 0.9rem; height: 0.9rem; border-radius: 2px; }
  .ar-shelf { display: grid; gap: 0.6rem; margin: 0 0 0.5rem; padding: 0.9rem 1rem; border: 1px solid var(--tl-line); border-radius: 8px; background: var(--tl-card); }
  .ar-shelf figcaption { color: var(--sl-color-white); font-weight: 700; }
  .ar-lane { display: grid; grid-template-columns: 8.5rem 1fr; align-items: center; gap: 0.5rem 0.75rem; }
  .ar-lane-name { margin: 0; font-weight: 700; }
  .ar-caps { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ar-cap { display: grid; gap: 0.1rem; min-width: 11rem; padding: 0.45rem 0.7rem; border: 2px solid var(--sl-color-accent); border-radius: 6px; background: var(--tl-bg); font-size: 0.88rem; line-height: 1.35; }
  .ar-cap b { color: var(--sl-color-white); }
  .ar-cap.is-gone { border: 2px dashed var(--cv-red); opacity: 0.75; }
  .ar-cap.is-gone b, .ar-cap.is-gone .cv-mono { text-decoration: line-through; }
  .ar-cap.is-gone span:last-child { color: var(--cv-red); font-weight: 700; }
  @media (max-width: 32rem) { .ar-lane { grid-template-columns: 1fr; } .ar-cap { min-width: 0; flex: 1 1 9rem; } }
  @media (max-width: 32rem) { .cv-scroll:has(.ar-row), .ar-key { display: none; } .ar-changes { display: table; } .ar-changes td.is-code { background: color-mix(in srgb, var(--sl-color-accent) 28%, transparent); } .ar-changes td.is-pages { background: color-mix(in srgb, var(--cv-yellow) 30%, transparent); } }
</style>
