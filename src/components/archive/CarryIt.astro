---
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import PartHead from "../coverage/PartHead.astro";
import Check from "../lesson/Check.astro";
import Choice from "../lesson/Choice.astro";
import AiCard from "./AiCard.astro";
import FilmSlot from "../lesson/FilmSlot.astro";
import { outcomes } from "../../lib/archive-parts";
import { fridayManifest, fridayPages, rawRows } from "../../lib/archive";
import { journey } from "../../data/journey";
import { modulePageExists } from "../../lib/lessons";
import { spell } from "../../lib/cases";

const nextModule = journey.flatMap((stage) => stage.modules).find((m) => m.slug === "03-provenance")!;
const takeaway = "Can you rebuild this from saved inputs, with no new requests, and show me what changed and why?";

const saved = (...p: string[]) => join(process.cwd(), "sample", "raw_html", ...p);
const bytes = readFileSync(saved("cedar-grove", "2019-men-schedule.html"));
const page = bytes.toString("utf-8");
const actualHash = createHash("sha256").update(bytes).digest("hex");
const sidecar = JSON.parse(readFileSync(saved("cedar-grove", "2019-men-schedule.html.meta.json"), "utf-8")) as { requested_url: string; final_url: string; status: number; fetched_at: string; sha256: string };
const decode = (s: string) => s.replace(/&#x27;/g, "'").replace(/&amp;/g, "&");
const title = decode(page.match(/<title>([^<]*)<\/title>/)?.[1] ?? "");
const rows = rawRows(page).length;
const yearOf = (s: string) => s.match(/\b(20\d\d)\b/)?.[1] ?? "";
const asked = yearOf(sidecar.requested_url.split("/").pop()!);
const titled = yearOf(title);
const friday2026 = fridayPages.find((p) => p.slug === "cedar-grove")!;
const fridayRecorded = fridayManifest.pages.find((p) => p.kind === "schedule" && p.programme === "cedar-grove")!.sha256;
if (sidecar.status !== 200 || !asked || sidecar.final_url !== sidecar.requested_url || !titled || titled === asked || rows === 0 || actualHash !== sidecar.sha256 || actualHash !== friday2026.sha256 || actualHash !== fridayRecorded) {
  throw new Error("Cedar Grove's 2019 capture no longer sets up Module 3: a 200, both URLs the requested year, a full table, another year in the title, the same bytes as Friday's page");
}
const sideRows: [string, string][] = [
  ["requested_url", sidecar.requested_url],
  ["final_url", sidecar.final_url],
  ["status", String(sidecar.status)],
  ["fetched_at", sidecar.fetched_at],
  ["sha256", `${sidecar.sha256.slice(0, 12)}… (first ${sidecar.sha256.slice(0, 12).length} of ${sidecar.sha256.length})`],
];

const claims: [string, string, string][] = [
  ["none", "The published reports can't be corrected from what was kept. Asking the clinics to resubmit is a new fetch, and the correction must say so", "Not from what was kept"],
  ["full", "Every month's report can be replayed from the forms it read, so the fix's diff has one cause", "Every report, one cause"],
  ["nopast", "This month's figures can be fixed, but no past month can be corrected", "This month only"],
  ["recount", "Every month can be replayed from the files kept, but March at Northside replays a different file than its report read", "Every month, March confounded"],
];
const worlds: { key: string; name: string; kept: string; answer: string; why: string; wrong: Record<string, string> }[] = [
  { key: "a", name: "World A", kept: "Kept every file, each resubmitted file stored beside the original.", answer: "full",
    why: "The raw forms still have the box as the clinic ticked it, and each report's record names its files. March's report is replayed from Northside's original file, so the replay changes one input, the code, and the diff has one cause. The resubmission can then be applied as a second, separately attributed change.",
    wrong: { recount: "Nothing was replaced. March's report can be replayed from the very file it read.", nopast: "Every month's forms are kept, so every month can be replayed.", none: "The raw forms keep the follow-up box. Only the mapped table lost it." } },
  { key: "b", name: "World B", kept: "Kept only the mapped table. A form ticked “follow-up visit” and one ticked “new patient” both sit in it as new patient.", answer: "none",
    why: "The mapping ran before anything was saved, so the table can't tell the two forms apart: Case 2's parsed rows. Asking the clinics again is the only route, and it is a new fetch, not a replay.",
    wrong: { full: "There is nothing to replay. The table is the damaged layer.", recount: "A replay needs the forms, and none were kept.", nopast: "This month's forms are already mapped too, and their raw forms weren't kept either." } },
  { key: "c", name: "World C", kept: "Kept each clinic's file for every month, but a resubmitted file overwrote the one before it.", answer: "recount",
    why: "Every month can be replayed from the files that survive. But March's report recorded the hash of Northside's original file, and the file now held has a different one: the hash shows the original is gone, and can't bring it back. So March's report can't be replayed from the forms it read. The fix's effect on the resubmitted file can be measured; its effect on the lost original can't, so a difference between the published figure and the replay may come from the fix, the resubmission, or both: Case 1's confounding, caused by the decision's latest only.",
    wrong: { full: "March's report read a file that is gone, so its change can't be traced to the fix alone.", nopast: "The surviving files still have the box, so every month can be replayed.", none: "The raw forms that survive still have the box. Every month can be replayed." } },
];
const claimNo = (key: string) => claims.findIndex(([k]) => k === key) + 1;
const claimOpts: [string, string][] = claims.map(([k, , brief], i) => [k, `${i + 1} · ${brief}`]);
const staleOpts: [string, string][] = [
  ["ticked", "Only the records of forms with the follow-up box ticked"],
  ["none", "None, until a clinic resubmits"],
  ["all", "Every mapped record"],
];
---

<section id="carry-it" class="ar-part">
  <PartHead id="carry-it">Carry it: same fix, three archives</PartHead>
  <p>The same rules work outside sports: keep the inputs before any code reads them, replay instead of fetching again, and let a fingerprint say what is stale.</p>
  <p>Module 1's clinics are back. Each now sends its visit forms in one file a month, and a mapping step reads each file into a table as it arrives. For six months that step filed the form's “follow-up visit” box as “new patient”. The fix is one line, the same in every world.</p>
  <p>One more event: in May, the Northside clinic resubmitted its March file with corrected forms, after March's report had been built.</p>
  <p class="cv-qlabel">What every world records:</p>
  <ul>
    <li>Each monthly report records the content hash of every raw clinic file the mapping step read for it.</li>
    <li>Each mapped record carries the fingerprint of the mapping code that wrote it.</li>
    <li>Every form received so far has been mapped.</li>
    <li>The mapping code, the report code and their config are kept in version control.</li>
  </ul>
  <p>Only what was kept differs.</p>
  <div class="cv-twins">
    {worlds.map((w) => <div><h4>{w.name}</h4><p>{w.kept}</p></div>)}
  </div>
  <Check once="carry-worlds" kind="Transfer" note={`Answer all ${spell(worlds.length + 1)}, then check.`}>
    <p class="cv-qlabel">Four recovery claims:</p>
    <ol class="ar-claims">{claims.map(([, text]) => <li>{text}.</li>)}</ol>
    {worlds.map((w) => <Choice save={`carry-${w.key}`} label={`${w.name}: what is the strongest honest claim about correcting the published reports?`} options={claimOpts} placeholder="Choose a claim" answer={w.answer} why={`${claimOpts[claimNo(w.answer) - 1][1]}. ${w.why}`} wrong={Object.fromEntries(Object.entries(w.wrong).map(([k, v]) => [k, `${claimOpts[claimNo(k) - 1][1]}: ${v}`]))} />)}
    <Choice save="carry-stale" label="World A, after the fix: which mapped records are stale?" options={staleOpts} answer="all"
      why="Every mapped record. Each carries the old fingerprint, and the mapping step's fingerprint changed, including forms with the box left blank. Rebuilding them all costs minutes; rebuilding too few publishes a wrong count with no error."
      wrong={{ ticked: "That picks stale records by guessing what the bug touched. The fingerprint, not a guess, decides.", none: "The forms didn't change, but the code did. Either one makes a mapped record stale." }} />
    <Fragment slot="reveal">
      <p>Same bug, same one-line fix, three different claims. World A can show its correction is the fix and nothing else. World C can replay March, but not from Northside's original file, so it can't reproduce March's report or isolate the fix's effect on it. World B can only say what it no longer knows. The fix didn't decide what could be recovered. The archive did, months before anyone found the bug.</p>
      <AiCard part="carry-it" />
    </Fragment>
  </Check>

  <h3 id="carry-it-recap">What you can now do</h3>
  <ul class="cv-outcomes">
    {outcomes.map((o) => <li>{o.can} <a href={o.href}>{o.where}</a></li>)}
  </ul>
  <p class="cv-done-note"><span data-progress-text></span> <a href="#setup" data-rail-resume="name" hidden></a></p>

  <h3 id="carry-it-prompt">The question to take with you</h3>
  <p>Ask this whenever an AI fixes code that produced data you already published:</p>
  <div class="cv-user-prompt cv-takeaway-prompt" role="region" aria-label="Reusable rebuild prompt">
    <div class="cv-chat-bar">
      <span class="cv-chat-badge">Prompt</span>
      <span class="cv-chat-meta">You → any AI</span>
    </div>
    <p class="cv-chat-text" data-copy-text>{takeaway}</p>
    <button type="button" data-copy data-label="Copy prompt">Copy prompt</button>
  </div>

  <h3 id="carry-it-seasons">Then, past seasons</h3>
  <p>The table is rebuilt, and Riley wants context: how did these schools do in earlier seasons? Kick asks the sites for their old schedules and saves every page as received, with a sidecar. Cedar Grove's {asked} request comes back with a success code.</p>
  <div class="cv-agent-reply" role="region" aria-label={`The sidecar Kick saved for Cedar Grove's ${asked} request`}>
    <div class="cv-chat-bar">
      <span class="cv-agent-badge">Kick · Saved</span>
      <span class="cv-status-ok">Cedar Grove, asked for {asked} · {sidecar.status} · {rows} schedule rows</span>
    </div>
    <table class="cv-log ar-sidecar">
      <caption>Sidecar for <code>cedar-grove/{asked}-men-schedule.html</code></caption>
      <tbody>{sideRows.map(([k, v]) => <tr><th scope="row"><code>{k}</code></th><td><code>{v}</code></td></tr>)}</tbody>
    </table>
  </div>
  <fieldset class="cv-choice" data-gate>
    <legend><span class="cv-kind">Prediction <span>not graded</span></span>Both URLs, the one requested and the one that answered, say {asked}. Does the sidecar show this is Cedar Grove's {asked} schedule?</legend>
    <label><input type="radio" name="ar-carry-season" value="yes" data-save="carry-season" /><span>Yes: both URLs say {asked}</span></label>
    <label><input type="radio" name="ar-carry-season" value="no" data-save="carry-season" /><span>No: it shows another season</span></label>
    <label><input type="radio" name="ar-carry-season" value="unknown" data-save="carry-season" /><span>Not on its own</span></label>
  </fieldset>
  <div class="ar-title" data-when="carry-season" hidden>
    <p class="ar-said" data-when="carry-season" data-is="yes" hidden>The URLs say which season was asked for and which address answered. The page can disagree with them, and this one does.</p>
    <p class="ar-said" data-when="carry-season" data-is="unknown" hidden>The URLs say which season was asked for and which address answered, and the sidecar says nothing else about the season. The page can disagree with them, and this one does.</p>
    <p class="ar-said" data-when="carry-season" data-is="no" hidden>Only if you compare its hash with Friday's manifest. The sidecar alone names {asked} twice. The page itself names another season.</p>
    <p>Open the saved bytes. The page's own title says:</p>
    <p class="cv-mono ar-title-line">&lt;title&gt;{title}&lt;/title&gt;</p>
    <p>Its content hash is the one Friday's manifest recorded for Cedar Grove's {titled} page: byte for byte, the same page. The archive did its job and kept exactly what arrived. A pipeline that believed the URLs would file this as {asked}, and every replay with that code would rebuild the same wrong season, faithfully.</p>
    <div class="cv-say cv-riley">
      <p class="cv-who">Riley</p>
      <p>So the archive holds a {titled} page under {asked}, exactly as it arrived. What should Kick check before it counts a single row from it?</p>
    </div>
  </div>

  <FilmSlot name="cedar-grove-2019" label="A short closing video for Module 2" caption="The 2019 page." />

  <aside class="cv-next-card" aria-label="Next module">
    <p class="cv-next-eyebrow">Up next · Module {nextModule.n}</p>
    <p class="cv-next-q">{nextModule.question}</p>
    <a class="cv-next-cta" href="../03-provenance/">Continue to Module {nextModule.n}: {nextModule.name} →</a>
  </aside>

  {modulePageExists("02-archive-field-work") && (
    <>
      <h3 id="carry-it-further">Optional: go further</h3>
      <p>The <a href="../02-archive-field-work/?from=carry-it">Module 2 field work page</a> has the lab, content signatures, and the cost of keeping every capture.</p>
    </>
  )}
</section>

<style>
  .ar-part :global(.cv-line select) { width: 100%; max-width: 30rem; }
  .ar-part :global(.cv-line > label.cv-stack) { grid-template-columns: minmax(0, 1fr); }
  .ar-part :global(fieldset.cv-line > label) { display: flex; flex-wrap: nowrap; align-items: flex-start; margin-right: 0; }
  .ar-part :global(fieldset.cv-line > label > span) { flex: 1 1 0; min-width: 0; }
  .ar-part :global(fieldset.cv-line > label > input) { flex: none; margin-top: 0.3rem; }
  .ar-part :global(.cv-chat-bar) { flex-wrap: wrap; row-gap: 0.35rem; }
  .ar-claims { margin: 0 0 0.75rem; padding-left: 1.5rem; }
  .ar-claims li { margin: 0.3rem 0; }
  .ar-sidecar { max-width: none; margin: 0; }
  .ar-sidecar caption { padding: 0.6rem 1rem 0.2rem; color: var(--tl-muted); font-size: 0.85rem; text-align: left; }
  .ar-sidecar th, .ar-sidecar td { padding-left: 1rem; }
  .ar-sidecar th { width: 1%; white-space: nowrap; }
  .ar-sidecar td code { overflow-wrap: anywhere; }
  @media (max-width: 32rem) {
    .ar-sidecar tr { display: grid; padding: 0.3rem 0; border-bottom: 1px solid var(--tl-line); }
    .ar-sidecar th, .ar-sidecar td { width: auto; padding: 0.1rem 1rem; border: 0; }
  }
  .ar-title { margin: 0 0 1.25rem; padding: 0.85rem 1rem; border-left: 4px solid var(--cv-red); background: var(--tl-card); }
  .ar-title p:last-child { margin-bottom: 0; }
  .ar-said { font-weight: 600; }
  .ar-title-line { padding: 0.5rem 0.75rem; background: var(--tl-bg); overflow-wrap: anywhere; }
  :global(.il-js .cv-core.is-review) .ar-title[hidden] { display: block; }
</style>
