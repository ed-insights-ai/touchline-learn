---
import PartHead from "../coverage/PartHead.astro";
import NextPart from "../coverage/NextPart.astro";
import AiCard from "./AiCard.astro";
import Draft from "./Draft.astro";
import { refetchPredict } from "../../lib/archive-state";
---

<section id="setup">
  <PartHead id="setup">Setup: Tuesday, one line of code</PartHead>
  <Draft items={["Three lines of story and Tuesday's table, with “State Lambert” in one row.", "Kick's think trace and plan: fix the tidy rule inside the parser, re-fetch all eight sites, regenerate.", "Riley's three-clause ask as a prompt card.", "The prediction below, returned in The decision."]} />
  <fieldset class="cv-choice" data-gate>
    <legend><span class="cv-kind">Prediction <span>not graded</span></span>If Kick had re-fetched, what would Saint Lambert's row show?</legend>
    {refetchPredict.options.map(([value, label]) => (
      <label><input type="radio" name="ar-refetch-predict" value={value} data-save={refetchPredict.key} /><span>{label}</span></label>
    ))}
  </fieldset>
  <p class="cv-once">We'll come back to your prediction in The decision.</p>
  <AiCard part="setup" />
  <NextPart from="setup">What does a published table depend on, besides the code?</NextPart>
</section>
