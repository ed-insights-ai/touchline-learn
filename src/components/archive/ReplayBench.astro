---
interface Props { mode: "tables" | "presets" }
const { mode } = Astro.props;
const what = mode === "tables"
  ? "Tables A, B and C with a selector and a cell diff against Tuesday's table."
  : "Six fingerprint presets, each with schedules rebuilt, pages fetched and a simulated request count.";
---

<figure class="ar-bench" data-bench={mode} aria-labelledby={`ar-bench-${mode}`}>
  <figcaption id={`ar-bench-${mode}`}>The replay bench</figcaption>
  <p class="ar-bench-draft">Draft. {what}</p>
</figure>

<style>
  .ar-bench { margin: 0 0 1.25rem; padding: 0.9rem 1rem; border: 1px dashed var(--tl-line); border-radius: 8px; }
  .ar-bench figcaption { margin: 0 0 0.4rem; color: var(--sl-color-white); font-weight: 700; }
  .ar-bench-draft { margin: 0; color: var(--tl-muted); font-size: 0.92rem; }
</style>
