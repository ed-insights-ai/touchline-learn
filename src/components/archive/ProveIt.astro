---
import PartHead from "../coverage/PartHead.astro";
import NextPart from "../coverage/NextPart.astro";
import Check from "../lesson/Check.astro";
import Choice from "../lesson/Choice.astro";
import AiCard from "./AiCard.astro";
import { fingerprints, fridayManifest, proveIt } from "../../lib/archive";
import { spell } from "../../lib/cases";
import { monthDay } from "../../lib/us-dates";

const { home, away, published, buggy, scoreByPeriod, goal, slots } = proveIt;
const date = monthDay(proveIt.date);
const round = proveIt.round.toLowerCase().replace(/s$/, "");
const box = proveIt.fixture.split(":").pop();
const boxes = slots.replay.boxScores;
const n = spell(boxes);
const fresh = spell(slots.stale.schedulesFresh);
const fp = slots.stale.boxParser;
const ot = scoreByPeriod.head.findIndex((h) => h === "OT");
const ordinal = (k: number) => ["first", "second", "third", "fourth", "fifth", "sixth", "seventh", "eighth", "ninth"][k - 1] ?? `${k}th`;
const dash = (s: string) => s.replace(/(\d)-(\d)/g, "$1–$2");
const match = dash(slots.tell.match);
if (!match.endsWith(date)) throw new Error("Prove it's correction note no longer ends with the match date");
const boxEntry = fridayManifest.pages.find((p) => p.fixture === proveIt.fixture)!;
const savedOn = monthDay(boxEntry.fetched_at!);
if (slots.replay.withOvertime !== 1 || slots.replay.boxScores !== boxes || ot !== 3 || slots.stale.boxScores !== boxes || slots.stale.schedules !== 0 || slots.republish.standings || !slots.republish.matchDetail) throw new Error("Prove it's slot answers changed; rewrite its explanations");

const replayAnswer = slots.stale.boxScores === slots.replay.boxScores ? "all" : "one";
const staleAnswer = slots.stale.boxScores === slots.stale.of && slots.stale.schedules === 0 ? "fp" : "all";
const republishAnswer = slots.republish.standings ? "both" : "detail";
const replay: [string, string][] = [
  ["one", `Box ${box} only, from its saved page`],
  ["refetch", `Box ${box}, fetched again from ${home.name}'s site`],
  ["all", `All ${n} saved ${slots.replay.school} box scores, from their saved pages`],
  ["allfetch", `All ${n} ${slots.replay.school} box scores, fetched again so they are current`],
];
const stale: [string, string][] = [
  ["ot", `Only box ${box}'s: it is the one with the OT column`],
  ["hash", "Only those whose saved page changed since they were parsed: the page hash decides"],
  ["fp", `All ${n} parsed box scores: each records a fingerprint the fixed parser no longer has`],
  ["all", `All ${n} parsed box scores and the ${fresh} parsed schedules: all were parsed before the fix`],
];
const where: [string, string][] = [
  ["pk", "The parser skipped the goal because it was a penalty kick"],
  ["ot", "The parser left out a period"],
  ["site", `The saved box score says ${buggy.home}–${buggy.away}; the schedules are wrong`],
];
const republish: [string, string][] = [
  ["both", "The match detail and the standings"],
  ["detail", "The match detail only"],
  ["standings", "The standings only"],
  ["nothing", `Nothing: both schedules already say ${published.home}–${published.away}`],
];
const shown = `The match detail showed ${buggy.home}–${buggy.away}`;
const fromSaved = `Rebuilt from the box score saved on ${savedOn}.`;
const tell: [string, string][] = [
  ["site", `…because ${home.name}'s site first posted the wrong score. ${fromSaved}`],
  ["refetch", `…because ${slots.tell.cause}. We fetched the box score again to fix it.`],
  ["named", `…because ${slots.tell.cause}. ${fromSaved}`],
  ["table", `…and the standings were wrong, because ${slots.tell.cause}. Both are rebuilt.`],
];
---

<section id="prove-it" class="ar-part">
  <PartHead id="prove-it">Prove it: the bug found in March</PartHead>
  <p>In March, a reader writes in. The match detail for {home.name}'s {published.home}–{published.away} win over {away.name}, the {round} on {date}, says {buggy.home}–{buggy.away}. Both schools' schedules say {published.home}–{published.away}.</p>
  <div class="ar-detail" role="img" aria-label={`The published match detail: ${home.name} ${buggy.home}, ${away.name} ${buggy.away}, full time, no overtime.`}>
    <p class="ar-detail-tag">Match detail, as published</p>
    <p class="ar-detail-score"><span>{home.name}</span><b>{buggy.home}–{buggy.away}</b><span>{away.name}</span></p>
    <p class="ar-detail-foot">{round.charAt(0).toUpperCase() + round.slice(1)}, {date} · Box {box} · Full time</p>
  </div>
  <p>Kick saved {home.name}'s {n} box scores on {savedOn}, and nothing has fetched them since. Two excerpts from this one, as saved:</p>
  <div class="ar-excerpts">
    <div class="cv-scroll">
      <table class="cv-log ar-box">
        <caption>Score by Period</caption>
        <thead><tr>{scoreByPeriod.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>{scoreByPeriod.rows.map((r) => <tr><th scope="row">{r[0]}</th>{r.slice(1).map((c) => <td>{c}</td>)}</tr>)}</tbody>
      </table>
    </div>
    <div class="cv-scroll">
      <table class="cv-log ar-box">
        <caption>Scoring summary, one goal ({goal.abbr} is {goal.team})</caption>
        <thead><tr><th scope="col">Time</th><th scope="col">Team</th><th scope="col">Scorer</th><th scope="col">Play</th></tr></thead>
        <tbody><tr><td>{goal.time}</td><td>{goal.abbr}</td><td>{goal.scorer}</td><td>{goal.play}</td></tr></tbody>
      </table>
    </div>
  </div>
  <fieldset class="cv-choice" data-gate>
    <legend><span class="cv-kind">Prediction <span>not graded</span></span>Where did {home.name}'s {ordinal(published.home)} goal go?</legend>
    {where.map(([v, t]) => <label><input type="radio" name="ar-prove-where" value={v} data-save="prove-where" /><span>{t}</span></label>)}
  </fieldset>
  <div class="ar-diag" data-when="prove-where" hidden>
    <p class="ar-said" data-when="prove-where" data-is="pk" hidden>The penalty kick is in the scoring summary and in the OT column. What the parser missed is the column.</p>
    <p class="ar-said" data-when="prove-where" data-is="ot" hidden>The parser left out the overtime period.</p>
    <p class="ar-said" data-when="prove-where" data-is="site" hidden>The saved box score's F column says {published.home}–{published.away}, the same as the schedules.</p>
    <p>Friday's saved box score has the right score. The box-score parser added up periods {scoreByPeriod.head[1]} and {scoreByPeriod.head[2]} and stopped: {buggy.home}–{buggy.away}. It dropped the {scoreByPeriod.head[ot]} column, so the goal at {goal.time}, a penalty kick in overtime, never reached the match detail.</p>
  </div>
  <p>The parser is fixed in a minute. Now recover with what Cases 1 to 3 taught. Each parser module has its own fingerprint: the fix changes only the box-score parser's, to {fp.after}. The schedule parser's is still {fingerprints.v2}.</p>
  <div class="cv-scroll">
    <table class="cv-log ar-lineage">
      <caption>What each output is built from</caption>
      <thead><tr><th scope="col">Output</th><th scope="col">Built from</th><th scope="col">Fingerprint it records</th></tr></thead>
      <tbody>
        <tr><th scope="row">{spell(boxes, true)} parsed box scores</th><td>saved box-score pages</td><td class="cv-mono">{fp.before}</td></tr>
        <tr><th scope="row">{spell(slots.stale.schedulesFresh, true)} parsed schedules</th><td>saved schedule pages</td><td class="cv-mono">{fingerprints.v2}</td></tr>
        <tr><th scope="row">Match detail</th><td>parsed box score</td><td>–</td></tr>
        <tr><th scope="row">Standings</th><td>parsed schedules, counting regular-season conference matches only</td><td>–</td></tr>
      </tbody>
    </table>
  </div>
  <p class="cv-label">The fingerprints are real hashes of a box-score parser, before and after a simulated one-line edit. Which files go stale is simulated.</p>
  <AiCard part="prove-it" />
  <h3 id="prove-it-slots">The four slots</h3>
  <Check once="prove-recover" kind="Assessment" note="Answer all four, then check.">
    <Choice save="prove-replay" label="1. What do you replay, and from where?" options={replay} answer={replayAnswer}
      why={`All ${n}, from their saved pages. Every box score went through the parser that changed, and Friday's captures already hold the right numbers. Fetching adds nothing and would replace those captures.`}
      wrong={{ one: `That is the match you know about. The parser that changed read all ${n}; guessing which it got wrong is the mistake Case 3 warned about.`, refetch: "The saved page already has the right numbers. A fetch brings back whatever the site shows now, and replaces Friday's capture.", allfetch: "The scope is right, but the saved pages are the evidence. A fetch replaces Friday's captures with whatever Alder Ridge's site shows now." }} />
    <Choice save="prove-stale" label="2. Which parsed files are stale, and what tells you?" options={stale} answer={staleAnswer}
      why={`All ${n} parsed box scores. Each records ${fp.before}, and the parser is now ${fp.after}: the fingerprint decides, not a guess about what the bug touched. The ${fresh} parsed schedules record the schedule parser's fingerprint, which didn't change.`}
      wrong={{ ot: "The OT column says where the bug showed, not which files the old parser wrote. The fingerprint decides: every file this parser wrote is stale.", hash: "A changed page is one reason a parsed file goes stale. Changed code is the other, and that is this case.", all: "Each parser has its own fingerprint. The schedule parser's didn't change." }} />
    <Choice save="prove-republish" label="3. What do you republish?" options={republish} answer={republishAnswer}
      why={`The match detail only. It is the one product built from the box score. The standings are built from the schedules, which already show ${published.home}–${published.away}, and a ${round} is postseason, outside the regular-season standings.`}
      wrong={{ both: `The standings never used this box score: a ${round} is postseason, outside the regular-season standings, and the schedules had the right score.`, standings: "The standings were right. The wrong number is in the match detail.", nothing: "The schedules were right, but readers saw the match detail, and it was wrong." }} />
    <Choice radio save="prove-tell" label={`4. Each note begins “Correction: ${match}. ${shown}…” Which one do you publish?`} options={tell} answer="named"
      why={`It names the match, the wrong value readers saw, the real cause, and where the fix came from: the box score saved on ${savedOn}.`}
      wrong={{ site: `The box score saved on ${savedOn} says ${published.home}–${published.away}. Nothing shows the site ever posted ${buggy.home}–${buggy.away}.`, refetch: "Nothing was fetched. The note would misstate where the corrected number came from.", table: `The standings didn't change. A ${round} isn't in them.` }} />
    <Fragment slot="reveal">
      <p class="cv-rule">Replay every box score the fixed parser reads, fetch nothing, republish the one product that was wrong, and say what changed and why.</p>
      <p>Only box {box} has an {scoreByPeriod.head[ot]} column, so it is the only match detail expected to change. Replaying all {n} confirms the other {spell(boxes - slots.replay.withOvertime)} come out unchanged.</p>
      <p>Now suppose the box-score archive had kept only the parsed match detail: a final score for each match, with no periods and no goal times. The schedule's “{proveIt.schedules["alder-ridge"]}” would still show the final score was wrong, and that a goal was missing. It can't say when that goal came or that the match went to overtime. Only a fresh fetch could bring those back, if the site still shows them.</p>
    </Fragment>
  </Check>
  <NextPart from="prove-it">Does the same fix work for an archive that kept less?</NextPart>
</section>

<style>
  .ar-part :global(.cv-line select) { width: 100%; max-width: 30rem; }
  .ar-part :global(.cv-line > label.cv-stack) { grid-template-columns: minmax(0, 1fr); }
  .ar-part :global(fieldset.cv-line > label) { display: flex; flex-wrap: nowrap; align-items: flex-start; margin-right: 0; }
  .ar-part :global(fieldset.cv-line > label > span) { flex: 1 1 0; min-width: 0; }
  .ar-part :global(fieldset.cv-line > label > input) { flex: none; margin-top: 0.3rem; }
  .ar-detail { display: grid; gap: 0.2rem; max-width: 26rem; margin: 0 0 1rem; padding: 0.8rem 1rem; border: 1px solid var(--tl-line); border-top: 3px solid var(--cv-red); border-radius: 8px; background: var(--tl-card); }
  .ar-detail p { margin: 0; }
  .ar-detail-tag { color: var(--tl-muted); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .ar-detail-score { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 0.75rem; color: var(--sl-color-white); font-weight: 700; }
  .ar-detail-score span:last-child { text-align: right; }
  .ar-detail-score b { font-size: 1.5rem; font-variant-numeric: tabular-nums; }
  .ar-detail-foot { color: var(--tl-muted); font-size: 0.88rem; }
  .ar-excerpts { display: grid; gap: 0.25rem 1.25rem; margin: 0 0 0.5rem; }
  @media (min-width: 50rem) { .ar-excerpts { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); } }
  .ar-box { max-width: none; }
  .ar-lineage { max-width: 100%; }
  .ar-lineage td.cv-mono { white-space: nowrap; }
  .ar-box caption { color: var(--sl-color-white); font-weight: 700; text-align: left; }
  .ar-box td, .ar-box th { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .ar-diag { margin: 0 0 1.25rem; padding: 0.85rem 1rem; border-left: 4px solid var(--cv-yellow); background: var(--tl-card); }
  .ar-diag p:last-child { margin-bottom: 0; }
  .ar-said { font-weight: 600; }
  :global(.il-js .cv-core.is-review) .ar-diag[hidden] { display: block; }
</style>
