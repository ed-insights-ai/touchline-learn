---
interface Props { items: string[] }
const { items } = Astro.props;
---

<div class="ar-draft" role="note">
  <p class="ar-draft-kicker">Draft. This part is being written. It will hold:</p>
  <ul>{items.map((item) => <li>{item}</li>)}</ul>
</div>

<style>
  .ar-draft { margin: 0 0 1.25rem; padding: 0.8rem 1rem; border: 1px dashed var(--tl-line); border-radius: 8px; background: var(--tl-card); color: var(--tl-muted); font-size: 0.92rem; }
  .ar-draft-kicker { margin: 0 0 0.4rem; color: var(--sl-color-white); font-weight: 700; }
  .ar-draft ul { margin: 0; }
</style>
