---
import CoverageStyles from "../../coverage/Styles.astro";
import CoverageRuntime from "../../coverage/Runtime.astro";
import { archive } from "../../../lib/archive-parts";
import "../../FirstRunTable.astro";
import "../../CoverageGrid.astro";
import { controlled, fingerprintScope, hashAnswers, labRun, missing, missingReport, retention, scopeNames, scopeTable, signatures, tuesdayDiff, week } from "./fieldwork";

const { keys } = archive;
const n = (x: number) => x.toLocaleString("en-US");
const times = (x: number) => `${Math.round(x)}×`;
const lesson = (part: string) => `../02-archive/#${part}`;
const list = (xs: string[]) => (xs.length < 3 ? xs.join(" and ") : `${xs.slice(0, -1).join(", ")} and ${xs.at(-1)}`);

const map = [
  ["signatures", "Changed, or only re-rendered?", "About 10 minutes. Byte hashes, content signatures and render noise"],
  ["scope", "How much a fingerprint covers", "About 8 minutes. One function, the whole module, or more"],
  ["retention", "What every capture costs", "About 8 minutes. Sizes from the sample, and what each policy grows with"],
  ["layers", "Bronze, silver and gold", "About 6 minutes. The industry's names for raw and derived, and where Touchline's steps sit"],
  ["lab", "The lab", "About 20 minutes. Replay Friday in Python, then break it four ways"],
];

const answerText = Object.fromEntries(hashAnswers);
const fetchWhy = (f: (typeof signatures.fetches)[number]) => {
  if (f.answer === "neither") return `Neither. The bytes are the same as Friday's, so both hashes are too: ${f.byteHash} and ${f.signature}. A conditional request would have saved even the download.`;
  if (f.answer === "bytes") return `Byte hash only. The stamp, the token and the indentation change the bytes (${f.baselineByteHash} to ${f.byteHash}). The signature drops all three, so it stays ${f.signature}: the rows are Friday's.`;
  return `Both. ${f.real ? "One result cell is new" : "Under the noise, one result cell is new"}, and the signature keeps every cell, so it moves from ${f.baselineSignature} to ${f.signature}.${f.real ? "" : " It is the same signature as the real Tuesday capture: the noise made no difference to it."}`;
};
const fetchWrong = (f: (typeof signatures.fetches)[number]) =>
  Object.fromEntries(hashAnswers.filter(([k]) => k !== f.answer).map(([k]) => [k, k === "signature"
    ? "The signature is computed from the bytes. If the bytes did not change, it cannot."
    : f.answer === "bytes" ? "Compare the rows, not the bytes. What on this page would a reader call news?"
    : f.answer === "neither" ? "Look at what the fetch says changed since Friday."
    : "A result cell changed. Would a reader call that news?"]));

const scopeWhy: Record<string, string> = {
  rule: "The tidy function alone. The fix is inside tidy(), so even the narrowest fingerprint changes.",
  side: "The parser's whole module. The fix is in read_schedule(), so the tidy-only hash stays the same while every away row was parsed wrong.",
  comment: "The parser's whole module. A comment outside tidy() changes the module's bytes, though it cannot change a single row.",
  alias: "Module, page reader and config. The parser's code is untouched; only aliases.json changed, and only the lab's fingerprint hashes it.",
  runtime: "None of the three. No file any of them hashes has changed. Whether the output did is something no fingerprint here can say.",
};
const scopeWrong = (id: string) => ({
  fn: id === "alias" || id === "runtime" ? "tidy() is untouched by this edit." : "Where is the edit? tidy() is three lines; this edit is outside them.",
  module: id === "alias" ? "The module's bytes are the same. What file did change?" : id === "runtime" ? "No file in the module changed." : "A narrower fingerprint already notices this one.",
  lab: id === "runtime" ? "Which of the files it hashes changed?" : "A narrower fingerprint already notices this one.",
  none: "One of the three does change. Find the file the edit touches.",
});

const layerItems = [
  { key: "page", q: `${signatures.name}'s schedule page as it arrived, with its sidecar`, answer: "bronze", why: "Bronze. The bytes as received, before any code read them, with the record of how they were fetched." },
  { key: "parsed", q: "The parsed rows of one schedule page, kept beside it as a cached parse", answer: "silver", why: "Silver. They sit next to the bytes on disk, but they are derived: they carry the fingerprint that wrote them and can be thrown away and rebuilt." },
  { key: "season", q: "The season's match list: each fixture once, both schools' pages matched by fixture id", answer: "silver", why: "Silver. Cleaned, checked and joined into one row per match, in shared names, but not yet shaped for a reader." },
  { key: "table", q: "The conference table Riley publishes", answer: "gold", why: "Gold. Built from silver for one use: readers who want the standings." },
  { key: "detail", q: "The match detail for Alder Ridge's semifinal, built from its box score", answer: "gold", why: "Gold. Another reader-facing product, from a different silver input. Prove it in the lesson rebuilds exactly this." },
  { key: "manifest", q: "Friday's capture manifest", answer: "meta", why: "Metadata about a layer. It holds no page. It says which pages bronze should hold, the hash of each, and which one never arrived." },
];
const layers: [string, string][] = [["bronze", "Bronze"], ["silver", "Silver"], ["gold", "Gold"], ["meta", "Metadata about a layer"]];
const layerWrong = (answer: string) => Object.fromEntries(layers.filter(([k]) => k !== answer).map(([k]) => [k,
  answer === "meta" ? "Does it hold any page, or rows from one?"
  : answer === "bronze" ? "Has any code read or changed these bytes yet?"
  : answer === "gold" ? "Who is this for: the pipeline, or a reader?"
  : k === "bronze" ? "Some code has already read the page to make this." : "Is this shaped for a reader yet, or for the next step?"]));

const store = {
  latestFiles: retention.tuesday.pages,
  everyFiles: retention.schedules + retention.tuesday.pages,
  everyBytes: retention.fridaySchedBytes + retention.tuesday.bytes,
  dedupFiles: retention.schedules + retention.tuesday.newFiles,
  dedupBytes: retention.fridaySchedBytes + retention.tuesday.newBytes,
};
const m = retention.model;
const bars = [
  { label: "Latest only", bytes: m.latest, ratio: 1, note: "One capture per page" },
  { label: "Every capture, a new file only when the content is new", bytes: m.deduped, ratio: m.dedupedRatio, note: `${n(m.versions)} versions in all` },
  { label: "Every fetch kept", bytes: m.every, ratio: m.everyRatio, note: `${n(m.days)} fetches of every page` },
];
const sectionNote = [
  `Before it replays anything, the lab reads Friday's capture manifest and checks it: every page is saved or unavailable with a reason, and every saved page on disk still matches the hash the run recorded. Then it sends two test requests and checks that its network counter caught both. A counter that has never caught anything proves nothing.`,
  `Tuesday's parser over Friday's pages: table A, with “State Lambert” in it.`,
  `The same parser over the same pages. Every parsed file's lineage record still matches, fingerprint and content hash, so nothing is parsed again.`,
  `The fixed parser. Its fingerprint differs, so every parsed file is stale and is parsed again. The table is Monday's, with the name fixed.`,
  `The report that Rewind teaches you to check. Each line answers one of Riley's acceptance criteria.`,
];
---

<CoverageRuntime />

<p class="cv-backto not-content" data-backto><a href="../02-archive/">Back to the Module 2 lesson</a></p>

<div class="cv not-content ar-fw" data-coverage data-store-key={keys.store} data-progress-key={keys.progress} data-review-key={keys.review}>
  <div class="ar-intro">
    <p>This page is optional. <a href="../02-archive/">The Module 2 lesson</a> teaches the idea on screen. Come here to look under the archive: how a collector tells a changed page from a re-rendered one, how much a fingerprint should cover, what keeping every capture costs, the names the industry gives the layers, and the lab.</p>
    <p>Every section uses the same week. Friday's run saved {week.schedulesSaved} of {week.schedulesRequested} schedule pages and {week.boxesSaved} box scores; {list(week.unavailable)}'s site never answered. On Tuesday Kick's tidy rule turned “St. Lambert” into “State Lambert”, and Riley asked for Friday's table rebuilt from the pages Kick kept, without asking a single site again. Each section stands on its own, so start with the one you came for.</p>
    <ol class="cv-map">
      {map.map(([id, name, what]) => <li><a href={`#${id}`}><b>{name}</b><span>{what}</span></a></li>)}
    </ol>
  </div>

  <section id="signatures">
    <h2>Changed, or only re-rendered?</h2>
    <p class="ar-for">For anyone who runs a collector, or will.</p>
    <p>Friday's manifest records a SHA-256 hash of every saved page's bytes. That hash is how the lab knows a replay read exactly what Friday saved: change one byte and it no longer matches, and the lab refuses the page. <a href="#lab">The lab's first exercise</a> does exactly that.</p>
    <p>The same hash is a poor answer to a different question: has this page changed since we last saved it? Many sites build each page fresh for every visit. Two fetches a minute apart can carry a different render time in a comment, a different per-visit token in a header tag, or markup that a template update re-indented. Nothing a reader would call the schedule has changed, and the byte hash differs anyway. That is <strong>render noise</strong>.</p>

    <h3>Two hashes, two jobs</h3>
    <p>A <strong>content signature</strong> is a hash taken after known render noise is removed. The byte hash answers “is this exactly what we saved?” The signature answers “is this news?” The signature on this page drops three things before hashing: comments, the per-visit token tag, and whitespace between tags. A real collector keeps such rules per kind of page; these three are enough here.</p>
    <p>Friday's capture of {signatures.name}'s page is {n(signatures.friday.bytes)} bytes, with byte hash <code>{signatures.friday.byteHash}</code> and signature <code>{signatures.friday.signature}</code>. Four later fetches follow, two of them real captures from the sample and two made up for this page.</p>

    <div class="cv-check" data-once="fw-signatures">
      <p class="cv-kind">Knowledge check</p>
      <p class="cv-qlabel">For each fetch, which hash differs from Friday's capture of the same page?</p>
      {signatures.fetches.map((f) => (
        <div class="cv-line" data-q data-type="select" data-answer={f.answer} data-why={fetchWhy(f)} data-wrong={JSON.stringify(fetchWrong(f))}>
          <label><span>{f.label}<span class="cv-sub">{f.what}</span></span>
            <select data-save={`fw-sig-${f.id}`}><option value="">Choose</option>{hashAnswers.map(([k, t]) => <option value={k}>{t}</option>)}</select>
          </label>
          <p class="cv-fb" role="status"></p>
        </div>
      ))}
      <p class="cv-once">Pick one for each fetch, then check.</p>
      <button type="button" data-submit>Check my four</button>
      <p class="cv-fb" role="status" data-need></p>
      <div class="cv-reveal">
        <div class="cv-scroll ar-tablewrap" tabindex="0" role="region" aria-label="Byte hashes and signatures of four fetches">
          <table class="ar-table">
            <thead><tr><th scope="col">Fetch</th><th scope="col">Byte hash</th><th scope="col">Signature</th><th scope="col">What differs from Friday</th></tr></thead>
            <tbody>
              {signatures.fetches.map((f) => (
                <tr>
                  <th scope="row">{f.label}{!f.real && <span class="ar-tag">made up</span>}</th>
                  <td class:list={["ar-mono", { "ar-moved": f.byteChanged }]}>{f.byteHash}</td>
                  <td class:list={["ar-mono", { "ar-moved": f.sigChanged }]}>{f.signature}</td>
                  <td>{f.changed.length === 0 && !f.byteChanged ? "Nothing" : <>{f.changed.length > 0 && <code class="ar-lines">{f.changed.join("\n")}</code>}{!f.real && <span class="cv-sub">and every line re-indented</span>}</>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>{answerText.signature} is never right. The signature is computed from the bytes, so bytes that did not change cannot give a signature that did.</p>
      </div>
    </div>

    <h3>Too much normalising hides a change</h3>
    <p>The rules decide what counts as news, and they can be wrong in either direction. With too few rules, noise slips through: the collector stores a page that has not changed and parses it again. That costs storage and minutes. With too many, a real change disappears. A rule that dropped every digit to get rid of render times would also drop every score, so a site that corrected a result would look unchanged. The second mistake is the dangerous one, for the reason <a href={lesson("case-fingerprint")}>Case 3</a> gives for fingerprints: rebuilding too much costs minutes, and rebuilding too little publishes a stale number with no error. So a signature removes only the noise it can name.</p>

    <h3>What a match is worth</h3>
    <p>A <a href="../01-collection-field-work/#platform">conditional request</a> can save the download when a site answers “unchanged”. A signature cannot save the download; it works after it, on sites that send no tag or send a new one with every render. When a fresh fetch's signature matches the saved one, the collector has a choice: write the new bytes, or keep the old ones and note that the page was checked. Keeping the old bytes means every output built from them still points at a file with the hash its manifest recorded, and a re-fetch that found only noise has not overwritten anything. That is why a sidecar can carry two times: when the bytes were fetched, and when they were last verified against the live page. Touchline's sidecar records a content signature and both times. The sample's sidecars and manifests record the byte hash, which is what an exact replay needs.</p>
  </section>

  <section id="scope">
    <h2>How much a fingerprint covers</h2>
    <p class="ar-for">For anyone who builds caches or pipelines.</p>
    <p><a href={lesson("case-fingerprint")}>Case 3</a> taught that each parsed file records the fingerprint of what produced it, and a file whose fingerprint differs from now is stale. It left one choice open: what goes into the fingerprint.</p>
    <p>The obvious candidate is the function that had the bug. Kick's tidy rule is {fingerprintScope.functionLines} lines of a {fingerprintScope.moduleLines}-line module:</p>
    <pre tabindex="0"><code>{fingerprintScope.tidy}</code></pre>
    <p>Hash those lines, and a fix to the rule changes the fingerprint. But the parser's output depends on more than <code>tidy()</code>. <code>read_schedule()</code>, in the same module, decides which cell is the date, the side, the opponent and the result. The page reader in <code>labs/common.py</code> turns the HTML into cells. <code>aliases.json</code> maps each spelling to a school.</p>
    <p>Here are five edits, and three fingerprints computed before and after each: the tidy function alone, the parser's whole module, and the lab's fingerprint, which adds the page reader, the alias and membership files, and the season.</p>

    <div class="cv-check" data-once="fw-scope">
      <p class="cv-kind">Knowledge check</p>
      <p class="cv-qlabel">For each edit, which is the narrowest fingerprint that changes?</p>
      {scopeTable.map((e) => (
        <div class="cv-line" data-q data-type="select" data-answer={e.narrowest} data-why={scopeWhy[e.id]} data-wrong={JSON.stringify(scopeWrong(e.id))}>
          <label><span>{e.label}<span class="cv-sub">The edit is {e.where}.</span></span>
            <select data-save={`fw-scope-${e.id}`}><option value="">Choose</option>{scopeNames.map(([k, t]) => <option value={k}>{t}</option>)}</select>
          </label>
          <p class="cv-fb" role="status"></p>
        </div>
      ))}
      <p class="cv-once">Pick one for each edit, then check.</p>
      <button type="button" data-submit>Check my five</button>
      <p class="cv-fb" role="status" data-need></p>
      <div class="cv-reveal">
        <div class="cv-scroll ar-tablewrap" tabindex="0" role="region" aria-label="Three fingerprints across five edits">
          <table class="ar-table ar-scope">
            <thead><tr><th scope="col">Edit</th><th scope="col">tidy() alone</th><th scope="col">Whole module</th><th scope="col">Lab's fingerprint</th><th scope="col">Parsed rows of Friday's pages that change</th></tr></thead>
            <tbody>
              {scopeTable.map((e) => {
                const cell = (k: "fn" | "module" | "lab") => {
                  const moved = e.before[k] !== e.after[k];
                  const silent = !moved && (e.rows ?? 0) > 0;
                  return <td class:list={{ "ar-moved": moved, "ar-silent": silent }}>{moved ? "changes" : silent ? "same: stale rows" : "same"}</td>;
                };
                return (
                  <tr>
                    <th scope="row">{e.label}<span class="cv-sub ar-mono">{e.before.lab === e.after.lab ? e.after.lab : `${e.before.lab} → ${e.after.lab}`}</span></th>
                    {cell("fn")}{cell("module")}{cell("lab")}
                    <td>{e.rows === null ? "Can't tell" : n(e.rows)}<span class="cv-sub">{e.rowsNote}</span></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p>Read the second row. Its fix is in <code>read_schedule()</code>, outside <code>tidy()</code>. A tidy-only fingerprint stays the same, so no parsed file is rebuilt, and {n(scopeTable[1].rows ?? 0)} parsed rows of Friday's pages keep reading away matches as home matches, with no error anywhere. That is the dangerous direction. The comment row is the other one: the module's hash changes although no output can, and every parsed file is rebuilt for nothing. That costs seconds here, and minutes on a real archive.</p>
        <p>The hash under each edit is the lab's fingerprint. The comment and alias values are the same ones <a href={lesson("case-fingerprint")}>Case 3's presets</a> show.</p>
      </div>
    </div>

    <h3>Why the whole module</h3>
    <p>A function's output depends on what it calls, on names defined at the top of its module, and on what it imports. Tracing exactly those is dependency analysis, which build tools can do when every input is declared. For a parser that lives in one module, hashing the module is the cheapest scope that holds everything the function can reach in its own file, and it errs toward rebuilding. The lab also hashes the membership file and the season, which the parser never reads, because they are the build's config. A scope can be wider than the function needs. It must never be narrower.</p>
    <p>Touchline's fingerprint covers the parser's whole module plus its configured inputs, so an alias edit re-reads the archive without a single fetch. It stops short of the whole repository: every unrelated commit would then mark every parsed file stale, box scores included. The box-score parser has its own module and its own fingerprint, which is why <a href={lesson("prove-it")}>Prove it</a> can rebuild every box score and leave the {retention.schedules} schedules fresh.</p>
    <p>The last row is the limit. No file in any of the three fingerprints changes when the Python that runs the parser is upgraded, so no fingerprint can say whether the output did. Inputs outside the line need another guard: a pinned version, or a replay whose output is compared with the last one, cell by cell, as <a href={lesson("rewind")}>Rewind</a> does.</p>
  </section>

  <section id="retention">
    <h2>What every capture costs</h2>
    <p class="ar-for">For anyone who decides what a pipeline keeps.</p>
    <p><a href={lesson("decision")}>The decision</a> compares two policies. <strong>Latest only</strong> keeps one capture per page, and a new fetch overwrites it. <strong>Every capture</strong> keeps each fetch beside the last. Here is what each costs, in bytes from the sample.</p>

    <h3>Tuesday, measured</h3>
    <p>Friday's run saved {retention.schedules} schedule pages, {n(retention.fridaySchedBytes)} bytes, and {retention.boxes} box scores, {n(retention.fridayBoxBytes)} bytes. Tuesday's re-fetch, had it run, would have brought back the {retention.tuesday.pages} schedule pages: {n(retention.tuesday.bytes)} bytes.</p>
    <p>An every-capture archive need not store a fetch that is identical to one it already holds. If files are named by their content hash, an identical page lands on a name that already exists, and nothing new is written.</p>

    <div class="cv-check" data-once="fw-retention">
      <p class="cv-kind">Knowledge check</p>
      <div class="cv-line" data-q data-type="number" data-answer={retention.tuesday.newFiles} data-why={`${retention.tuesday.newFiles}. ${list(week.unchangedOnTuesday)} were byte-identical on Tuesday, so their hashes name files the archive already holds. The other ${retention.tuesday.newFiles} each changed one result cell.`}>
        <label><span>Tuesday's {retention.tuesday.pages} schedule pages arrive at an every-capture archive that names files by content hash. How many new files does it write?</span>
          <input inputmode="numeric" autocomplete="off" data-save="fw-ret-files" aria-label="New files" />
        </label>
        <p class="cv-fb" role="status"></p>
      </div>
      <div class="cv-line" data-q data-type="select" data-answer="bytes" data-why="Every capture named by byte hash. Each render gives new bytes, so every fetch lands on a new name, and the archive keeps every fetch. Naming by signature keeps one file per real change; latest only never stores more than one per page either way." data-wrong={JSON.stringify({ latest: "Latest only keeps one capture per page, noise or not. What happens to the others?", signature: "The signature drops the noise. What does the byte hash do with it?" })}>
        <label><span>Now every page carries a render stamp, like the made-up re-renders in the first section. Which archive ends up storing every fetch?</span>
          <select data-save="fw-ret-noise"><option value="">Choose</option><option value="latest">Latest only</option><option value="bytes">Every capture, named by byte hash</option><option value="signature">Every capture, named by signature</option></select>
        </label>
        <p class="cv-fb" role="status"></p>
      </div>
      <p class="cv-once">Answer both, then check.</p>
      <button type="button" data-submit>Check answers</button>
      <p class="cv-fb" role="status" data-need></p>
      <div class="cv-reveal">
        <div class="cv-scroll ar-tablewrap" tabindex="0" role="region" aria-label="Three archives after Tuesday's re-fetch">
          <table class="ar-table">
            <thead><tr><th scope="col">After Tuesday's re-fetch</th><th scope="col">Files</th><th scope="col">Bytes</th><th scope="col">Friday's evidence</th></tr></thead>
            <tbody>
              <tr><th scope="row">Latest only</th><td>{store.latestFiles}</td><td>{n(retention.tuesday.bytes)}</td><td>Gone for the {retention.tuesday.newFiles} pages that changed</td></tr>
              <tr><th scope="row">Every capture, named by content hash</th><td>{store.dedupFiles}</td><td>{n(store.dedupBytes)}</td><td>All kept</td></tr>
              <tr><th scope="row">Every fetch kept, duplicates included</th><td>{store.everyFiles}</td><td>{n(store.everyBytes)}</td><td>All kept</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <h3>A season, modelled</h3>
    <p>One fetch adds little. A season of them is the real cost. Here is a model, with its assumptions in plain view: the collector fetches the {retention.schedules} schedule pages once a day, from the first match on any of them ({m.firstDate}) to Friday's run ({m.runDate}), which is {n(m.days)} days. A page changes only on a day one of its results is posted, so it has one version before its first result and one more for each day with a result: between {m.minVersions} and {m.maxVersions} versions per page, {n(m.versions)} in all. Every version is counted at Friday's size, a slight overestimate, since earlier versions have blank result cells.</p>
    <figure class="ar-bars">
      {bars.map((b) => (
        <div class="ar-bar">
          <p><b>{b.label}</b><span>{b.note}: {n(b.bytes)} bytes, {times(b.ratio)} latest only</span></p>
          <div class="ar-track" aria-hidden="true"><i style={`width: ${Math.max(0.6, (100 * b.bytes) / m.every).toFixed(2)}%`}></i></div>
        </div>
      ))}
      <figcaption>The {retention.schedules} schedule pages Friday saved, modelled over the season. Box scores are left out: each is published once after its match.</figcaption>
    </figure>
    <p>The shape matters more than the totals. Latest only grows with the number of pages. Every capture, named by content, grows with the number of changes. Keeping every fetch grows with the number of fetches, and render noise turns the second into the third unless files are named by <a href="#signatures">signature</a>. Real pages are larger than the sample's and a real archive holds far more of them, so the totals do not carry over; the multipliers roughly do. Versions of one page are mostly the same text, so they also compress well together.</p>

    <h3>Between the two</h3>
    <p>The choice is not all or nothing. Two common middles: keep every capture for a window, such as the current season, then thin to the latest; or keep every capture that a published output was built from. Friday's manifest lists the content hash of every page Monday's table read. A store that never deletes a capture some manifest still names can rebuild every table it ever published, whatever else it thins.</p>
  </section>

  <section id="layers">
    <h2>Bronze, silver and gold</h2>
    <p class="ar-for">For anyone who will meet these words at work.</p>
    <p>Many data teams name a pipeline's layers after medals. <strong>Bronze</strong> holds data as it arrived. <strong>Silver</strong> holds it cleaned, checked and joined: one row per thing, in shared names. <strong>Gold</strong> holds what a reader uses: a table, a report, an input to a model. The pattern is often called the medallion architecture. Other teams say raw, staging and curated, or landing, refined and serving. The lesson's terms map onto it: <a href={lesson("idea")}>raw data</a> is bronze, and silver and gold are both derived.</p>

    <div class="cv-check" data-once="fw-layers">
      <p class="cv-kind">Knowledge check</p>
      <p class="cv-qlabel">Place each of Touchline's things in a layer, or say it describes one.</p>
      {layerItems.map((x) => (
        <div class="cv-line" data-q data-type="select" data-answer={x.answer} data-why={x.why} data-wrong={JSON.stringify(layerWrong(x.answer))}>
          <label><span>{x.q}</span>
            <select data-save={`fw-layer-${x.key}`}><option value="">Choose</option>{layers.map(([k, t]) => <option value={k}>{t}</option>)}</select>
          </label>
          <p class="cv-fb" role="status"></p>
        </div>
      ))}
      <p class="cv-once">Place all six, then check.</p>
      <button type="button" data-submit>Check my six</button>
      <p class="cv-fb" role="status" data-need></p>
      <div class="cv-reveal">
        <p>Kick's tidy rule ran inside the parser, on the way from bronze to silver. So silver already carried it, and the fix had to replay from bronze. Had the rule run on the way from silver to gold, when the table is published, silver would have been enough. That is <a href={lesson("case-kept")}>Case 2's rule</a>: replay from the last layer before the damage. The medal names do not change it.</p>
      </div>
    </div>

    <h3>A label is not a guarantee</h3>
    <p>The names promise less than they seem to. Many teams' bronze is already a step removed from what arrived: an API's JSON flattened into a table, or a page with its scripts stripped. Case 2's archive (b), the tidied HTML, would pass for bronze in many pipelines, and it cannot verify the tidy rule fix. Before you trust any layer for a replay, ask Case 2's question of it: which step ran before it was written?</p>
    <p>In production the archive sits in private object storage, copied down at the start of a run and back at the end; nothing on this page depends on where it lives.</p>
  </section>

  <section id="lab">
    <h2>The lab: replay Friday, then break it</h2>
    <p class="ar-for">For anyone who wants to see the replay in code. Plain Python with no network, about twenty minutes. To install it, follow <a href="../../start/setup/">the setup page</a>.</p>
    <pre tabindex="0"><code>python labs/m02_archive.py</code></pre>
    <p>The run prints five sections. Here they are whole, exactly as the lab prints them, with a note before each.</p>
    <ol class="ar-run">
      {labRun.map((s, i) => (
        <li>
          <p>{i === 4 ? <>The report that <a href={lesson("rewind")}>Rewind</a> teaches you to check. Each line answers one of Riley's acceptance criteria.</> : sectionNote[i]}</p>
          <pre tabindex="0"><code>{s.text}</code></pre>
        </li>
      ))}
    </ol>

    <pre tabindex="0"><code>python labs/m02_archive.py --tuesday</code></pre>
    <p>This builds the re-fetch table from Tuesday's capture with the fixed parser and compares it with Tuesday's table. Two inputs changed at once, so the lab says it cannot trace a cell to one cause, and exits with code 1. <a href={lesson("case-saturday")}>Case 1</a> works through why.</p>
    <pre tabindex="0"><code>{tuesdayDiff}</code></pre>

    <pre tabindex="0"><code>python labs/m02_archive.py --missing {missing.slug}</code></pre>
    <p>This replays a scratch copy of the archive with {missing.name}'s schedule page deleted, while the manifest still lists it as saved. Two checks notice: the manifest check at the top of the run counts one page fewer that matches its hash, and the report below says the replay read one schedule fewer than the manifest lists. The replay itself skipped the page without a word. The run exits with code 1. Here is its report:</p>
    <pre tabindex="0"><code>{missingReport}</code></pre>
    <p>Read the last named gap. Dunmore's home match against {missing.name} was recovered on Monday from {missing.name}'s page. With that page gone too, the match is on no saved page at all.</p>

    <h3>Your turn</h3>
    <p>Each change starts from the original files, so undo one before you try the next (<code>git checkout labs/ sample/</code>).</p>
    <ol class="ar-turns">
      <li><b>Alter the evidence.</b> In <code>sample/raw_html/harbor-point/2026-men-schedule.html</code>, change one result cell, a tie to a win, and run the lab. Predict first: does it replay the edited page, skip it, or stop? It stops before replaying anything, says it could not run, and exits with code 2, because the page is no longer the evidence Friday recorded. Restore it with <code>git checkout sample/</code>. Why is refusing better than replaying the page with a warning?</li>
      <li><b>Make the silent skip loud.</b> <code>replay()</code> in <code>labs/m02_archive.py</code> skips a missing page with <code>continue</code>. Decide what should happen: stop the run, or replay the rest and name the gap, the way Module 1's coverage record names a page that never arrived. Make the lab do it, and run <code>--missing {missing.slug}</code> again. Which choice lets Riley publish a table on a day a page is missing, and what must that table say?</li>
      <li><b>Make Tuesday's comparison controlled.</b> <code>--tuesday</code> changed the parser and the pages at once. Add a run that parses Tuesday's pages with Tuesday's parser, and compare its table with the <code>--tuesday</code> table. Exactly one cell should differ: “{controlled.was}” against “{controlled.name}”. Every other change in the confounded diff then traces to the pages alone.</li>
      <li><b>Narrow the fingerprint.</b> Change <code>fingerprint()</code> to hash only <code>inspect.getsource(parser.tidy)</code>, and run the lab. It still passes. Which edit from <a href="#scope">How much a fingerprint covers</a> would it now miss, and what test would fail when it does?</li>
    </ol>
    <p>Every run above trusted that a saved page is the page its sidecar says it is. <a href="../03-provenance/">Module 3</a> tests that.</p>
  </section>
