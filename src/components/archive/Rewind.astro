---
import PartHead from "../coverage/PartHead.astro";
import NextPart from "../coverage/NextPart.astro";
import Check from "../lesson/Check.astro";
import Choice from "../lesson/Choice.astro";
import AiCard from "./AiCard.astro";
import { rewind, story, tableB } from "../../lib/archive";
import { spell } from "../../lib/cases";

const ask = "Can you rebuild Friday's table from the pages you kept, without asking a single site again, and show me you did?";
const down = rewind.unavailable.map((u) => u.name).join(" and ");
const criteria = [
  `Replay the schedule pages Friday's capture manifest lists: the ${spell(rewind.schedulesSaved)} saved, each matched to its content hash, and ${down} listed as unavailable.`,
  "Make zero network requests, counted by a counter you show catching a test request.",
  "Name the fingerprint of the fixed parser and the revision of the code that built the table.",
  "Diff Tuesday's table against the rebuild, and explain every changed cell.",
];

const find = (test: (l: string) => boolean, what: string) => rewind.lines.find(test) ?? (() => { throw new Error(`the replay report has no ${what} line`); })();
const tidy = (l: string) => l.trim().replace(/\s+:\s/, ": ").replace(/\s{2,}/g, " ");
const short: [string, string][] = [["manifest", "1 · Pins the inputs"], ["requests", "2 · Measures the network"], ["code", "3 · Identifies the code"], ["diff", "4 · Explains the change"]];
const label = Object.fromEntries(short);
const requestsLine = find((l) => l.startsWith("requests "), "requests");
const lines = [
  { text: find((l) => l.startsWith("listed "), "listed"), answer: "manifest", why: `${down} is accounted for, with the reason, not quietly left out.` },
  { text: requestsLine, answer: "requests", why: `The counter caught its test requests, then recorded ${rewind.requests} attempts during the replay.` },
  { text: find((l) => l.startsWith("build revision "), "build revision"), answer: "code", why: "It names the program that built the table, beside the parser's fingerprint." },
  { text: find((l) => /^\s+\S.*->/.test(l) && l.includes(story.fixedName), "changed cell"), answer: "diff", why: "It names the one changed cell and the input that changed it." },
].map((l) => ({ ...l, text: tidy(l.text), why: `${label[l.answer]}. ${l.why}` }));

const agentRun: [string, string][] = [
  ["enough", "This requests line: its counter caught both test requests"],
  ["sandbox", "A run in a sandbox with no network"],
  ["audit", "An audit of every network attempt by the agent, its child processes and its tool calls"],
  ["pages", "A request count for each saved page"],
];
---

<section id="rewind" class="ar-part">
  <PartHead id="rewind">Rewind: Tuesday with a replay requirement</PartHead>
  <p>Module 1's Rewind gave Kick <strong>acceptance criteria</strong>: conditions its work must meet before Riley accepts it. Riley's Tuesday question has none yet.</p>
  <p>Riley is asking for <strong>lineage</strong>, the record of which inputs and which code made a table, and <strong>reproducibility</strong>, the same table again from the same inputs and code. The target is Monday's table, rebuilt from Friday's pages with one name fixed: {tableB.caption}, the same named gaps, and “{story.fixedName}” for “{story.tuesdayName}”.</p>
  <div class="cv-user-prompt" role="region" aria-label="Riley's question on Tuesday">
    <div class="cv-chat-bar">
      <span class="cv-chat-badge">Prompt</span>
      <span class="cv-chat-meta">Riley → Kick, Tuesday</span>
    </div>
    <p class="cv-chat-text">{ask}</p>
  </div>

  <div class="cv-commit ar-commit" data-commit>
    <p class="cv-kind">Write it <span>you check your own</span></p>
    <label class="cv-write" for="ar-criterion">Write one acceptance criterion that would let Riley check the rebuild instead of taking Kick's word for it.</label>
    <textarea id="ar-criterion" rows="2" placeholder="Done means the report shows..." data-save="rewind-criterion"></textarea>
    <div class="cv-actions">
      <button type="button" data-commit-btn disabled>Compare with Riley's</button>
      <button type="button" class="cv-link-btn" data-commit-skip>Skip and show Riley's</button>
    </div>
    <p class="cv-once" data-needs-note>Write a short sentence to compare, or skip ahead.</p>
    <div class="cv-reveal">
      <div class="cv-user-prompt" role="region" aria-label="Riley's acceptance criteria">
        <div class="cv-chat-bar">
          <span class="cv-chat-badge">Prompt</span>
          <span class="cv-chat-meta">Riley → Kick, added to the question</span>
        </div>
        <p class="cv-chat-text">Done means your report shows all {spell(criteria.length)}:</p>
        <ol class="ar-criteria">{criteria.map((c) => <li>{c}</li>)}</ol>
      </div>
      <fieldset class="cv-ticks">
        <legend>What yours covers:</legend>
        <label><input type="checkbox" data-save="rewind-has-inputs" /><span>Pins the inputs by content hash, missing one named</span></label>
        <label><input type="checkbox" data-save="rewind-has-counter" /><span>Makes “no requests” a measurement</span></label>
        <label><input type="checkbox" data-save="rewind-has-code" /><span>Identifies the code</span></label>
        <label><input type="checkbox" data-save="rewind-has-diff" /><span>Explains every change</span></label>
      </fieldset>
      <p>Each criterion asks for evidence that could have come out differently: a hash can fail to match, a counter can count, a diff can show a cell nobody explained. Evidence that could never fail verifies nothing.</p>

      <h3>Kick's replay report</h3>
      <p class="cv-label">The report section of <code>python labs/m02_archive.py</code>, quoted whole and checked against the lab.</p>
      <div class="cv-agent-reply ar-reply" role="region" aria-label="Kick's replay report">
        <div class="cv-chat-bar">
          <span class="cv-agent-badge">Kick · Coding agent</span>
          <span class="cv-status-ok">{rewind.requests} requests · {rewind.cellsChanged} cell changed</span>
        </div>
        <pre class="ar-report"><code>{rewind.lines.map((l) => <span class:list={["ar-ln", { "is-rule": /^-+$/.test(l), "is-kv": /^\s*\S.*\s:\s/.test(l), "is-sub": /^\s/.test(l) && !/\s:\s/.test(l) }]}>{`${l}\n`}</span>)}</code></pre>
      </div>
      <p>A replay proves the fix only if the build is deterministic: run it twice and compare the output hashes.</p>
      <p>Two lines identify the code. The <strong>fingerprint</strong>, {rewind.fingerprint}, is Case 3's hash of the parser module, its page reader and its config. The <strong>build revision</strong>, {rewind.buildRevision}, is the start of Git's hash of the program that built the table, so it changes whenever that file does. In a larger repository it would be the commit, plus a check that no file was edited after it.</p>
      <p>The <code>requests</code> counter has a limit. It wraps the replay process's own socket calls and name lookups, so it misses requests from child processes and from tools an agent runs. A sandbox with no network blocks such traffic but does not show that nothing tried. Evidence of zero attempts needs an audit covering the agent, its child processes and its tool calls.</p>

      <AiCard part="rewind" />

      <h4 class="cv-try">Check the report against the criteria</h4>
      <Check once="rewind-match" kind="Apply it" note={`Answer all ${spell(lines.length + 1)}, then check.`}>
        <p class="cv-qlabel">Which of Riley's criteria does each line support?</p>
        {lines.map((l, i) => (
          <div class="cv-line ar-match" data-q data-type="select" data-answer={l.answer} data-why={l.why}>
            <label class="cv-stack"><code>{l.text}</code>
              <select data-save={`rewind-meets-${i}`} aria-label={`Criterion supported by the line ${l.text}`}><option value="">Choose a criterion</option>{short.map(([v, t]) => <option value={v}>{t}</option>)}</select>
            </label>
            <p class="cv-fb" role="status"></p>
          </div>
        ))}
        <Choice radio save="rewind-agent" label="Next time Kick runs the rebuild as an agent, starting other programs and calling tools. What evidence does Riley need for the second criterion?"
          options={agentRun} answer="audit"
          why="An audit of every attempt. The counter is proven only for the process it wraps, and a sandbox blocks traffic without recording what tried."
          wrong={{ enough: "It caught test requests made by this process. A request from a child process or a tool never passes through it.", sandbox: "A sandbox stops the traffic, but a blocked attempt leaves no count. The criterion asks for zero attempts, measured.", pages: "The count is of network attempts, and splitting a 0 by page doesn't widen what the counter sees." }} />
        <p slot="reveal">Without the criteria, Riley takes the report on trust; with them, Riley can check it in a minute.</p>
      </Check>
    </div>
  </div>
  <NextPart from="rewind">This bug was caught in a day. What if one stays hidden for months?</NextPart>
</section>

<style>
  .ar-part :global(.cv-line select) { width: 100%; max-width: 30rem; }
  .ar-part :global(.cv-line > label.cv-stack) { grid-template-columns: minmax(0, 1fr); }
  .ar-part :global(fieldset.cv-line > label) { display: flex; flex-wrap: nowrap; align-items: flex-start; margin-right: 0; }
  .ar-part :global(fieldset.cv-line > label > span) { flex: 1 1 0; min-width: 0; }
  .ar-part :global(fieldset.cv-line > label > input) { flex: none; margin-top: 0.3rem; }
  .ar-part :global(.cv-chat-bar) { flex-wrap: wrap; row-gap: 0.35rem; }
  .ar-commit { grid-template-columns: minmax(0, 1fr); }
  .ar-criteria { margin: -0.4rem 0 0; padding: 0 1.1rem 0.9rem 2.6rem; color: var(--sl-color-white); }
  .ar-criteria li { margin: 0.3rem 0; }
  .ar-report { margin: 0; padding: 0.85rem 1rem; overflow-x: auto; border: 0; border-radius: 0; background: var(--tl-bg); font-size: 0.74rem; line-height: 1.5; }
  .ar-report code { padding: 0; background: none; white-space: pre-wrap; }
  .ar-ln { display: block; }
  .ar-ln.is-kv { padding-left: 17ch; text-indent: -17ch; }
  .ar-ln.is-sub { padding-left: 18ch; text-indent: -18ch; }
  .ar-ln.is-rule { overflow: hidden; white-space: nowrap; }
  @media (max-width: 40rem) { .ar-report { font-size: 0.7rem; } .ar-report code { overflow-wrap: anywhere; } .ar-ln.is-kv, .ar-ln.is-sub { padding-left: 4ch; text-indent: -4ch; } }
  .ar-match code { overflow-wrap: anywhere; font-size: 0.82rem; }
  .ar-match { padding: 0.5rem 0 0.25rem; border-bottom: 1px solid var(--tl-line); }
</style>
