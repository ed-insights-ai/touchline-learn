---
import AiStudy from "../coverage/AiStudy.astro";
import { aiCardId, aiHref, archiveAi } from "../../lib/archive-ai";
import type { ArchivePartId } from "../../lib/archive-parts";
import { modulePageExists } from "../../lib/lessons";

interface Props { part: ArchivePartId }
const { part } = Astro.props;
const card = archiveAi[part];
const sendable = modulePageExists(card.slug);
const lead = sendable ? "Send this prompt to read the reply an AI assistant gave, or copy it into your own." : "Copy this prompt into your own AI assistant.";
---

<AiStudy id={aiCardId(part)} title={card.title} note={`${lead} ${card.returnTask}`} prompt={card.prompt} href={sendable ? aiHref(part) : undefined} />
